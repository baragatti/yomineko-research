{
  "id": "les:n5-adjetivos-06",
  "schema_version": "1.0",
  "level": "n5",
  "topic": "top:n5-adjetivos",
  "order": 6,
  "title": {
    "pt-BR": "Gostos e desgostos: 好き e きらい"
  },
  "description": {
    "pt-BR": "Expressar gostar e não gostar com 好き/きらい como adjetivos-な, marcando o objeto do gosto com が (não com を)."
  },
  "objectives": [
    {
      "pt-BR": "Dizer do que se gosta com 好き e do que não se gosta com きらい"
    },
    {
      "pt-BR": "Marcar a coisa do gosto com が, nunca com を"
    },
    {
      "pt-BR": "Intensificar com 大好き (adorar) e suavizar com あまり好きじゃない (não gosto muito)"
    },
    {
      "pt-BR": "Reconhecer 好き e きらい como adjetivos-な, não como verbos"
    }
  ],
