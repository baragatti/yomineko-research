      "type": "sentence_build",
      "prompt": {
        "pt-BR": "Monte 'Qual deles é bom?' com as peças: [が] [どれ] [です] [いい] [か]"
      },
      "answer": {
        "order": [
          "どれ",
          "が",
          "いい",
