{
  "id": "les:n5-conectando-01",
  "schema_version": "1.0",
  "level": "n5",
  "topic": "top:n5-conectando",
  "order": 1,
  "title": {
    "pt-BR": "Dar o motivo: から e ので"
  },
  "description": {
    "pt-BR": "Aprenda a justificar e explicar o porquê das coisas com から (mais direto, justificativa pessoal) e ので (mais suave e educado, causa apresentada como natural). Vocabulário ligado ao tempo, à noite e a comparações, mais o kanji 雨 (chuva), que aparece em exemplos clássicos de motivo (\"como está chovendo...\")."
  },
  "objectives": [
    {
      "pt-BR": "Montar o molde [motivo] + から/ので + [consequência] para dizer o porquê de algo"
    },
    {
      "pt-BR": "Contrastar o registro: から como justificativa direta e ので como causa suave e educada"
    },
    {
      "pt-BR": "Lembrar que から também marca o ponto de partida no tempo ('a partir de')"
    },
    {
      "pt-BR": "Reconhecer o kanji 雨 (chuva) em exemplos de motivo ligados ao clima"
    }
  ],
