  "exercises": [
    {
      "id": "ex:n5-comparacoes-04-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Qual partícula marca a coisa desejada com ほしい? Ex.: 猫＿ほしいです (Quero um gato.)"
      },
      "answer": {
        "choices": [
          "が",
          "を",
          "に"
        ],
        "correct": "が"
      },
      "explanation": {
        "pt-BR": "Com ほしい, o desejado vem sempre com が, nunca com を. É o erro nº1 de quem fala português, que sente 'um gato' como objeto direto. Pense em が + ほしい como uma peça só."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-comparacoes-04-2",
      "type": "recognition",
      "prompt": {
        "pt-BR": "O que significa 車がほしいですか。?"
      },
      "answer": {
        "choices": [
          "Você quer um carro?",
          "Onde está o carro?",
          "O carro é caro?"
        ],
        "correct": "Você quer um carro?"
      },
      "explanation": {
        "pt-BR": "É o molde coisa + が + ほしい + です + か: 車 (carro) é o desejado, e o か no fim transforma em pergunta. Literalmente, '(quanto a você) carro é desejado?'."
      },
      "sentence_refs": [
        "sent:tatoeba-149136"
      ]
    },
    {
