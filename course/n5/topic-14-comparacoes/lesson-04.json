{
  "id": "les:n5-comparacoes-04",
  "schema_version": "1.0",
  "level": "n5",
  "topic": "top:n5-comparacoes",
  "order": 4,
  "title": {
    "pt-BR": "Querer ter algo: ～がほしい"
  },
  "description": {
    "pt-BR": "Como expressar o desejo de possuir uma coisa (não uma ação) com ～がほしい (\"quero / gostaria de\"). Inclui vocabulário de objetos, animais e itens concretos, além de perguntar o que o outro quer."
  },
  "objectives": [
    {
      "pt-BR": "Dizer que se quer ter uma coisa (objeto, animal, item) com o molde Substantivo が ほしい(です)"
    },
    {
      "pt-BR": "Marcar o desejado com が, e não com を, evitando o erro mais comum de quem fala português"
    },
    {
      "pt-BR": "Perguntar o que alguém quer com 〜がほしいですか e responder ao desejo do outro"
    }
  ],
