{
  "id": "les:n5-comparacoes-01",
  "schema_version": "1.0",
  "level": "n5",
  "topic": "top:n5-comparacoes",
  "order": 1,
  "title": {
    "pt-BR": "Comparando duas coisas: より e ～ほうが"
  },
  "description": {
    "pt-BR": "A base da comparação em japonês: dizer que A é mais [adjetivo] que B. Você aprende a partícula より (\"do que\") e ～のほうが (\"o lado de...\"), nas quatro variações de ordem mais comuns, usando um bom estoque de adjetivos-い para comparar tamanho, distância, força e temperatura."
  },
  "objectives": [
    {
      "pt-BR": "Dizer que A é mais [adjetivo] que B usando より ('do que') e ～のほうが ('o lado de...')"
    },
    {
      "pt-BR": "Reconhecer que より gruda no termo MENOR (o 'do que') e que não existe um 'mais' avulso"
    },
    {
      "pt-BR": "Montar as quatro variações de ordem mais comuns (は…より…です, より…ほうが, のほうが…より, より…のほうが)"
    },
    {
      "pt-BR": "Usar adjetivos-い (高い, 小さい, 近い, 遠い, 長い, 強い, 冷たい) para descrever a comparação"
    }
  ],
