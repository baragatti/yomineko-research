    {
      "id": "ex:n5-passado-05-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "O que significa 行くな ?"
      },
      "answer": {
        "choices": [
          "Não vá! (proibição forte)",
          "Vou indo, tá?",
          "Que bom ir..."
        ],
        "correct": "Não vá! (proibição forte)"
      },
      "explanation": {
        "pt-BR": "Verbo na forma de dicionário (行く) + な = proibição forte: 'não vá!'. Cuidado: 行くね seria 'vou indo, tá?', sentido quase oposto. Uma letra muda tudo."
      },
      "sentence_refs": []
