{
  "id": "les:n5-passado-03",
  "schema_version": "1.0",
  "level": "n5",
  "topic": "top:n5-passado",
  "order": 3,
  "title": {
    "pt-BR": "Buscando concordância e avisando: ね e よ"
  },
  "description": {
    "pt-BR": "As duas partículas finais mais usadas no japonês falado. ね pede concordância (\"né?\", \"não é?\") e suaviza a fala; よ afirma com convicção ou passa uma informação nova (\"olha, vou te avisar\"). Vocabulário de objetos da casa e do estudo."
  },
  "objectives": [
    {
      "pt-BR": "Usar ね no fim da frase para buscar concordância e suavizar a fala (como o nosso 'né?')"
    },
    {
      "pt-BR": "Usar よ no fim da frase para afirmar com convicção ou avisar de algo que o outro não sabe"
    },
    {
      "pt-BR": "Escolher entre ね e よ conforme você pressupõe concordância ou passa informação nova"
    },
    {
      "pt-BR": "Reconhecer e ler o kanji 今 (agora)"
    }
  ],
