  "exercises": [
    {
      "id": "ex:n5-passado-01-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Qual é a forma POLIDA do passado da cópula (\"era / foi\")?"
      },
      "answer": {
        "choices": [
          "でした",
          "だった",
          "です"
        ],
        "correct": "でした"
      },
      "explanation": {
        "pt-BR": "でした é a versão polida do passado da cópula; だった é a casual; です é o presente polido. As duas do passado significam \"era / foi\"."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-passado-01-2",
      "type": "cloze",
      "prompt": {
        "pt-BR": "Complete com o passado POLIDO da cópula: ここは図書館＿。 (Aqui era a biblioteca.)"
      },
      "answer": {
        "text": "でした",
        "full": "ここは図書館でした"
      },
      "explanation": {
        "pt-BR": "図書館 (biblioteca) é substantivo, então recebe でした direto para virar \"era a biblioteca\". O molde é [substantivo] + でした."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-passado-01-3",
