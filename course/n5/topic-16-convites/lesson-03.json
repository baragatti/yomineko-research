  "exercises": [
    {
      "id": "ex:n5-convites-03-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Que partícula você acrescenta a 〜ましょう para formar 〜ましょうか e transformá-lo numa consulta ao outro?"
      },
      "answer": {
        "choices": [
          "か",
          "は",
          "を"
        ],
        "correct": "か"
      },
      "explanation": {
        "pt-BR": "か é a partícula de pergunta. Colada no fim de 〜ましょう, ela transforma a afirmação 'vamos' numa consulta: 'vamos?' / 'quer que eu...?'."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-convites-03-2",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Você vê alguém com sacolas pesadas e diz 持ちましょうか. Que sentido isso tem?"
      },
      "answer": {
        "choices": [
          "Quer que eu carregue (pra você)?",
          "Eu já carreguei.",
          "Não carregue isso."
        ],
        "correct": "Quer que eu carregue (pra você)?"
      },
      "explanation": {
        "pt-BR": "Com o sujeito subentendido 'eu', 〜ましょうか vira uma oferta gentil: 'quer que eu faça isto pra você?'."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-convites-03-3",
      "type": "cloze",
      "prompt": {
        "pt-BR": "Complete a sugestão consultando o outro: モールに行きましょう＿。 (Vamos ao shopping?)"
      },
      "answer": {
        "text": "か",
        "full": "モールに行きましょうか"
      },
      "explanation": {
        "pt-BR": "Acrescentando か ao 〜ましょう, a frase deixa de ser 'bora!' e vira um 'vamos?' que pede a opinião da pessoa. É a frase real モールに行きましょうか."
      },
      "sentence_refs": [
        "sent:tatoeba-193955"
      ]
    },
    {
