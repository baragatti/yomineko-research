{
  "id": "les:n5-convites-04",
  "schema_version": "1.0",
  "level": "n5",
  "topic": "top:n5-convites",
  "order": 4,
  "title": {
    "pt-BR": "Recomendar com 〜たほうがいい"
  },
  "description": {
    "pt-BR": "Aprenda a dar conselhos e recomendações com 〜たほうがいい (\"é melhor você fazer X\"). O padrão compara opções (ほう = lado/opção) e indica que vale a pena fazer aquilo; exige a forma た do verbo. Acompanha adjetivos descritivos comuns."
  },
  "objectives": [
    {
      "pt-BR": "Dar conselhos e recomendações com o padrão 〜たほうがいい ('é melhor você fazer X')"
    },
    {
      "pt-BR": "Formar a estrutura corretamente: verbo na forma た + ほうがいい (não a forma de dicionário)"
    },
    {
      "pt-BR": "Reconhecer ほう como 'lado/opção' numa comparação e いい como 'bom'"
    },
    {
      "pt-BR": "Ampliar o vocabulário com adjetivos descritivos comuns"
    },
    {
      "pt-BR": "Ler os kanji 電 e 聞 em palavras do dia a dia"
    }
  ],
