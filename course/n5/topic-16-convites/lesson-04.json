      "answer": {
        "order": [
          "他",
          "に",
          "行った",
          "ほうがいい"
        ],
        "text": "他に行ったほうがいい。"
      },
      "explanation": {
        "pt-BR": "他 (outro lugar) + に (partícula de destino) + 行った (forma た de 行く) + ほうがいい. Note a forma た obrigatória no conselho."
      },
