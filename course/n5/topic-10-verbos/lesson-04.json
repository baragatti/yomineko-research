{
  "id": "les:n5-verbos-04",
  "schema_version": "1.0",
  "level": "n5",
  "topic": "top:n5-verbos",
  "order": 4,
  "title": {
    "pt-BR": "O irregular する e ações do cotidiano"
  },
  "description": {
    "pt-BR": "Apresentamos する (fazer), o segundo verbo irregular e um dos mais usados do japonês, com seus usos idiomáticos (ter/usar uma característica, custar). Ligamos する a substantivos de ação como estudo, casamento, compras e cópia, formando expressões do tipo 散歩する. Reunimos também vocabulário ligado a tarefas e estados."
  },
  "objectives": [
    {
      "pt-BR": "Conjugar e usar する (fazer) como verbo pleno: します, して, した"
    },
    {
      "pt-BR": "Formar verbos juntando する a substantivos de ação (勉強する, 散歩する, コピーする)"
    },
    {
      "pt-BR": "Reconhecer os usos idiomáticos de する: ter/usar uma característica e custar (preço)"
    },
    {
      "pt-BR": "Ler e escrever o kanji 時 (tempo, hora)"
    }
  ],
