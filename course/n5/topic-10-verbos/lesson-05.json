  "exercises": [
    {
      "id": "ex:n5-verbos-05-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Qual verbo de existência se usa para SERES ANIMADOS (pessoas, animais)?"
      },
      "answer": {
        "choices": [
          "あります",
          "います",
          "です"
        ],
        "correct": "います"
      },
      "explanation": {
        "pt-BR": "いる (います) é para seres animados que se movem por vontade própria. ある (あります) fica para coisas inanimadas."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-verbos-05-2",
      "type": "particle_choice",
      "prompt": {
        "pt-BR": "Complete o sujeito: 先生＿います。 (Há um professor.)"
      },
      "answer": {
        "choices": [
          "が",
          "を",
          "です"
        ],
        "correct": "が"
      },
      "explanation": {
        "pt-BR": "が marca o sujeito (先生 = professor), que é a informação nova/em foco. A partícula vem DEPOIS da palavra que ela marca."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-verbos-05-3",
      "type": "cloze",
      "prompt": {
        "pt-BR": "Escolha o verbo certo (coisa inanimada): お茶があり＿。 (Tem chá.)"
      },
      "answer": {
        "text": "ます",
        "full": "お茶があります"
      },
      "explanation": {
        "pt-BR": "Chá é uma coisa inanimada, então usamos ある na forma polida あります. O sujeito お茶 leva が."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-verbos-05-4",
      "type": "sentence_build",
      "prompt": {
        "pt-BR": "Monte 'Tenho tempo / Há tempo.' com as peças: [あります] [が] [時間]"
      },
      "answer": {
        "order": [
          "時間",
          "が",
          "あります"
        ],
        "text": "時間があります。"
      },
      "explanation": {
        "pt-BR": "Sujeito + が + verbo de existência: 時間 (tempo) + が (sujeito) + あります (existe). Tempo é inanimado, por isso ある, não いる."
      },
      "sentence_refs": [
        "sent:tatoeba-150639"
      ]
    },
    {
      "id": "ex:n5-verbos-05-5",
      "type": "production",
      "prompt": {
        "pt-BR": "Diga em japonês 'Há três professores.' usando 先生, 三人 (três pessoas) e o verbo de existência certo."
      },
      "answer": {
        "text": "先生が三人います。",
        "accept": [
          "先生が三人います",
          "せんせいがさんにんいます",
          "先生が三人います。",
          "先生が3人います"
        ]
      },
      "explanation": {
        "pt-BR": "Professores são seres animados, então o verbo é います. 先生 (professor) + が (sujeito) + 三人 (três pessoas) + います. O kanji 三 vale 'três'."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-verbos-05-6",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Quantos tracinhos tem o kanji 三 e o que ele significa?"
      },
      "answer": {
        "choices": [
          "Dois tracinhos, significa 'dois'",
          "Três tracinhos, significa 'três'",
          "Quatro tracinhos, significa 'quatro'"
        ],
        "correct": "Três tracinhos, significa 'três'"
      },
      "explanation": {
        "pt-BR": "三 são três tracinhos horizontais empilhados, e significa 'três'. A própria forma é a mnemônica."
      },
      "sentence_refs": []
    }
