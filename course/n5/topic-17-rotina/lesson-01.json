  "exercises": [
    {
      "id": "ex:n5-rotina-01-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Qual advérbio você usa para dizer que faz algo SEMPRE, por hábito (na sua rotina)?"
      },
      "answer": {
        "choices": [
          "いつも",
          "けっこう",
          "みず"
        ],
        "correct": "いつも"
      },
      "explanation": {
        "pt-BR": "いつも = 'sempre / de costume', marca o que faz parte da rotina. けっこう mede grau ('bastante'), e みず é 'água'."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-rotina-01-2",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Na frase 'この道はけっこう長いです', o que けっこう transmite?"
      },
      "answer": {
        "choices": [
          "bastante (mais longa do que eu esperava)",
          "de jeito nenhum",
          "todos os dias"
        ],
        "correct": "bastante (mais longa do que eu esperava)"
      },
      "explanation": {
        "pt-BR": "けっこう mede o grau de algo ('bastante / razoavelmente') e costuma carregar uma leve surpresa: a rua é mais longa do que se imaginava."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-rotina-01-3",
      "type": "cloze",
      "prompt": {
        "pt-BR": "Complete com o advérbio de 'sempre': ＿水を飲みます。 (Eu sempre bebo água.)"
      },
      "answer": {
        "text": "いつも",
        "full": "いつも水を飲みます"
      },
      "explanation": {
        "pt-BR": "いつも ('sempre') vai na frente da ação para mostrar que beber água é um hábito da sua rotina."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-rotina-01-4",
      "type": "sentence_build",
      "prompt": {
        "pt-BR": "Monte 'A quitanda é bem longe.' com as peças: [です] [八百屋] [遠い] [けっこう] [は]"
      },
      "answer": {
        "order": [
          "八百屋",
          "は",
          "けっこう",
          "遠い",
          "です"
        ],
        "text": "八百屋はけっこう遠いです。"
      },
      "explanation": {
        "pt-BR": "O advérbio けっこう ('bastante') vem ANTES do que ele mede: 八百屋 (quitanda) + は (tópico) + けっこう + 遠い (longe) + です. Dá o tom de 'mais longe do que eu pensava'."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-rotina-01-5",
      "type": "production",
      "prompt": {
        "pt-BR": "Diga em japonês 'Estou só olhando.' (numa loja) usando 見る no contínuo + だけ + です."
      },
      "answer": {
        "text": "見ているだけです。",
        "accept": [
          "見ているだけです",
          "みているだけです",
          "見てるだけです",
          "みてるだけです"
        ]
      },
      "explanation": {
        "pt-BR": "見ている (de 見る, 'estar olhando') + だけ ('só') + です. É a frase padrão para recusar ajuda numa loja, junto de いいえ、けっこうです."
      },
      "sentence_refs": [
        "sent:tatoeba-229458"
      ]
    }
