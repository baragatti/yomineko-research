{
  "id": "les:n5-rotina-02",
  "schema_version": "1.0",
  "level": "n5",
  "topic": "top:n5-rotina",
  "order": 2,
  "title": {
    "pt-BR": "もう e まだ: já / ainda"
  },
  "description": {
    "pt-BR": "O par もう (\"já\") e まだ (\"ainda\") organiza o que já aconteceu e o que continua pendente na sua rotina. Você aprende o uso afirmativo e a forma negativa まだ〜ていません (\"ainda não fiz\"), perfeita para responder sobre tarefas e refeições. O vocabulário traz números, dias do mês e mais palavras úteis."
  },
  "objectives": [
    {
      "pt-BR": "Usar もう para dizer 'já' (algo concluído) e 'não... mais' (com verbo negativo)"
    },
    {
      "pt-BR": "Usar まだ para dizer 'ainda' (algo que continua)"
    },
    {
      "pt-BR": "Responder 'ainda não fiz' com a forma まだ〜ていません"
    },
    {
      "pt-BR": "Reconhecer os kanji 万 (dez mil) e 毎 (cada/todo) no vocabulário de rotina"
    }
  ],
