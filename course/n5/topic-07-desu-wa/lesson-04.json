      "explanation": {
        "pt-BR": "Para dizer 'também', troca-se は por も: 私は学生です ('Eu sou estudante') → 私も学生です ('Eu também sou estudante')."
      },
      "sentence_refs": [
        "sent:tatoeba-85538"
      ]
