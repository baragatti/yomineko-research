  "exercises": [
    {
      "id": "ex:n5-desu-wa-04-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Na frase 私の本 ('meu livro'), o que a partícula の faz?"
      },
      "answer": {
        "choices": [
          "liga dois substantivos, marcando posse/relação",
          "transforma a frase em pergunta",
          "marca o objeto direto"
        ],
        "correct": "liga dois substantivos, marcando posse/relação"
      },
      "explanation": {
        "pt-BR": "の cola dois substantivos na ordem dono + の + coisa: 私 (eu) + の + 本 (livro) = 'meu livro'."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-desu-wa-04-2",
      "type": "cloze",
      "prompt": {
        "pt-BR": "Complete com a partícula de posse: 姉＿犬 ('o cachorro da minha irmã mais velha')."
      },
      "answer": {
        "text": "の",
        "full": "姉の犬"
      },
      "explanation": {
        "pt-BR": "姉 (irmã mais velha) é o dono, 犬 (cachorro) é a coisa; の liga os dois: 姉の犬."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-desu-wa-04-3",
      "type": "particle_choice",
      "prompt": {
        "pt-BR": "Complete: 私＿学生です。 (Eu TAMBÉM sou estudante.)"
      },
      "answer": {
        "choices": [
