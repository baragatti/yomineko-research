{
  "id": "les:n5-te-form-03",
  "schema_version": "1.0",
  "level": "n5",
  "topic": "top:n5-te-form",
  "order": 3,
  "title": {
    "pt-BR": "Ações em curso e estados: 〜ています / 〜てある"
  },
  "description": {
    "pt-BR": "Dois usos centrais da forma て + verbo de existência. 〜ています marca a ação em andamento ('estou comendo') e o estado que resulta de uma ação concluída ('estou com o nariz entupido'). 〜てある descreve o estado deixado de propósito ('a porta está trancada')."
  },
  "objectives": [
    {
      "pt-BR": "Usar 〜ています para descrever uma ação em curso (gerúndio)"
    },
    {
      "pt-BR": "Usar 〜ています para descrever o estado que resulta de uma ação concluída"
    },
    {
      "pt-BR": "Distinguir 〜てある (estado intencional) de 〜ています"
    },
    {
      "pt-BR": "Descrever estados de clima e natureza com o vocabulário novo"
    }
  ],
