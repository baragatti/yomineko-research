  "exercises": [
    {
      "id": "ex:n5-te-form-04-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Em japonês, para descrever um substantivo com um verbo (o nosso 'que…'), onde fica o verbo?"
      },
      "answer": {
        "choices": [
          "depois do substantivo, com uma palavra para 'que'",
          "direto antes do substantivo, sem palavra para 'que'",
          "no final da frase, separado por vírgula"
        ],
        "correct": "direto antes do substantivo, sem palavra para 'que'"
      },
      "explanation": {
        "pt-BR": "O japonês não tem 'que': o verbo (em forma た ou 〜ている) vem direto antes do substantivo. Ex.: 買った本 = 'o livro que comprei'."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-te-form-04-2",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Qual descreve um ESTADO CONTÍNUO ('a pessoa que está dormindo')?"
      },
      "answer": {
        "choices": [
          "寝た人",
          "寝ている人",
          "寝る人"
        ],
        "correct": "寝ている人"
      },
      "explanation": {
        "pt-BR": "〜ている marca estado contínuo: 寝ている人 = 'a pessoa que está dormindo'. A forma た (寝た人) marcaria algo concluído."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-te-form-04-3",
      "type": "particle_choice",
      "prompt": {
        "pt-BR": "Complete (sujeito DENTRO da oração que descreve): 私＿作った料理 ('a comida que eu fiz'). Marque a opção que NÃO serve."
      },
      "answer": {
        "choices": [
          "が",
          "の",
          "を"
        ],
        "correct": "を"
      },
      "explanation": {
        "pt-BR": "Dentro da oração que descreve, o sujeito pode ser が ou の com o mesmo sentido (私が作った料理 = 私の作った料理). を marca objeto, não sujeito, então não serve aqui."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-te-form-04-4",
      "type": "sentence_build",
      "prompt": {
        "pt-BR": "Monte 'o cartão-postal que o amigo me deu' com as peças: [葉書] [友達が] [くれた]"
      },
      "answer": {
        "order": [
          "友達が",
          "くれた",
          "葉書"
        ],
        "text": "友達がくれた葉書"
      },
      "explanation": {
        "pt-BR": "A oração que descreve (友達がくれた = 'que o amigo deu') vem ANTES do substantivo 葉書 (cartão-postal). が marca o sujeito interno."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-te-form-04-5",
      "type": "production",
      "prompt": {
        "pt-BR": "Escreva em japonês 'a caixa que (eu) comprei' (use a forma た + o substantivo はこ)."
      },
      "answer": {
        "text": "買った箱",
        "accept": [
          "買った箱",
          "かった箱",
          "かったはこ",
          "買ったはこ"
        ]
      },
      "explanation": {
        "pt-BR": "買う → forma た 買った ('que comprei'), colocada direto antes de 箱 (caixa): 買った箱."
      },
