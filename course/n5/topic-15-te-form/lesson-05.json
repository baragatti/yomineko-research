      "prompt": {
        "pt-BR": "O que 〜てもいいですか expressa?"
      },
      "answer": {
        "choices": [
          "pedir permissão ('posso?')",
          "dar uma ordem",
          "dizer que é proibido"
        ],
        "correct": "pedir permissão ('posso?')"
      },
      "explanation": {
        "pt-BR": "Forma て + もいいですか pede licença: '(eu) posso fazer X?'. Ex.: 入ってもいいですか = 'Posso entrar?'."
      },
      "sentence_refs": [
        "sent:tatoeba-4147428"
      ]
    },
    {
      "id": "ex:n5-te-form-05-2",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Você lê numa placa: ここに入ってはいけません. O que significa?"
      },
      "answer": {
        "choices": [
          "É proibido entrar aqui.",
