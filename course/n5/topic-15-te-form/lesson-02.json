  "exercises": [
    {
      "id": "ex:n5-te-form-02-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Numa sequência de ações ('faço X e depois Y'), o que liga os verbos em japonês?"
      },
      "answer": {
        "choices": [
          "a partícula を",
          "a forma て do primeiro verbo",
          "a palavra そして no meio"
        ],
        "correct": "a forma て do primeiro verbo"
      },
      "explanation": {
        "pt-BR": "Para encadear ações, o primeiro verbo entra na forma て e o seguinte completa a frase: 走って、学校に行きました."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-te-form-02-2",
      "type": "cloze",
      "prompt": {
        "pt-BR": "Ligue as qualidades: este quarto é amplo e claro. この部屋は広＿、明るい。"
      },
      "answer": {
        "text": "くて",
        "full": "この部屋は広くて、明るい。"
      },
      "explanation": {
        "pt-BR": "Adjetivo-い liga com くて: 広い → 広くて. O で é só para substantivos e adjetivos-な."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-te-form-02-3",
      "type": "particle_choice",
      "prompt": {
        "pt-BR": "Complete: 彼は学生＿、日本人です。 (Ele é estudante e japonês.)"
      },
      "answer": {
        "choices": [
          "て",
          "で",
          "と"
        ],
        "correct": "で"
      },
      "explanation": {
        "pt-BR": "Para ligar um substantivo (学生) a outra descrição, usa-se で: 学生で、日本人です."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-te-form-02-4",
      "type": "sentence_build",
      "prompt": {
        "pt-BR": "Monte 'corro e vou para a escola' com as peças: [学校に行きます] [走っ] [て]"
      },
      "answer": {
        "order": [
          "走っ",
          "て",
          "学校に行きます"
        ],
        "text": "走って学校に行きます。"
      },
      "explanation": {
        "pt-BR": "走る (godan, る) → forma て 走って; encadeia com a ação seguinte 学校に行きます."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-te-form-02-5",
      "type": "production",
      "prompt": {
        "pt-BR": "Diga 'primeiro converso e depois trabalho' usando a forma て de 話す (はなす) ligada a 働きます (はたらきます)."
      },
      "answer": {
        "text": "まず話して、それから働きます。",
        "accept": [
          "まず話して、それから働きます",
          "話して働きます",
          "はなしてはたらきます",
          "まずはなして、それからはたらきます"
        ]
      },
      "explanation": {
        "pt-BR": "話す (godan, す) → forma て 話して; encadeia com 働きます. A forma て liga as duas ações em sequência."
      },
