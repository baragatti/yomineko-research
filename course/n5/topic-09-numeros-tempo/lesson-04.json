  "exercises": [
    {
      "id": "ex:n5-numeros-tempo-04-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Qual contador você usa para contar LIVROS e revistas?"
      },
      "answer": {
        "choices": [
          "個 (こ)",
          "冊 (さつ)",
          "階 (かい)"
        ],
        "correct": "冊 (さつ)"
      },
      "explanation": {
        "pt-BR": "冊 (さつ) conta material de leitura: livros, revistas, cadernos. 個 é para coisas pequenas em geral e 階 é para andares."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n5-numeros-tempo-04-2",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Como se lê 三階 (terceiro andar)? Cuidado com a mudança de som."
      },
      "answer": {
        "choices": [
          "さんかい (sankai)",
          "さんがい (sangai)",
          "みかい (mikai)"
        ],
        "correct": "さんがい (sangai)"
      },
      "explanation": {
        "pt-BR": "Com 三, o som de 階 muda de かい para がい: 三階 = さんがい. É uma das irregularidades de pronúncia mais comuns dos contadores."
      },
      "sentence_refs": []
    },
