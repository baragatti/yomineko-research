  "title": {
    "pt-BR": "Revisão N5; Verbos, adjetivos e lugar/tempo"
  },
  "description": {
    "pt-BR": "Consolidação de verbos (〜ます／〜ません／〜ました／〜ませんでした), adjetivos い e な (presente/negativo/passado), e as partículas de lugar, direção e tempo に・へ・で."
  },
  "objectives": [
    {
      "pt-BR": "Conjugar verbos na forma polida no presente, passado, negativo e passado-negativo (〜ます／〜ません／〜ました／〜ませんでした)"
    },
    {
      "pt-BR": "Flexionar adjetivos-い e adjetivos-な no presente, negativo e passado"
    },
    {
      "pt-BR": "Escolher corretamente entre に, へ e で para lugar, direção, destino, tempo e local da ação"
    },
    {
      "pt-BR": "Recombinar números, contadores e horas em frases completas"
    }
  ],
