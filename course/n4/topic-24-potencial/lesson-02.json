  "exercises": [
    {
      "id": "ex:n4-potencial-02-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Qual peça liga o verbo no dicionário a できる para formar 'conseguir fazer'?"
      },
      "answer": {
        "choices": [
          "ことが",
          "ますが",
          "でを"
        ],
        "correct": "ことが"
      },
      "explanation": {
        "pt-BR": "A estrutura é verbo (dicionário) + こと + が + できる. O こと nominaliza o verbo ('o ato de…') e が marca esse ato como o que 'é possível'."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n4-potencial-02-2",
      "type": "cloze",
      "prompt": {
        "pt-BR": "Complete com a estrutura de capacidade: 私は走る＿＿＿＿。 (Eu consigo correr.)"
      },
      "answer": {
        "text": "ことができる",
        "full": "私は走ることができる"
      },
      "explanation": {
        "pt-BR": "走る fica inteiro no dicionário e recebe ことができる. Não se conjuga o verbo: a forma é sempre dicionário + ことができる."
      },
      "sentence_refs": [
        "sent:tatoeba-155347"
      ]
    },
    {
      "id": "ex:n4-potencial-02-3",
      "type": "sentence_build",
      "prompt": {
        "pt-BR": "Monte 'Eu consigo descansar.' com as peças: [できる] [私] [休む] [は] [ことが]"
      },
      "answer": {
        "order": [
          "私",
          "は",
          "休む",
          "ことが",
          "できる"
        ],
        "text": "私は休むことができる。"
      },
      "explanation": {
        "pt-BR": "私 (eu) + は (tópico) + 休む (descansar, no dicionário) + ことが + できる. O verbo nunca muda de forma antes de ことができる."
      },
      "sentence_refs": [
        "sent:tatoeba-158699"
      ]
    },
    {
      "id": "ex:n4-potencial-02-4",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Você está escrevendo um aviso formal de regras. Qual frase combina melhor com esse tom?"
      },
      "answer": {
        "choices": [
          "ここで写真をとることができません。",
          "ここで写真とれないよ。",
          "ここ写真だめ。"
