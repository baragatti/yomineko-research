  "exercises": [
    {
      "id": "ex:n4-oracoes-relativas-05-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Qual forma do sistema こ-そ-あ-ど significa \"que tipo de...?\" (a pergunta)?"
      },
      "answer": {
        "choices": [
          "こんな",
          "そんな",
          "あんな",
          "どんな"
        ],
        "correct": "どんな"
      },
      "explanation": {
        "pt-BR": "どんな é a forma interrogativa do sistema: \"que tipo de?\". As outras três (こんな/そんな/あんな) apontam para algo conhecido, marcando distância."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n4-oracoes-relativas-05-2",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Você quer dizer \"gente desse tipo\" (esse tipo de pessoa). Qual opção está correta?"
      },
      "answer": {
        "choices": [
          "そういう人",
          "そんなに人",
          "どんな人",
          "こういうに人"
        ],
        "correct": "そういう人"
      },
      "explanation": {
        "pt-BR": "そういう vem direto antes do substantivo 人 e o qualifica: \"esse tipo de pessoa\". そんなに precisa de verbo/adjetivo, não de substantivo."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n4-oracoes-relativas-05-3",
      "type": "cloze",
      "prompt": {
        "pt-BR": "Complete com a forma correta para \"Não quero esperar TANTO ASSIM\" (antes de verbo): ____待ちたくない。"
      },
      "answer": {
        "text": "そんなに",
        "full": "そんなに待ちたくない。"
      },
      "explanation": {
        "pt-BR": "Antes de um verbo (待つ), usamos そんなに (com に), no sentido de \"tanto assim\". そんな sozinho só apareceria antes de substantivo."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n4-oracoes-relativas-05-4",
      "type": "sentence_build",
      "prompt": {
        "pt-BR": "Ordene para formar \"É exatamente isso.\""
      },
      "answer": {
        "order": [
          "そういう",
          "こと",
          "です"
        ],
        "text": "そういうことです"
      },
      "explanation": {
        "pt-BR": "そういうこと (\"esse tipo de coisa / é isso\") + です forma a expressão そういうことです, usada para confirmar \"é exatamente isso\"."
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n4-oracoes-relativas-05-5",
      "type": "production",
      "prompt": {
        "pt-BR": "Traduza para o japonês: \"Não posso pagar tanto assim.\" (use そんなに e 金 / 出す)"
      },
      "answer": {
        "text": "そんなに金は出せない",
        "accept": [
          "そんなに金は出せない",
          "そんなにお金は出せない",
          "そんなに金は出せません",
          "そんなにお金は出せません"
        ]
      },
      "explanation": {
        "pt-BR": "そんなに (\"tanto assim\") modifica o verbo 出す na forma potencial negativa 出せない. Frase modelo: そんなに金は出せない。"
      },
      "sentence_refs": []
    },
    {
      "id": "ex:n4-oracoes-relativas-05-6",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Qual é a leitura do kanji 京 em palavras como 東京 (Tóquio)?"
      },
      "answer": {
        "choices": [
          "きょう",
          "けい",
          "とう",
          "みやこ"
        ],
        "correct": "きょう"
      },
      "explanation": {
        "pt-BR": "京 significa \"capital\" e tem a leitura きょう (kyō), como em 東京 (Tóquio) e 京都 (Quioto)."
      },
      "sentence_refs": []
    }
