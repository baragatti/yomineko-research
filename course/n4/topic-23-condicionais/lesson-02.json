{
  "id": "les:n4-condicionais-02",
  "schema_version": "1.0",
  "level": "n4",
  "topic": "top:n4-condicionais",
  "order": 2,
  "title": {
    "pt-BR": "Pedir e sugerir com たら"
  },
  "description": {
    "pt-BR": "Constrói sobre o たら da lição anterior duas estruturas de uso prático: 〜たらどう(ですか) para sugerir gentilmente (\"que tal...? / por que não...?\") e 〜たらいいですか para pedir orientação (\"o que / onde / como devo fazer?\"). Foco em interação educada e pedidos de conselho."
  },
  "objectives": [
    {
      "pt-BR": "Dar sugestões e conselhos gentis com 〜たらどう(ですか) ('que tal...? / por que não...?')"
    },
    {
      "pt-BR": "Pedir orientação e instruções com 〜たらいいですか ('o que / onde / como devo fazer?')"
    },
    {
      "pt-BR": "Combinar uma palavra interrogativa (何・どこ・どう) com 〜たらいいですか para fazer perguntas práticas"
    }
  ],
