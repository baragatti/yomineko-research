{
  "id": "les:n4-condicionais-08",
  "schema_version": "1.0",
  "level": "n4",
  "topic": "top:n4-condicionais",
  "order": 8,
  "title": {
    "pt-BR": "Comparar, perguntar indiretamente e quantificar"
  },
  "description": {
    "pt-BR": "Encerra o tópico com estruturas de comparação e quantidade: AとB、どちらが〜 (comparar dois itens), 疑問詞 + か (pergunta embutida / pronome indefinido), 以上 (\"X ou mais\"), 以下 (\"X ou menos\") e なん + contador + か (quantidade indefinida, \"alguns / vários\"). Conecta-se às condicionais via perguntas e faixas de valor."
  },
  "objectives": [
    {
      "pt-BR": "Comparar dois itens e perguntar qual ganha com AとB、どちらが〜"
    },
    {
      "pt-BR": "Embutir uma pergunta dentro da frase com 疑問詞 + か (pergunta indireta)"
    },
    {
      "pt-BR": "Expressar faixas de valor com 以上 ('X ou mais') e 以下 ('X ou menos')"
    },
    {
      "pt-BR": "Indicar quantidade indefinida ('alguns/vários') com なん + contador + か"
    }
  ],
