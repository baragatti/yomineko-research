    },
    {
      "pt-BR": "Reconhecer e ler が, ぎ, ぐ, げ, ご (a partir de か・き・く・け・こ)"
    },
    {
      "pt-BR": "Reconhecer e ler ざ, じ, ず, ぜ, ぞ (a partir de さ・し・す・せ・そ), com atenção a じ = ji e ず = zu"
    },
    {
      "pt-BR": "Ler pequenas palavras que usam as famílias GA e ZA"
    }
  ],
