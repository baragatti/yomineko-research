    {
      "id": "ex:pre-n5-orientacao-02-1",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Em romaji, a palavra 'sake' (saquê) termina com qual som de vogal?"
      },
      "answer": {
        "choices": [
          "e cheio (saquê)",
          "i (saki)",
          "vogal nasal"
        ],
        "correct": "e cheio (saquê)"
      },
      "explanation": {
        "pt-BR": "Em japonês a vogal final não fecha: 'sake' termina em 'e' cheio, nunca em 'i' como faria o português ('leite' soando 'leiti')."
      },
      "sentence_refs": [],
      "item_refs": []
    },
    {
      "id": "ex:pre-n5-orientacao-02-2",
      "type": "recognition",
      "prompt": {
        "pt-BR": "Como soa o 'r' do romaji em 'sora' (céu)?"
      },
      "answer": {
        "choices": [
          "um toque leve, como o 'r' de 'caro'",
          "o 'rr' forte de 'carro'",
          "o 'r' aspirado de 'rato'"
        ],
        "correct": "um toque leve, como o 'r' de 'caro'"
      },
      "explanation": {
        "pt-BR": "O r japonês é um tepe: um único toque rápido da língua, igual ao 'r' de 'caro' ou 'arara', nunca o 'rr' de 'carro'."
      },
      "sentence_refs": [],
      "item_refs": []
    },
