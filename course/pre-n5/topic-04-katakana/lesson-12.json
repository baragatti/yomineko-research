    },
    {
      "pt-BR": "Reconhecer e ler ガ, ギ, グ, ゲ, ゴ (a partir de カ・キ・ク・ケ・コ)"
    },
    {
      "pt-BR": "Reconhecer e ler ザ, ジ, ズ, ゼ, ゾ (a partir de サ・シ・ス・セ・ソ), com atenção a ジ = ji e ズ = zu"
    },
    {
      "pt-BR": "Ler estrangeirismos curtos que usam as famílias GA e ZA"
    }
  ],
