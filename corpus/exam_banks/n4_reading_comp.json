[{"id": "rc:n4:n4-aspecto-01-01", "level": "n4", "reading": "read:n4-aspecto-01-01", "question": "「私」はいつ帰ってくると言っていますか。", "correct": "すぐに戻ってくる", "distractors": ["明日戻ってくる", "夜おそく戻ってくる", "なかなか戻ってこない"], "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "rc:n4:n4-aspecto-02-01", "level": "n4", "reading": "read:n4-aspecto-02-01", "question": "外はこれからどうなりますか。", "correct": "だんだん明るくなる", "distractors": ["だんだん暗くなる", "だんだん寒くなる", "ずっと同じままだ"], "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "rc:n4:n4-aspecto-03-01", "level": "n4", "reading": "read:n4-aspecto-03-01", "question": "学校が終わるのは何時ですか。", "correct": "三時半", "distractors": ["三時", "四時", "四時半"], "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "rc:n4:n4-aspecto-04-01", "level": "n4", "reading": "read:n4-aspecto-04-01", "question": "この人はこれからどうしますか。", "correct": "もう一度やってみる", "distractors": ["もうやめてしまう", "だれかにやってもらう", "何もしないで待つ"], "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "rc:n4:n4-aspecto-05-01", "level": "n4", "reading": "read:n4-aspecto-05-01", "question": "今、何をしているところですか。", "correct": "服を着ているところ", "distractors": ["服を脱いでいるところ", "ごはんを食べているところ", "部屋をそうじしているところ"], "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "rc:n4:n4-aspecto-06-01", "level": "n4", "reading": "read:n4-aspecto-06-01", "question": "お父さんについて、正しいものはどれですか。", "correct": "外国から帰ってきたばかりだ", "distractors": ["外国へ行ったばかりだ", "まだ外国にいる", "これから外国へ行く"], "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "rc:n4:n4-aspecto-07-01", "level": "n4", "reading": "read:n4-aspecto-07-01", "question": "この本について、どう言っていますか。", "correct": "読みやすい", "distractors": ["読みにくい", "分かりにくい", "答えづらい"], "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "rc:n4:n4-causativa-01-01", "level": "n4", "reading": "read:n4-causativa-01-01", "question": "お父さんは「私」に何になってほしいと思っていますか。", "correct": "医者", "distractors": ["ドイツ語の先生", "歌手", "会社員"], "layer": "C", "