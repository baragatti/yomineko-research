s_review": true, "source": "authored+verified", "vocab": "vocab:1070650", "ai_generated": false}, {"id": "pp:n4:710", "level": "n4", "stem": "虫でさえも医学研究のために購入される。", "target": "医学", "correct": "病気を治す学問", "distractors": ["数学", "歴史", "音楽"], "vocab_id": 710, "sentence": "sent:tatoeba-126322", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1159810", "ai_generated": false}, {"id": "pp:n4:711", "level": "n4", "stem": "二度と数学のテキストを忘れてはなりません。", "target": "テキスト", "correct": "教科書", "distractors": ["ノート", "辞書", "宿題"], "vocab_id": 711, "sentence": "sent:tatoeba-123026", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1079290", "ai_generated": false}, {"id": "pp:n4:713", "level": "n4", "stem": "私は喜んでその会に出席します。", "target": "会", "correct": "集まり", "distractors": ["授業", "試験", "旅行"], "vocab_id": 713, "sentence": "sent:tatoeba-157761", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1198170", "ai_generated": false}, {"id": "pp:n4:716", "level": "n4", "stem": "僕は君と同意見だ。", "target": "僕", "correct": "私", "distractors": ["彼", "あなた", "彼女"], "vocab_id": 716, "sentence": "sent:tatoeba-81951", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1521400", "ai_generated": false}, {"id": "pp:n4:717", "level": "n4", "stem": "明朝必ず参ります。", "target": "必ず", "correct": "きっと", "distractors": ["ゆっくり", "初めて", "また"], "vocab_id": 717, "sentence": "sent:tatoeba-80675", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1487400", "ai_generated": false}, {"id": "pp:n4:720", "level": "n4", "stem": "床屋に行きなさい。", "target": "床屋", "correct": "髪を切る店", "distractors": ["八百屋", "本屋", "肉屋"], "vocab_id": 720, "sentence": "sent:tatoeba-146458", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1349410", "ai_generated": false}, {"id": "pp:n4:721", "level": "n4", "stem": "私の祖母はオートバイに乗れる。", "target": "オートバイ", "correct": "バイク", "distractors": ["自転車", "車", "馬"], "vocab_id": 721, "sentence": "sent:tatoeba-163151", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1032030", "ai_generated": false}, {"id": "pp:n4:722", "level": "n4", "stem": "水泳はよい運動だ。", "target": "運動", "correct": "スポーツ", "distractors": ["勉強", "仕事", "趣味"], "vocab_id": 722, "sentence": "sent:tatoeba-143687", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1172910", "ai_generated": false}, {"id": "pp:n4:725", "level": "n4", "stem": "表か裏か。", "target": "表", "correct": "前の面", "distractors": ["中", "下", "横"], "vocab_id": 725, "sentence": "sent:tatoeba-85365", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1489340", "ai_generated": false}, {"id": "pp:n4:726", "level": "n4", "stem": "彼女は高校生だが、彼氏は大学生だ。", "target": "大学生", "correct": "大学で勉強している人", "distractors": ["会社員", "先生", "留学生"], "vocab_id": 726, "sentence": "sent:tatoeba-8413372", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1413260", "ai_generated": false}, {"id": "pp:n4:727", "level": "n4", "stem": "前の席に運転手が座っていた。", "target": "運転手", "correct": "ドライバー", "distractors": ["お客さん", "店員", "先生"], "vocab_id": 727, "sentence": "sent:tatoeba-140981", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1172870", "ai_generated": false}, {"id": "pp:n4:728", "level": "n4", "stem": "彼は予習した。", "target": "予習", "correct": "授業の前に勉強する", "distractors": ["復習する", "運動する", "掃除する"], "vocab_id": 728, "sentence": "sent:tatoeba-99201", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1543070", "ai_generated": false}, {"id": "pp:n4:730", "level": "n4", "stem": "別のをいただけますか。", "target": "別", "correct": "ほか", "distractors": ["同じ", "前", "最初"], "vocab_id": 730, "sentence": "sent:tatoeba-83432", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1509430", "ai_generated": false}, {"id": "p