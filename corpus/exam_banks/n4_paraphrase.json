": "元気", "distractors": ["静か", "暇", "楽"], "vocab_id": 793, "sentence": "sent:tatoeba-103178", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1379750", "ai_generated": false}, {"id": "pp:n4:794", "level": "n4", "stem": "アルバイトはいい経験になるの。", "target": "アルバイト", "correct": "パートタイムの仕事", "distractors": ["勉強", "旅行", "クラブ活動"], "vocab_id": 794, "sentence": "sent:tatoeba-229934", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1019420", "ai_generated": false}, {"id": "pp:n4:798", "level": "n4", "stem": "たまには赤ちゃんを泣かせておくのもいい。", "target": "赤ちゃん", "correct": "生まれたばかりの子ども", "distractors": ["小学生", "お年寄り", "おとな"], "vocab_id": 798, "sentence": "sent:tatoeba-74111", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1383260", "ai_generated": false}, {"id": "pp:n4:799", "level": "n4", "stem": "眠りが浅いんだ。", "target": "浅い", "correct": "深くない", "distractors": ["深い", "長い", "気持ちいい"], "vocab_id": 799, "sentence": "sent:tatoeba-80981", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1390800", "ai_generated": false}, {"id": "pp:n4:800", "level": "n4", "stem": "嘘は決してつくな！", "target": "嘘", "correct": "本当ではないこと", "distractors": ["本当のこと", "悪口", "冗談"], "vocab_id": 800, "sentence": "sent:tatoeba-189506", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1172400", "ai_generated": false}, {"id": "pp:n4:801", "level": "n4", "stem": "小説を書く方が得意だ", "target": "小説", "correct": "物語", "distractors": ["日記", "手紙", "新聞"], "vocab_id": 801, "sentence": "sent:jec-5105", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1348430", "ai_generated": false}, {"id": "pp:n4:804", "level": "n4", "stem": "それらは西洋の風呂よりずっといいです。", "target": "西洋", "correct": "ヨーロッパやアメリカ", "distractors": ["アジア", "日本", "田舎"], "vocab_id": 804, "sentence": "sent:tatoeba-204702", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vo