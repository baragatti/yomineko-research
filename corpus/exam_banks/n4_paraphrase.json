[{"id": "pp:n4:788", "level": "n4", "stem": "出来るだけ手紙書くようにするよ。", "target": "出来るだけ", "correct": "なるべく", "distractors": ["ぜんぜん", "たまに", "やっと"], "vocab": "vocab:1340460", "vocab_id": 788, "sentence": "sent:tatoeba-995566", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n4:806", "level": "n4", "stem": "ごめんね。明日は朝からパートがあるのよ。", "target": "パート", "correct": "アルバイト", "distractors": ["試験", "食事", "旅行"], "vocab": "vocab:1100810", "vocab_id": 806, "sentence": "sent:tatoeba-76720", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "Nessa frase パート é o trabalho de meio período, e アルバイト nomeia o mesmo tipo de trabalho."}}, {"id": "pp:n4:807", "level": "n4", "stem": "この歌を聞くと私の中学校時代を思い出します。", "target": "時代", "correct": "ころ", "distractors": ["時間", "教室", "試験"], "vocab": "vocab:1316300", "vocab_id": 807, "sentence": "sent:tatoeba-222763", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "中学校時代 é o período em que a pessoa estudou no ginásio, e ころ marca essa mesma época."}}, {"id": "pp:n4:848", "level": "n4", "stem": "今日はずっと気分がよい。", "target": "気分", "correct": "気持ち", "distractors": ["天気", "電気", "病気"], "vocab": "vocab:1222590", "vocab_id": 848, "sentence": "sent:tatoeba-171774", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "気分 aqui é como a pessoa se sente por dentro, e 気持ち ocupa o mesmo lugar com o mesmo sentido."}}, {"id": "pp:n4:1226", "level": "n4", "stem": "父は今度の木曜日にアメリカへ出発します。", "target": "出発", "correct": "出かける", "distractors": ["帰る", "集まる", "休む"], "vocab": "vocab:1340000", "vocab_id": 1226, "sentence": "sent:tatoeba-84578", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "出発する é pôr-se a caminho de outro lugar, o mesmo que 出かける diz na frase."}}, {"id": "pp:n4:1300", "level": "n4", "stem": "やがて雨は上がると思う。", "target": "上がる", "correct": "止む", "distractors": ["始まる", "集まる", "動く"], "vocab": "vocab:1352290", "vocab_id": 1300, "sentence": "sent:tatoeba-193129", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "Quando a chuva 上がる ela deixa de cair, que é justamente o que 止む diz."}}, {"id": "pp:n4:923", "level": "n4", "stem": "今の場所を動かないほうがいいでしょう。", "target": "場所", "correct": "所", "distractors": ["時間", "都合", "気持ち"], "vocab": "vocab:1355850", "vocab_id": 923, "sentence": "sent:tatoeba-172698", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "場所 é o ponto em que a pessoa está agora, e 所 nomeia esse mesmo ponto."}}, {"id": "pp:n4:1302", "level": "n4", "stem": "母が作ってくれた食事をおいしく食べた。", "target": "食事", "correct": "料理", "distractors": ["仕事", "洋服", "写真"], "vocab": "vocab:1358490", "vocab_id": 1302, "sentence": "sent:tatoeba-83169", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "Aqui 「食事」 é a comida que a mãe preparou e que a gente comeu com gosto, ou seja, 「料理」."}}, {"id": "pp:n4:946", "level": "n4", "stem": "寒いからオーバーを着てもかまいません。", "target": "オーバー", "correct": "コート", "distractors": ["シャツ", "スカート", "スプーン"], "vocab": "vocab:1032390", "vocab_id": 946, "sentence": "sent:tatoeba-184050", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "「オーバー」 é o casacão comprido que se veste por cima quando faz frio, o mesmo que 「コート」."}}, {"id": "pp:n4:1243", "level": "n4", "stem": "運転の仕方は、親が教えてくれたんだ。", "target": "仕方", "correct": "やり方", "distractors": ["気持ち", "時間", "お金"], "vocab": "vocab:1594110", "vocab_id": 1243, "sentence": "sent:tatoeba-11735124", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "仕方 é o modo de fazer alguma coisa, e やり方 é a palavra do dia a dia com esse mesmo sentido."}}, {"id": "pp:n4:1290", "level": "n4", "stem": "入院しなくてもいいです。", "target": "入院", "correct": "病院に入ること", "distractors": ["病院を出ること", "学校に入ること", "薬を飲むこと"], "vocab": "vocab:1465720", "vocab_id": 1290, "sentence": "sent:tatoeba-122086", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "入院 é ficar internado, ou seja, entrar no hospital para tratamento."}}, {"id": "pp:n4:840", "level": "n4", "stem": "悪いけどほかに用事があるの。", "target": "用事", "correct": "しなければならない事", "distractors": ["食べたい物", "行きたい所", "読みたい本"], "vocab": "vocab:1546300", "vocab_id": 840, "sentence": "sent:tatoeba-191501", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "用事 é aquilo que a pessoa precisa resolver, ou seja, algo que ela tem de fazer."}}, {"id": "pp:n4:958", "level": "n4", "stem": "旅行にいく用意をしなさい。", "target": "用意", "correct": "じゅんび", "distractors": ["そうだん", "せつめい", "あんない"], "vocab": "vocab:1546220", "vocab_id": 958, "sentence": "sent:tatoeba-78180", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "用意 é deixar tudo pronto antes de algo acontecer, que é o que じゅんび também nomeia."}}, {"id": "pp:n4:1098", "level": "n4", "stem": "家が見える。", "target": "見える", "correct": "目に入る", "distractors": ["耳に入る", "手に入る", "気に入る"], "vocab": "vocab:1259140", "vocab_id": 1098, "sentence": "sent:tatoeba-8572172", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "「見える」 diz que a casa aparece no campo de visão sem esforço de quem olha, que é o que 「目に入る」 descreve."}}, {"id": "pp:n4:888", "level": "n4", "stem": "風がどんどん強くなった。", "target": "どんどん", "correct": "だんだん", "distractors": ["ときどき", "すこし", "しずかに"], "vocab": "vocab:1009320", "vocab_id": 888, "sentence": "sent:tatoeba-84062", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "Aqui 「どんどん」 mostra o vento ficando mais forte a cada momento, esse avanço contínuo que 「だんだん」 também expressa."}}]