:770", "level": "n4", "stem": "レポート点の上限を10点とします。", "target": "レポート", "correct": "報告書", "distractors": ["テスト", "教科書", "作文"], "vocab_id": 770, "sentence": "sent:tatoeba-5060609", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1145990", "ai_generated": false}, {"id": "pp:n4:771", "level": "n4", "stem": "葉が落ちた。", "target": "葉", "correct": "木や草の緑のうすいもの", "distractors": ["花", "枝", "根"], "vocab_id": 771, "sentence": "sent:tatoeba-78836", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1546550", "ai_generated": false}, {"id": "pp:n4:772", "level": "n4", "stem": "紙が必要だ。", "target": "必要", "correct": "いる", "distractors": ["ある", "足りる", "売れる"], "vocab_id": 772, "sentence": "sent:tatoeba-1272425", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1487660", "ai_generated": false}, {"id": "pp:n4:773", "level": "n4", "stem": "彼女は課長に話しかけた。", "target": "課長", "correct": "会社の上の人", "distractors": ["お客さん", "店員", "学生"], "vocab_id": 773, "sentence": "sent:tatoeba-90797", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1195840", "ai_generated": false}, {"id": "pp:n4:774", "level": "n4", "stem": "地震ほど怖い物はない。", "target": "地震", "correct": "地面がゆれること", "distractors": ["台風", "火事", "事故"], "vocab_id": 774, "sentence": "sent:tatoeba-126870", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1421210", "ai_generated": false}, {"id": "pp:n4:775", "level": "n4", "stem": "学校を卒業すると彼はアフリカへ行った。", "target": "すると", "correct": "したら", "distractors": ["する前に", "しないで", "するために"], "vocab_id": 775, "sentence": "sent:tatoeba-184350", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1006280", "ai_generated": false}, {"id": "pp:n4:778", "level": "n4", "stem": "あの人何学部だっけ？", "target": "学部", "correct": "専門", "distractors": ["学年", "学校", "クラブ"], "vocab_id": 778, "sentence": "sent:tatoeba-2318393", "layer": "C", "needs_revie