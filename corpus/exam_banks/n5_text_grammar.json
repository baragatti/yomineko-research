[{"id": "tg:n5:n5-adjetivos-04-01", "level": "n5", "stem": "きのう、ともだちとえいがを見ました。えいがはおもしろくありませんでした。それ（　）、えきでくだものをかいました。くだものはあまくありませんでしたが、とてもおいしかったです。ともだちも、ぜんぶたべました。", "correct": "から", "distractors": ["けど", "いい", "これ"], "reading": "read:n5-adjetivos-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-adjetivos-05-01", "level": "n5", "stem": "だんだんあきになりました。あさはすずしくなりましたから、（　）こうえんをさんぽします。こうえんのくさも、だんだんきいろくなります。あしたはさむくなりますから、あたたかいコートをきます。", "correct": "いつも", "distractors": ["てある", "どこか", "でした"], "reading": "read:n5-adjetivos-05-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-adjetivos-06-01", "level": "n5", "stem": "おんがくがだいすきです。でも、スポーツはあまりすきではありません。あにはスポーツがすきで、うたが（　）です。あにとテレビでスポーツを見て、後でおんがくをききます。", "correct": "きらい", "distractors": ["しかし", "まえに", "どこか"], "reading": "read:n5-adjetivos-06-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-adjetivos-07-01", "level": "n5", "stem": "ともだちはうたをうたうのがとてもすきです。がっこうのおんがくのじかんに、クラスの前でうたいます。うたうのがじょうずですから、（　）人がききに来ます。あたらしいうたをおぼえるのもすきです。今日はいっしょにおんがくのテープをききます。", "correct": "いつも", "distractors": ["てある", "へいく", "くなる"], "reading": "read:n5-adjetivos-07-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-adjetivos-08-01", "level": "n5", "stem": "今日、おねえさんは大きいこえでうたいました。おねえさんはうたをうたうのがとてもじょうずです。おとうとはえをかくのがじょうずです。おかあさんは、うたうのもえをかくのもじょうずではありません。（　）、ごはんをつくるのがいちばんじょうずです。", "correct": "でも", "distractors": ["かか", "って", "けど"], "reading": "read:n5-adjetivos-08-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-comparacoes-04-01", "level": "n5", "stem": "なつやすみに、ねこがほしいです。くろいねこより、しろいねこのほうがすきです。おかあさんも、しろいねこがすきです。（　）、おとうさんはねこより、いぬのほうがいいといいます。あしたの午後、かぞくでデパートへ行きます。ちいさいねこのカレンダーがほしいです。", "correct": "でも", "distractors": ["それ", "たい", "あれ"], "reading": "read:n5-comparacoes-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-comparacoes-05-01", "level": "n5", "stem": "今日はがっこうが三時におわります。そのあと、ともだちとうみへ行きたいです。うみでおよぎたいです。それ（　）、外でごはんもたべたいです。五時前にいえへかえります。", "correct": "から", "distractors": ["くる", "なる", "いい"], "reading": "read:n5-comparacoes-05-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-comparacoes-06-01", "level": "n5", "stem": "きのう、ともだちとデパートに行きました。きれいなコートがありましたが、高すぎでした（　）、かいませんでした。くつも見ました。でも、小さすぎでした。デパートは大きくて、二時間あるきました。すこしつかれましたが、たのしかったです。", "correct": "から", "distractors": ["どの", "なあ", "そこ"], "reading": "read:n5-comparacoes-06-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-conectando-04-01", "level": "n5", "stem": "今日は学校を休んだんです。きのう（　）、かぜをひいているんです。今、くすりをのんで、へやでねています。あしたはげんきになるでしょう。今日はテストがあったでしょう。あとでテストのはなしをききたいです。", "correct": "から", "distractors": ["なぜ", "どの", "そこ"], "reading": "read:n5-conectando-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-conectando-05-01", "level": "n5", "stem": "あしたはあめだってききました。かさをもって行ったほうがいいですよ。あたらしいようふくはき（　）です。Ｙシャツの上にはコートをきたほうがいいですね。うちの中ではスリッパをはいたほうがいいってききました。", "correct": "ないほうがいい", "distractors": ["ないでください", "ないといけない", "まだていません"], "reading": "read:n5-conectando-05-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-conectando-06-01", "level": "n5", "stem": "来月、友だちと山へ行くつもりです。わたしはまだ（　）山へ行ったことがありません。子どものとき、父とよく外でごはんを食べました。山では、外でごはんを食べるつもりです。行くとき、電車の時間を見ます。", "correct": "その", "distractors": ["くる", "そこ", "だけ"], "reading": "read:n5-conectando-06-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-conectando-07-01", "level": "n5", "stem": "今日は学校で、先生に日本語の読みかたを聞きました。先生の話しかたは、とてもよく分かります。うちでは、本を読んだり、テレビを見たりしました。毎日、書いたり読んだりしています。まだむずかしいです（　）、とてもおもしろいです。", "correct": "けど", "distractors": ["あの", "だけ", "かか"], "reading": "read:n5-conectando-07-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-convites-04-01", "level": "n5", "stem": "あした、いっしょに川へ行きませんか。でんしゃに人が（　）います。はやく出ましょう。パンときっぷは、今日かいます。午前八時に、学校の前であいましょう。", "correct": "たくさん", "distractors": ["でしょう", "ではない", "どうして"], "reading": "read:n5-convites-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-convites-06-01", "level": "n5", "stem": "あしたはいもうとのパーティーです。あたらしいかばん（　）です。今日、いもうとと大きいデパートへ行きました。かばんは高かったですが、とてもかわいかったです。ほんとうはセーターもほしいですが、今日はかばんをかいました。", "correct": "がほしい", "distractors": ["じゃない", "なくちゃ", "けれども"], "reading": "read:n5-convites-06-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-desu-wa-04-01", "level": "n5", "stem": "あのかぎはあなたのですか。いいえ、（　）はあにのかぎです。あっ、あのえんぴつもおにいさんのですか。いいえ、えんぴつはおとうとのです。あのいすもおとうとのです。", "correct": "あれ", "distractors": ["する", "かか", "まで"], "reading": "read:n5-desu-wa-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-desu-wa-05-01", "level": "n5", "stem": "「これはあなたのおかあさんですか。」「ええ、おかあさんです。」「それもおかあさんですか。」「いいえ、それはおばあさんです。」「では、（　）はおじいさんですか。」「ええ、おじいさんです。」", "correct": "あれ", "distractors": ["でも", "そこ", "まで"], "reading": "read:n5-desu-wa-05-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-numeros-tempo-04-01", "level": "n5", "stem": "（　）はがっこうのきょうしつです。きょうしつは二かいです。かいだんはげんかんのがわです。あめは十こ十えんです。くだものは二こ十えんです。コーヒーもぎゅうにゅうも十えんです。", "correct": "ここ", "distractors": ["そこ", "たり", "かか"], "reading": "read:n5-numeros-tempo-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-numeros-tempo-07-01", "level": "n5", "stem": "（　）はがっこうのきょうしつです。このしんぶんはえいごです。あのざっしもえいごです。しかし、このじしょはかんじのじしょです。このしゃしんのことばもかんじです。しかし、あのしゃしんのことばはえいごです。あなたのじしょもかんじのじしょですか。", "correct": "ここ", "distractors": ["あれ", "でも", "から"], "reading": "read:n5-numeros-tempo-07-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-particulas-lugar-04-01", "level": "n5", "stem": "きょうはごごにえきに行きます。あねもえきにきます。それ（　）、えいがかんでえいがを見ます。こんばん、うちでごはんをたべます。", "correct": "から", "distractors": ["でも", "くる", "けど"], "reading": "read:n5-particulas-lugar-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-particulas-lugar-05-01", "level": "n5", "stem": "あしたはがっこうへ行きません。ごぜんはうみへ行きます。うみでおよぎます。ごごはこうえんに行きます。それ（　）、いえへかえります。", "correct": "から", "distractors": ["って", "これ", "どれ"], "reading": "read:n5-particulas-lugar-05-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-particulas-lugar-06-01", "level": "n5", "stem": "あしたはがっこうがありません。あさごはんをたべて、えきまであるいて行きます。それ（　）、あねとえいがを見に行きます。ごごは、こうえんへさんぽに行きます。あねとかいものにも行きます。", "correct": "から", "distractors": ["これ", "って", "もう"], "reading": "read:n5-particulas-lugar-06-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-particulas-lugar-07-01", "level": "n5", "stem": "きのう、がっこうでえをかきました。せんせいも、そのえを見ました。きょう、そのえをいもうとにあげました。いもうとは、あねのくつも見ました。あねは、いもうとにそのくつをあげました。いもうとは、そのくつであそんでい（　）。", "correct": "ます", "distractors": ["でも", "です", "あれ"], "reading": "read:n5-particulas-lugar-07-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-particulas-lugar-08-01", "level": "n5", "stem": "きょうはごごまでだいがくのじゅぎょうがあります。それ（　）、えきまで行きます。えきでぎゅうにゅうとたまごとくだものをかいます。しんぶんやざっしも見ます。きょうはそれだけです。", "correct": "から", "distractors": ["くる", "する", "ので"], "reading": "read:n5-particulas-lugar-08-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-passado-04-01", "level": "n5", "stem": "しごとがおわったなあ。今日はとてもあるいたなあ。でんしゃの中で、しゃしんをとったなあ。いえにかえって、ごはんをたべ（　）なあ。あしたもかいしゃだなあ。", "correct": "たい", "distractors": ["でも", "ので", "そこ"], "reading": "read:n5-passado-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-passado-05-01", "level": "n5", "stem": "きのう、いぬとさんぽに行った。こうえんのそとに、おとこの人がいた。「（　）でいぬとあそぶな。」「こうえんの中にいぬを入れるな。」いぬといえにかえった。いぬもつかれたな。", "correct": "ここ", "distractors": ["くる", "だけ", "なる"], "reading": "read:n5-passado-05-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-perguntas-04-01", "level": "n5", "stem": "ここはおばあさんのいえです。（　）かたはおじです。おじはいしゃです。あちらのかたはおじのおくさんです。おくさんもいしゃですか。ええ、おじもおくさんもいしゃです。", "correct": "あの", "distractors": ["どの", "いい", "たい"], "reading": "read:n5-perguntas-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-perguntas-05-01", "level": "n5", "stem": "（　）、それはどんなかばんですか。これはカメラのかばんです。どんなカメラですか。おおきなカメラです。では、そのカメラはあなたのですか。いいえ、あにのです。", "correct": "あの", "distractors": ["でも", "どれ", "この"], "reading": "read:n5-perguntas-05-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-rotina-04-01", "level": "n5", "stem": "今日は学校がやすみでした。あさは、テレビを見たり、そうじをしたりしました。午後は母といっしょにデパートへ行きました。（　）で、かばんを見たり、コーヒーをのんだりしました。たのしい一日でした。", "correct": "そこ", "distractors": ["もう", "その", "って"], "reading": "read:n5-rotina-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-te-form-03-01", "level": "n5", "stem": "けさははれています。にわのはながきれいにさいています。ははがだいどころであさごはんをつくっています。テーブルの上にパンとバターがおいてあります。コップもならべてあります。ははといっしょに、これ（　）こうえんまでさんぽに行きます。", "correct": "から", "distractors": ["その", "それ", "かか"], "reading": "read:n5-te-form-03-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-te-form-04-01", "level": "n5", "stem": "今、話している人は先生です。（　）にいる女の子は、その先生の子どもです。そこにすわっている人は、学生です。外へ出た人は、もう来ません。ここに名前を書いた人は、ぜんぶで五人です。先生が書いた名前は、いちばん上です。", "correct": "あそこ", "distractors": ["あげる", "だけど", "そして"], "reading": "read:n5-te-form-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-te-form-05-01", "level": "n5", "stem": "ここは、学生が入ってもいいところです。名前は書かなくてもいいです。ここでうたをうたってもいいです。ともだちと話してもいいです。じゅぎょうの時間は、ここに来（　）。五時まで、ここにいてもいいです。", "correct": "てはいけません", "distractors": ["ないといけない", "ないほうがいい", "まだていません"], "reading": "read:n5-te-form-05-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-te-form-07-01", "level": "n5", "stem": "あしたはテストです。今日はうちでかんじを書かないといけません。あたらしいことばも（　）おぼえなくてはいけません。すこしつかれましたが、九時までノートを見ます。", "correct": "たくさん", "distractors": ["がほしい", "じゃない", "がいます"], "reading": "read:n5-te-form-07-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-te-form-08-01", "level": "n5", "stem": "あしたはとてもいそがしい。あさ八時におきなくちゃ。それ（　）、一人でがっこうへ行かなきゃ。ばんごはんはさきにたべてね。あとででんわするよ。じゃあ、あしたね。", "correct": "から", "distractors": ["たり", "どこ", "とき"], "reading": "read:n5-te-form-08-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-verbos-03-01", "level": "n5", "stem": "もしもし、これ（　）いぬとこうえんへさんぽに行きます。あなたもこうえんへきますか。こうえんでいぬとあそびます。こうえんをあるきます。いぬといえへかえります。いえでシャワーをあびます。", "correct": "から", "distractors": ["くる", "とき", "です"], "reading": "read:n5-verbos-03-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-verbos-04-01", "level": "n5", "stem": "（　）からしゅくだいをします。さくぶんもかきます。しゅくだいはもうおわります。それからさんぽをします。あなたもさんぽをしますか。", "correct": "これ", "distractors": ["まで", "だけ", "まだ"], "reading": "read:n5-verbos-04-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-verbos-05-01", "level": "n5", "stem": "ここはこうえんです。大きなきがあります。こどもが三人います。おんなのこがうたをうたいます。いぬもいます。（　）いぬはあにのいぬです。", "correct": "あの", "distractors": ["ので", "それ", "その"], "reading": "read:n5-verbos-05-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}, {"id": "tg:n5:n5-verbos-06-01", "level": "n5", "stem": "おかあさん、これ（　）かいものに行きます。かぎをください。ぎゅうにゅうとくだものをかいます。ざっしもかいます。かいものは、せんえんくらいです。せんえんをください。", "correct": "から", "distractors": ["けど", "ここ", "たり"], "reading": "read:n5-verbos-06-01", "source": "reading+grammar", "layer": "B", "ai_generated": false, "needs_review": false}]