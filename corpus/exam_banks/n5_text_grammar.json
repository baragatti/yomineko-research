[{"id": "tg:n5:n5-adjetivos-04-01", "level": "n5", "stem": "どこに行くところ（　）か。ありがとうございます！", "correct": "です", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-adjetivos-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-adjetivos-05-01", "level": "n5", "stem": "ただ見ているだけです。どこ（　）出るんですか。", "correct": "から", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-adjetivos-05-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-adjetivos-06-01", "level": "n5", "stem": "よし、（　）ってこい！さあ出かけましょう。", "correct": "かか", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-adjetivos-06-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-adjetivos-07-01", "level": "n5", "stem": "どこ（　）来ましたか？外に出ようとしない。どのくらい大きい？", "correct": "から", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-adjetivos-07-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-adjetivos-08-01", "level": "n5", "stem": "どのくら（　）たの？どこから来たのか。とても大きいね。", "correct": "いい", "distractors": ["あの", "あれ", "かか"], "reading": "read:n5-adjetivos-08-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-comparacoes-04-01", "level": "n5", "stem": "グリーンまでどれくらい？長く（　）るんでしょうか。", "correct": "かか", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-comparacoes-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-comparacoes-05-01", "level": "n5", "stem": "ビーチに行きましょう。（　）もヘチマもないわ。", "correct": "でも", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-comparacoes-05-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-comparacoes-06-01", "level": "n5", "stem": "行かないといけないの？（　）に行きましょう？", "correct": "どこ", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-comparacoes-06-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-conectando-04-01", "level": "n5", "stem": "木にぶつかったんです。人気（　）んですか？", "correct": "がある", "distractors": ["あげる", "あそこ", "いつも"], "reading": "read:n5-conectando-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-conectando-05-01", "level": "n5", "stem": "何人の子ども（　）か。千人もの人がそこにいた。", "correct": "がいます", "distractors": ["がほしい", "けっこう", "けれども"], "reading": "read:n5-conectando-05-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-conectando-06-01", "level": "n5", "stem": "車が（　）ばそこへ行ける。いい人だけどイマイチね。", "correct": "あれ", "distractors": ["あの", "かか", "から"], "reading": "read:n5-conectando-06-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-conectando-07-01", "level": "n5", "stem": "お水だけでけっこうです。中休みしようじゃないか。（　）人みたいじゃないか。", "correct": "いい", "distractors": ["あの", "あれ", "かか"], "reading": "read:n5-conectando-07-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-convites-04-01", "level": "n5", "stem": "話をつけよう（　）か。モールに行きましょうか。", "correct": "じゃない", "distractors": ["がいます", "がほしい", "けっこう"], "reading": "read:n5-convites-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-convites-05-01", "level": "n5", "stem": "学校へ行くところ（　）。千人くらいの人がいた。", "correct": "でした", "distractors": ["あげる", "あそこ", "いつも"], "reading": "read:n5-convites-05-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-convites-06-01", "level": "n5", "stem": "ワイン（　）ですか。りんごがほしいですか？", "correct": "がほしい", "distractors": ["がいます", "けっこう", "けれども"], "reading": "read:n5-convites-06-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-desu-wa-04-01", "level": "n5", "stem": "おはようございます！あなたのおかげ（　）。", "correct": "です", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-desu-wa-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-numeros-tempo-04-01", "level": "n5", "stem": "あなたのせい（　）。おやすみなさい。", "correct": "です", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-numeros-tempo-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-particulas-lugar-04-01", "level": "n5", "stem": "さあ、ピザ（　）人ー！お前ら、わがままだな。", "correct": "がいる", "distractors": ["あげる", "あそこ", "いつも"], "reading": "read:n5-particulas-lugar-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-particulas-lugar-05-01", "level": "n5", "stem": "ケチャップ（　）ある？スペアキーってある？", "correct": "って", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-particulas-lugar-05-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-particulas-lugar-06-01", "level": "n5", "stem": "時間（　）か。やぶへびを出すな。", "correct": "があります", "distractors": ["くらい ①", "てください", "どうやって"], "reading": "read:n5-particulas-lugar-06-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-particulas-lugar-07-01", "level": "n5", "stem": "かっけー！おはようござい（　）", "correct": "ます", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-particulas-lugar-07-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-particulas-lugar-08-01", "level": "n5", "stem": "おいくつですか？いくらですか？（　）だけです。", "correct": "それ", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-particulas-lugar-08-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-passado-04-01", "level": "n5", "stem": "タフだ（　）。キツイなあ。", "correct": "なあ", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-passado-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-passado-05-01", "level": "n5", "stem": "見てみたいな。あなたなら、どう（　）？", "correct": "する", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-passado-05-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-perguntas-04-01", "level": "n5", "stem": "ネズミ（　）。こんにちは。", "correct": "でした", "distractors": ["あげる", "あそこ", "いつも"], "reading": "read:n5-perguntas-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-rotina-03-01", "level": "n5", "stem": "クッキーをお一つどうぞ。ちょっと時間（　）るかも。", "correct": "かか", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-rotina-03-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-rotina-04-01", "level": "n5", "stem": "どうや（　）学校に来たの？どうやってできましたか。", "correct": "って", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-rotina-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-te-form-03-01", "level": "n5", "stem": "いすの上にねこがいます。（　）のカウンターです。", "correct": "あそこ", "distractors": ["あげる", "いつも", "がある"], "reading": "read:n5-te-form-03-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-te-form-04-01", "level": "n5", "stem": "（　）にボールってあるの？もしもし、来ていますか。", "correct": "ここ", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-te-form-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-te-form-05-01", "level": "n5", "stem": "出かける時間になった。（　）に先生がいます。", "correct": "あそこ", "distractors": ["あげる", "いつも", "がある"], "reading": "read:n5-te-form-05-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-te-form-06-01", "level": "n5", "stem": "人を（　）かわないで。はい、行きましょう。ええ、どうぞ来てね。", "correct": "から", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-te-form-06-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-te-form-07-01", "level": "n5", "stem": "どんなテストですか。人ごと（　）だろ。どこかに出かけるの？", "correct": "じゃない", "distractors": ["がいます", "がほしい", "けっこう"], "reading": "read:n5-te-form-07-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-te-form-08-01", "level": "n5", "stem": "出かけなきゃ。話（　）んだけど。どこに行きますか？", "correct": "がある", "distractors": ["あげる", "あそこ", "いつも"], "reading": "read:n5-te-form-08-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-verbos-03-01", "level": "n5", "stem": "ダイエットしようとした。おめでとうござい（　）。", "correct": "ます", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-verbos-03-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-verbos-04-01", "level": "n5", "stem": "行きましょうか。もう行か（　）！", "correct": "なきゃ", "distractors": ["あげる", "あそこ", "いつも"], "reading": "read:n5-verbos-04-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-verbos-05-01", "level": "n5", "stem": "クリップってある？クソっ。（　）れ！", "correct": "かか", "distractors": ["あの", "あれ", "いい"], "reading": "read:n5-verbos-05-01", "source": "reading+grammar"}, {"id": "tg:n5:n5-verbos-06-01", "level": "n5", "stem": "行きましょう。うちにいます。人（　）。", "correct": "がいる", "distractors": ["あげる", "あそこ", "いつも"], "reading": "read:n5-verbos-06-01", "source": "reading+grammar"}]