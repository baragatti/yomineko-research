ence": "sent:tatoeba-143687", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:725", "level": "n4", "target": "表", "correct": "表か裏か。", "wrong": ["クラスのみんなの表で歌いました。", "起きてから表を洗いました。", "箱の表におかしを入れました。"], "vocab_id": 725, "sentence": "sent:tatoeba-85365", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:726", "level": "n4", "target": "大学生", "correct": "彼女は高校生だが、彼氏は大学生だ。", "wrong": ["五歳の妹は大学生です。", "兄は大学生を卒業しました。", "来年、大学生に入学します。"], "vocab_id": 726, "sentence": "sent:tatoeba-8413372", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:727", "level": "n4", "target": "運転手", "correct": "前の席に運転手が座っていた。", "wrong": ["学校で運転手に日本語を習う。", "店で運転手に注文しました。", "病院で運転手に見てもらった。"], "vocab_id": 727, "sentence": "sent:tatoeba-140981", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:728", "level": "n4", "target": "予習", "correct": "彼は予習した。", "wrong": ["昨日習った漢字を予習した。", "晩ご飯を予習しておきました。", "パーティーの予習をしました。"], "vocab_id": 728, "sentence": "sent:tatoeba-99201", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:730", "level": "n4", "target": "別", "correct": "別のをいただけますか。", "wrong": ["兄と年が三つ別です。", "駅で友達と別しました。", "今日は誕生日なので別な日だ。"], "vocab_id": 730, "sentence": "sent:tatoeba-83432", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:731", "level": "n4", "target": "非常に", "correct": "今日は非常に暑いです", "wrong": ["教室に学生が非常にいます。", "ご飯を非常に食べました。", "非常に窓を開けてください。"], "vocab_id": 731, "sentence": "sent:gen-965e1e9de008", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:732", "level": "n4", "target": "お宅", "correct": "明日お宅に伺います。", "wrong": ["私は五時にお宅に帰った。", "私のお宅は駅の近くです。", "ホテルのお宅に泊まりました。"], "vocab_id": 732, "sentence": "sent:tatoeba-80618", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:736", "level": "n4", "target": "気", "correct": "気にするな。", "wrong": ["今日は気がいいから散歩しよう。", "気が痛いから薬を飲んだ。", "部屋の気を消してください。"], "vocab_id": 736, "sentence": "sent:tatoeba-183270", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:740", "level": "n4", "target": "郊外", "correct": "彼が郊外に家を買った", "wrong": ["教室の郊外で友だちを待った。", "郊外から日本へ来た人が多い。", "封筒の郊外に住所を書いた。"], "vocab_id": 740, "sentence": "sent:jec-1593", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:742", "level": "n4", "target": "売り場", "correct": "おもちゃ売り場は５階です。", "wrong": ["コンサートの売り場で歌を聞いた。", "レストランの売り場で食べた。", "病院の売り場で薬をもらった。"], "vocab_id": 742, "sentence": "sent:tatoeba-227489", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:743", "level": "n4", "target": "正月", "correct": "正月はすぐそこまで来ている。", "wrong": ["毎月、正月に家賃を払います。", "毎日、正月に昼ご飯を食べる。", "八月の正月に海で泳いだ。"], "vocab_id": 743, "sentence": "sent:tatoeba-142955", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:745", "level": "n4", "target": "運", "correct": "本当に運が良かった", "wrong": ["車の運ができますか。", "毎朝、公園で運をしています。", "明日は運が悪いので、会議に出られません。"], "vocab_id": 745, "sentence": "sent:jec-0498", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:746", "level": "n4", "target": "発音", "correct": "発音はだいたい合ってますよ。", "wrong": ["ドアを閉める発音がうるさい。", "彼は発音が大きくて元気だ。", "駅の発音をよく聞いて乗った。"], "vocab_id": 746, "sentence": "sent:tatoeba-10692051", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:748", "level": "n4", "target": "屋上", "correct": "屋上からは、何マイルも見渡せる。", "wrong": ["山の屋上まで歩いて登った。", "机の屋上に辞書を置いた。", "部屋の屋上に電気がある。"], "vocab_id": 748, "sentence": "sent:tatoeba-188422", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:749", "level": "n4", "target": "失礼", "correct": "失礼してもよろしいですか。", "wrong": ["今日は失礼な天気ですね。", "