eeds_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:765", "level": "n4", "target": "注意", "correct": "落ちないように注意しなさい。", "wrong": ["パーティーの飲み物を注意した。", "店でラーメンを注意しました。", "病院で注意を打ってもらった。"], "vocab_id": 765, "sentence": "sent:tatoeba-78536", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:766", "level": "n4", "target": "台風", "correct": "台風は西に向かって進んだ。", "wrong": ["暑いから台風をつけて寝た。", "台風をひいて、学校を休んだ。", "春の台風が気持ちいい。"], "vocab_id": 766, "sentence": "sent:tatoeba-10320737", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:767", "level": "n4", "target": "軒", "correct": "彼女は鳥かごを軒からつるした。", "wrong": ["部屋の軒にテレビを置いた。", "木の軒に小さい鳥がいる。", "軒で靴をぬいで家に入る。"], "vocab_id": 767, "sentence": "sent:tatoeba-87835", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:770", "level": "n4", "target": "レポート", "correct": "レポート点の上限を10点とします。", "wrong": ["店で買い物のレポートをもらった。", "テレビでレポートがニュースを読んでいる。", "重い荷物を友達がレポートしてくれた。"], "vocab_id": 770, "sentence": "sent:tatoeba-5060609", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:771", "level": "n4", "target": "葉", "correct": "葉が落ちた。", "wrong": ["毎晩寝る前に葉をみがく。", "ノートの葉に名前を書いた。", "のどが渇いたのでお葉を飲んだ。"], "vocab_id": 771, "sentence": "sent:tatoeba-78836", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:772", "level": "n4", "target": "必要", "correct": "紙が必要だ。", "wrong": ["仕事が多くて今週は必要だ。", "毎日必要に日本語を勉強する。", "彼女は私の必要な友達だ。"], "vocab_id": 772, "sentence": "sent:tatoeba-1272425", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:773", "level": "n4", "target": "課長", "correct": "彼女は課長に話しかけた。", "wrong": ["学校の課長に宿題を出した。", "このレストランの課長はだれですか。", "教科書の課長を読んでください。"], "vocab_id": 773, "sentence": "sent:tatoeba-90797", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:774", "level": "n4", "target": "地震", "correct": "地震ほど怖い物はない。", "wrong": ["彼は地震を持って話した。", "明日の地震は雨のち曇りです。", "昨夜は地震が強く降りました。"], "vocab_id": 774, "sentence": "sent:tatoeba-126870", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:775", "level": "n4", "target": "すると", "correct": "学校を卒業すると彼はアフリカへ行った。", "wrong": ["眠い。すると早く寝なさい。", "のどが渇いた。すると水を飲んだ。", "朝起きた。すると顔を洗った。"], "vocab_id": 775, "sentence": "sent:tatoeba-184350", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:778", "level": "n4", "target": "学部", "correct": "あの人何学部だっけ？", "wrong": ["高校で好きな学部は英語だ。", "テニスの学部に入りました。", "弟は小学校の三学部です。"], "vocab_id": 778, "sentence": "sent:tatoeba-2318393", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:780", "level": "n4", "target": "エスカレーター", "correct": "エスカレーターはどこですか？", "wrong": ["エスカレーターのボタンを押した。", "エスカレーターのドアが開いた。", "エスカレーターに乗って学校に通う。"], "vocab_id": 780, "sentence": "sent:tatoeba-11286186", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:781", "level": "n4", "target": "人口", "correct": "人口はどんどん増加していた。", "wrong": ["人口の花を買った。", "この店はいつも人口が多い。", "教室の人口は30人です。"], "vocab_id": 781, "sentence": "sent:tatoeba-144218", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:782", "level": "n4", "target": "絹", "correct": "彼女はいつも絹の服を着ている。", "wrong": ["絹の茶わんでスープを飲んだ。", "寒いので絹をもう一枚かけた。", "この家の窓は絹でできている。"], "vocab_id": 782, "sentence": "sent:tatoeba-93295", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:784", "level": "n4", "target": "深い", "correct": "なかなか奥が深い", "wrong": ["あの人は背が深いですね。", "深いお茶を一杯ください。", "この店は値段が深いです。"], "vocab_id": 784, "sentence": "sent:jec-4303", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:788", "level": "n4", "target": "出来るだけ", "correct": "出来るだけ手紙書くようにするよ。", "wrong": ["昨日は出来るだけ雨が降った。", "彼は出来るだけ日本人だ。", "あの山は出来るだけ高いです。"], "vocab_id": 788, "sentence": "sent:tatoeba-995566", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:790", "level": "n4", "target": "中学校", "correct": "彼は中学校に入った。", "wrong": ["彼は今年から中学校になった。", "大学で中学校を勉強している。", "中学校が三人、公園で遊んでいる。"], "vocab_id": 790, "sentence": "sent:tatoeba-102166", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:793", "level": "n4", "target": "盛ん", "correct": "彼は盛んにしている。", "wrong": ["あの人は性格が盛んだ。", "今日は天気が盛んだ。", "この道は車が盛んだ。"], "vocab_id": 793, "sentence": "sent:tatoeba-103178", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:794", "level": "n4", "target": "アルバイト", "correct": "アルバイトはいい経験になるの。", "wrong": ["先生にアルバイトを出した。", "旅行の写真をアルバイトに入れた。", "アルバイトに答えてください。"], "vocab_id": 794, "sentence": "sent:tatoeba-229934", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:798", "level": "n4", "target": "赤ちゃん", "correct": "たまには赤ちゃんを泣かせておくのもいい。", "wrong": ["二十歳の赤ちゃんが働いている。", "このパンは赤ちゃんだから柔らかい。", "信号が赤ちゃんになった。"], "vocab_id": 798, "sentence": "sent:tatoeba-74111", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:799", "level": "n4", "target": "浅い", "correct": "眠りが浅いんだ。", "wrong": ["背が浅い人が多い。", "値段が浅いから買おう。", "今日は気温が浅いですね。"], "vocab_id": 799, "sentence": "sent:tatoeba-80981", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:800", "level": "n4", "target": "嘘", "correct": "嘘は決してつくな！", "wrong": ["彼はよく嘘をする。", "計算に嘘があった。", "昨夜、楽しい嘘を見た。"], "vocab_id": 800, "sentence": "sent:tatoeba-189506", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:801", "level": "n4", "target": "小説", "correct": "小説を書く方が得意だ", "wrong": ["小説を歌いながら歩いた。", "今朝の小説でニュースを読んだ。", "映画館で小説を見た。"], "vocab_id": 801, "sentence": "sent:jec-5105", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n4:804", "level": "n4", "target": "西洋", "correct": "それらは西洋の風呂よりずっといいです。", "wrong": ["駅は家の西洋にあります。", "太陽は西洋にしずみます。", "道で西洋に会って話した。"], "vocab_id": 804, "sentence": "sent:tatoeba-204702", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}]