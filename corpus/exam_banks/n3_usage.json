[{"id": "us:n3:1365", "level": "n3", "target": "相手", "correct": "こう書いたほうがはっきりと相手に伝わります", "wrong": ["クラスの相手はみんな親切だ。", "店の相手に道を聞いた。", "電車で相手に席をゆずった。"], "vocab": "vocab:1401000", "vocab_id": 1365, "sentence": "sent:jec-2783", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1371", "level": "n3", "target": "明らか", "correct": "彼女が病気だということは明らかだ。", "wrong": ["この部屋は明らかで気持ちがいい。", "明らかな人と話すと楽しい。", "朝は空が明らかになる。"], "vocab": "vocab:1532310", "vocab_id": 1371, "sentence": "sent:tatoeba-95234", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1388", "level": "n3", "target": "誤り", "correct": "雪が青いというのは誤りだ。", "wrong": ["体の誤りで熱が出た。", "電車の誤りで学校に遅れた。", "彼は誤りに来たが、許さなかった。"], "vocab": "vocab:1271290", "vocab_id": 1388, "sentence": "sent:tatoeba-142020", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1408", "level": "n3", "target": "意外", "correct": "それは私にとって意外な話だった。", "wrong": ["日曜日意外は毎日働いている。", "彼の意外を聞いておどろいた。", "昨日、道で意外が起こった。"], "vocab": "vocab:1156410", "vocab_id": 1408, "sentence": "sent:tatoeba-205147", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1422", "level": "n3", "target": "以前", "correct": "彼は以前ほど太ってない。", "wrong": ["三日以前、彼に会った。", "以前、また遊びに来てください。", "駅の以前に本屋がある。"], "vocab": "vocab:1155150", "vocab_id": 1422, "sentence": "sent:tatoeba-110162", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1440", "level": "n3", "target": "一体", "correct": "あの子は一体どうなってしまうのかしら。", "wrong": ["今日は一体いい天気だ。", "一体、宿題が終わった。", "彼は一体まじめな学生です。"], "vocab": "vocab:1164510", "vocab_id": 1440, "sentence": "sent:tatoeba-230963", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1512", "level": "n3", "target": "御", "correct": "御家族はお元気ですか", "wrong": ["御テレビを見ながら休んだ。", "私の御名前は田中です。", "弟の御宿題を手伝った。"], "vocab": "vocab:2826528", "vocab_id": 1512, "sentence": "sent:gen-cb73e9a42699", "layer": "C", "needs_review": true, "ai_generated": true, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1544", "level": "n3", "target": "お前", "correct": "お前ら、わがままだな。", "wrong": ["先生、お前は今お忙しいですか。", "お客様、お前の注文は何ですか。", "社長、お前にご報告します。"], "vocab": "vocab:1002290", "vocab_id": 1544, "sentence": "sent:tatoeba-12976232", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1546", "level": "n3", "target": "思い出", "correct": "昔の思い出が急に心に浮かんだ。", "wrong": ["思い出がいいので、単語をすぐ覚える。", "家に思い出を忘れてきた。", "パソコンの思い出が足りない。"], "vocab": "vocab:1589340", "vocab_id": 1546, "sentence": "sent:tatoeba-142423", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1553", "level": "n3", "target": "音", "correct": "風の音がする。", "wrong": ["赤ちゃんの音で目が覚めた。", "彼女は音がきれいで、歌が上手だ。", "音を出して本を読んでください。"], "vocab": "vocab:2859161", "vocab_id": 1553, "sentence": "sent:tatoeba-11483540", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1562", "level": "n3", "target": "会員", "correct": "クラブの会員は会議室に集まった。", "wrong": ["あの会社の会員として働いている。", "学校の会員はみんな制服を着る。", "家族の会員が一人増えた。"], "vocab": "vocab:1198230", "vocab_id": 1562, "sentence": "sent:tatoeba-225547", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1565", "level": "n3", "target": "会計", "correct": "会計はお帰りのレジでおねがいします。", "wrong": ["毎朝、体重を会計している。", "テストの会計は百点だった。", "銀行でお金を会計した。"], "vocab": "vocab:1198430", "vocab_id": 1565, "sentence": "sent:tatoeba-185332", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1566", "level": "n3", "target": "解決", "correct": "間に人を入れずに解決しよう。", "wrong": ["こわれた時計を解決してもらった。", "宿題の答えを全部解決した。", "かぜが解決して、学校に行けた。"], "vocab": "vocab:1198960", "vocab_id": 1566, "sentence": "sent:tatoeba-183775", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1571", "level": "n3", "target": "外出", "correct": "母は外出しています。", "wrong": ["電車が駅を外出した。", "かばんから本を外出した。", "ごみを外出するのを忘れた。"], "vocab": "vocab:1203800", "vocab_id": 1571, "sentence": "sent:tatoeba-83013", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1587", "level": "n3", "target": "学", "correct": "学がないように見えるね。", "wrong": ["毎朝八時に学へ行く。", "夜遅くまで学をした。", "新しい学を建てる計画だ。"], "vocab": "vocab:1955900", "vocab_id": 1587, "sentence": "sent:tatoeba-12653680", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1596", "level": "n3", "target": "学問", "correct": "どんなに年を取っても学問ができないことはない。", "wrong": ["先生に学問をしてもいいですか。", "毎日ピアノの学問をしている。", "学問の帰りに友達と遊んだ。"], "vocab": "vocab:1207130", "vocab_id": 1596, "sentence": "sent:tatoeba-199499", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1610", "level": "n3", "target": "歌手", "correct": "彼女は歌手として有名だ。", "wrong": ["カラオケで歌手を三曲歌った。", "新しい歌手をダウンロードした。", "彼は歌手が上手だ。"], "vocab": "vocab:1193290", "vocab_id": 1610, "sentence": "sent:tatoeba-90817", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1619", "level": "n3", "target": "勝ち", "correct": "人生楽しんだもん勝ちよ。", "wrong": ["この絵には高い勝ちがある。", "テストでいい勝ちを取った。", "明日、彼と勝ちをすることにした。"], "vocab": "vocab:1609560", "vocab_id": 1619, "sentence": "sent:tatoeba-10459619", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1624", "level": "n3", "target": "活動", "correct": "自由にリアルタイムに活動が出来ます", "wrong": ["このエレベーターは活動していない。", "薬が活動して熱が下がった。", "風で木の葉が活動している。"], "vocab": "vocab:1208360", "vocab_id": 1624, "sentence": "sent:jec-0611", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1655", "level": "n3", "target": "感じ", "correct": "なかなかいい感じで話が進む", "wrong": ["この感じの読み方を教えて。", "彼女に感じを伝えて告白した。", "感じテストで百点を取った。"], "vocab": "vocab:1212250", "vocab_id": 1655, "sentence": "sent:jec-2246", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1662", "level": "n3", "target": "関心", "correct": "もっと社会全体の問題に関心を持つべきだ", "wrong": ["彼の努力にとても関心した。", "彼はよく手伝う関心な子だ。", "彼は関心に勉強している。"], "vocab": "vocab:1215870", "vocab_id": 1662, "sentence": "sent:jec-0530", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1693", "level": "n3", "target": "きつい", "correct": "そうなるとかなりきつい仕事ということになる。", "wrong": ["この石はとてもきつい。", "このくつは大きすぎてきつい。", "この部屋は広くてきつい。"], "vocab": "vocab:1003450", "vocab_id": 1693, "sentence": "sent:tatoeba-213824", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1721", "level": "n3", "target": "給料", "correct": "１日にお給料が入る", "wrong": ["昼ご飯の給料を払った。", "子供に毎月給料をあげている。", "電気の給料が高くて困る。"], "vocab": "vocab:1230360", "vocab_id": 1721, "sentence": "sent:gen-3d755419af95", "layer": "C", "needs_review": true, "ai_generated": true, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1727", "level": "n3", "target": "教師", "correct": "彼は学者というよりは教師だ。", "wrong": ["大学で数学を教師している。", "わからない言葉は教師で調べる。", "ピアノの教師を習っている。"], "vocab": "vocab:1237130", "vocab_id": 1727, "sentence": "sent:tatoeba-108845", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1769", "level": "n3", "target": "区別", "correct": "アヒルとガチョウの区別が付きますか。", "wrong": ["道が二つに区別されている。", "ケーキを六つに区別した。", "家族と区別して一人で暮らす。