ence": "sent:tatoeba-11483540", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1560", "level": "n3", "target": "カード", "correct": "あなたの引いたカードは赤のマークですね。", "wrong": ["図書館でカードを二冊借りた。", "カードで手をふいた。", "雨の日はカードをさして歩く。"], "vocab_id": 1560, "sentence": "sent:tatoeba-74696", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1562", "level": "n3", "target": "会員", "correct": "クラブの会員は会議室に集まった。", "wrong": ["あの会社の会員として働いている。", "学校の会員はみんな制服を着る。", "家族の会員が一人増えた。"], "vocab_id": 1562, "sentence": "sent:tatoeba-225547", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1565", "level": "n3", "target": "会計", "correct": "会計はお帰りのレジでおねがいします。", "wrong": ["毎朝、体重を会計している。", "テストの会計は百点だった。", "銀行でお金を会計した。"], "vocab_id": 1565, "sentence": "sent:tatoeba-185332", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1566", "level": "n3", "target": "解決", "correct": "間に人を入れずに解決しよう。", "wrong": ["こわれた時計を解決してもらった。", "宿題の答えを全部解決した。", "かぜが解決して、学校に行けた。"], "vocab_id": 1566, "sentence": "sent:tatoeba-183775", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1571", "level": "n3", "target": "外出", "correct": "母は外出しています。", "wrong": ["電車が駅を外出した。", "かばんから本を外出した。", "ごみを外出するのを忘れた。"], "vocab_id": 1571, "sentence": "sent:tatoeba-83013", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1587", "level": "n3", "target": "学", "correct": "学がないように見えるね。", "wrong": ["毎朝八時に学へ行く。", "夜遅くまで学をした。", "新しい学を建てる計画だ。"], "vocab_id": 1587, "sentence": "sent:tatoeba-12653680", "layer": "C", "needs_review": 1, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1591", "level": "n3", "target": "学者", "correct": "彼は決して学者ではない。", "wrong": ["大学で学者を専攻している。", "彼は学者が高くて自慢だ。", "息子はまだ小学校の学者だ。"], "vocab_id": 1591, "sentence": "sent:tatoeba-107882", "layer": "C", "needs_review": 1, "source": "a