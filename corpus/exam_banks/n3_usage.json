": "sent:tatoeba-423387", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1900", "level": "n3", "target": "好み", "correct": "私の好みはどちらかというと牛肉ですね。", "wrong": ["彼女の好みはとても明るい。", "この店は若者に好みがある。", "私の好みは医者になることだ。"], "vocab": "vocab:1277500", "vocab_id": 1900, "sentence": "sent:tatoeba-163655", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}, {"id": "us:n3:1908", "level": "n3", "target": "今後", "correct": "今後、あなたの仕事を手伝うようにしましょう。", "wrong": ["今後の試験は難しかった。", "今後、雨が降りました。", "今後の思い出を大切にしたい。"], "vocab": "vocab:1289140", "vocab_id": 1908, "sentence": "sent:tatoeba-172440", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified(real-correct)"}]