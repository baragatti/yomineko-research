[{"id": "pp:n5:90", "level": "n5", "stem": "何駅に行くのですか。", "target": "駅", "correct": "電車にのるところ", "distractors": ["バスにのるところ", "ひこうきにのるところ", "本をかりるところ"], "vocab": "vocab:1175140", "vocab_id": 90, "sentence": "sent:tatoeba-187532", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n5:97", "level": "n5", "stem": "大きいね。", "target": "大きい", "correct": "でかい", "distractors": ["小さい", "みじかい", "まるい"], "vocab": "vocab:1588880", "vocab_id": 97, "sentence": "sent:tatoeba-13063899", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n5:286", "level": "n5", "stem": "時間がありますか。", "target": "時間", "correct": "ひま", "distractors": ["お金", "天気", "電話"], "vocab": "vocab:1315920", "vocab_id": 286, "sentence": "sent:tatoeba-150639", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "Perguntar 時間がありますか é perguntar se a pessoa tem um tempo livre, e ひま é exatamente esse tempo livre."}}, {"id": "pp:n5:326", "level": "n5", "stem": "少し休んだほうがいい。", "target": "少し", "correct": "ちょっと", "distractors": ["たくさん", "もっと", "いつも"], "vocab": "vocab:1348870", "vocab_id": 326, "sentence": "sent:tatoeba-3495506", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "少し e ちょっと marcam a mesma quantidade pequena, então 少し休む equivale a ちょっと休む."}}, {"id": "pp:n5:598", "level": "n5", "stem": "母は毎日うちにいます。", "target": "毎日", "correct": "どの日も", "distractors": ["どの月も", "どの年も", "この日も"], "vocab": "vocab:1524720", "vocab_id": 598, "sentence": "sent:tatoeba-82855", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "毎日 quer dizer que nenhum dia fica de fora, e どの日も expressa a mesma ideia."}}, {"id": "pp:n5:599", "level": "n5", "stem": "毎年ここに来なきゃ。", "target": "毎年", "correct": "どの年も", "distractors": ["どの日も", "どの月も", "この年も"], "vocab": "vocab:1584360", "vocab_id": 599, "sentence": "sent:tatoeba-81248", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "毎年 quer dizer que nenhum ano fica de fora, e どの年も expressa a mesma ideia."}}, {"id": "pp:n5:649", "level": "n5", "stem": "今日は休みじゃなかったの？", "target": "休み", "correct": "しごとのない日", "distractors": ["しごとのある日", "学校のある日", "雨のふる日"], "vocab": "vocab:1227500", "vocab_id": 649, "sentence": "sent:tatoeba-12049582", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "Aqui 休み é o dia em que a pessoa não trabalha nem estuda, e しごとのない日 nomeia esse mesmo dia."}}, {"id": "pp:n5:670", "level": "n5", "stem": "来月には子どもが生まれるんだよ。", "target": "来月", "correct": "つぎの月", "distractors": ["前の月", "この月", "雨の多い月"], "vocab": "vocab:1547900", "vocab_id": 670, "sentence": "sent:tatoeba-8988166", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "来月 é o mês seguinte a este, que é o mesmo mês nomeado por つぎの月."}}, {"id": "pp:n5:672", "level": "n5", "stem": "来年は会えるでしょう。", "target": "来年", "correct": "つぎの年", "distractors": ["前の年", "この年", "休みの多い年"], "vocab": "vocab:1548220", "vocab_id": 672, "sentence": "sent:tatoeba-78581", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified", "explanation": {"pt-BR": "来年 é o ano seguinte a este, que é o mesmo ano nomeado por つぎの年."}}]