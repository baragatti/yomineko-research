[{"id": "pp:n5:3", "level": "n5", "stem": "彼女は濃い青のスカーフをしていた。", "target": "青", "correct": "ブルー", "distractors": ["みどり", "くろ", "ピンク"], "vocab_id": 3, "sentence": "sent:tatoeba-87574", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1381380", "ai_generated": false}, {"id": "pp:n5:4", "level": "n5", "stem": "なぜ空は青いのか？", "target": "青い", "correct": "青色だ", "distractors": ["白い", "暗い", "広い"], "vocab_id": 4, "sentence": "sent:tatoeba-4772868", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1381390", "ai_generated": false}, {"id": "pp:n5:5", "level": "n5", "stem": "このはこの外は緑だが中は赤である。", "target": "赤", "correct": "赤色", "distractors": ["青", "黒", "白"], "vocab_id": 5, "sentence": "sent:tatoeba-223377", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:2013900", "ai_generated": false}, {"id": "pp:n5:8", "level": "n5", "stem": "今年は秋が遅いね。", "target": "秋", "correct": "涼しい季節", "distractors": ["春", "夏", "冬"], "vocab_id": 8, "sentence": "sent:tatoeba-9979558", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1332650", "ai_generated": false}, {"id": "pp:n5:13", "level": "n5", "stem": "朝ごはんはいつもパンを食べます。", "target": "朝ごはん", "correct": "朝食", "distractors": ["昼ごはん", "晩ごはん", "おやつ"], "vocab_id": 13, "sentence": "sent:tatoeba-11013937", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1586330", "ai_generated": false}, {"id": "pp:n5:14", "level": "n5", "stem": "明後日は火曜日です。", "target": "明後日", "correct": "明日の次の日", "distractors": ["明日", "おととい", "今日"], "vocab_id": 14, "sentence": "sent:tatoeba-11171012", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1584640", "ai_generated": false}, {"id": "pp:n5:16", "level": "n5", "stem": "また明日。", "target": "明日", "correct": "今日の次の日", "distractors": ["昨日", "明後日", "今晩"], "vocab_id": 16, "sentence": "sent:tatoeba-195390", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1584660", "ai_generated": false}, {"id": "pp:n5:19", "level": "n5", "stem": "米は暖かい国でできる。", "target": "暖かい", "correct": "寒くない", "distractors": ["寒い", "涼しい", "暗い"], "vocab_id": 19, "sentence": "sent:tatoeba-83506", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1586420", "ai_generated": false}, {"id": "pp:n5:20", "level": "n5", "stem": "母は頭が古い。", "target": "頭", "correct": "考え方", "distractors": ["服", "家", "車"], "vocab_id": 20, "sentence": "sent:tatoeba-82883", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1582310", "ai_generated": false}, {"id": "pp:n5:21", "level": "n5", "stem": "新しい上着を着ている。", "target": "新しい", "correct": "買ったばかりの", "distractors": ["古い", "大きい", "高い"], "vocab_id": 21, "sentence": "sent:tatoeba-145375", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1361490", "ai_generated": false}, {"id": "pp:n5:23", "level": "n5", "stem": "今日はとても暑い。", "target": "暑い", "correct": "気温が高い", "distractors": ["寒い", "涼しい", "暖かい"], "vocab_id": 23, "sentence": "sent:tatoeba-5092", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1343460", "ai_generated": false}, {"id": "pp:n5:24", "level": "n5", "stem": "卵がまだ熱い。", "target": "熱い", "correct": "温度が高い", "distractors": ["冷たい", "やわらかい", "小さい"], "vocab_id": 24, "sentence": "sent:tatoeba-1944413", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1467720", "ai_generated": false}, {"id": "pp:n5:25", "level": "n5", "stem": "この本はとても厚い", "target": "厚い", "correct": "ページが多い", "distractors": ["うすい", "軽い", "小さい"], "vocab_id": 25, "sentence": "sent:gen-bc2e986aa530", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1275320", "ai_generated": true}, {"id": "pp:n5:26", "level": "n5", "stem": "また後で。", "target": "後", "correct": "少ししてから", "distractors": ["明日", "来週", "来年"], "vocab_id": 26, "sentence": "sent:tatoeba-195443", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1269320", "ai_generated": false}, {"id": "pp:n5:28", "level": "n5", "stem": "兄がいます。", "target": "兄", "correct": "年上の男のきょうだい", "distractors": ["姉", "弟", "妹"], "vocab_id": 28, "sentence": "sent:tatoeba-176635", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1249900", "ai_generated": false}, {"id": "pp:n5:29", "level": "n5", "stem": "彼女は姉ほど美しくない。", "target": "姉", "correct": "年上の女のきょうだい", "distractors": ["妹", "兄", "母"], "vocab_id": 29, "sentence": "sent:tatoeba-89788", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1307630", "ai_generated": false}, {"id": "pp:n5:30", "level": "n5", "stem": "もっと広いアパート借りたいわ。", "target": "アパート", "correct": "部屋", "distractors": ["ホテル", "デパート", "レストラン"], "vocab_id": 30, "sentence": "sent:tatoeba-11803240", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1017760", "ai_generated": false}, {"id": "pp:n5:36", "level": "n5", "stem": "また雨だ。", "target": "雨", "correct": "いやな天気", "distractors": ["雪", "風", "くもり"], "vocab_id": 36, "sentence": "sent:tatoeba-195467", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1171900", "ai_generated": false}, {"id": "pp:n5:37", "level": "n5", "stem": "先週食べた飴はいくら？", "target": "飴", "correct": "キャンディー", "distractors": ["ケーキ", "くだもの", "パン"], "vocab_id": 37, "sentence": "sent:tatoeba-7427333", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1153520", "ai_generated": false}, {"id": "pp:n5:41", "level": "n5", "stem": "彼は予習した。", "target": "彼", "correct": "あの人", "distractors": ["彼女", "私", "あなた"], "vocab_id": 41, "sentence": "sent:tatoeba-99201", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1000580", "ai_generated": false}, {"id": "pp:n5:42", "level": "n5", "stem": "あなたなら良い先生になるでしょう。", "target": "良い", "correct": "すばらしい", "distractors": ["悪い", "きびしい", "若い"], "vocab_id": 42, "sentence": "sent:tatoeba-5348486", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1605820", "ai_generated": false}, {"id": "pp:n5:43", "level": "n5", "stem": "いいえ、あまり降りません。", "target": "いいえ", "correct": "いや", "distractors": ["はい", "ええ", "そうです"], "vocab_id": 43, "sentence": "sent:tatoeba-229460", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1583250", "ai_generated": false}, {"id": "pp:n5:48", "level": "n5", "stem": "弟さんって、お幾つですか？", "target": "幾つ", "correct": "何歳", "distractors": ["何人", "何時", "何番"], "vocab_id": 48, "sentence": "sent:tatoeba-10471329", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1219960", "ai_generated": false}, {"id": "pp:n5:51", "level": "n5", "stem": "医者にかかるべきだ。", "target": "医者", "correct": "病院の先生", "distractors": ["学校の先生", "銀行の人", "店の人"], "vocab_id": 51, "sentence": "sent:tatoeba-190906", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1159980", "ai_generated": false}, {"id": "pp:n5:55", "level": "n5", "stem": "願いは一つだけ。", "target": "一", "correct": "いっこ", "distractors": ["ふたつ", "みっつ", "たくさん"], "vocab_id": 55, "sentence": "sent:tatoeba-3449190", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1160790", "ai_generated": false}, {"id": "pp:n5:57", "level": "n5", "stem": "時間は一番大切だ。", "target": "一番", "correct": "なにより", "distractors": ["少し", "二番目に", "ときどき"], "vocab_id": 57, "sentence": "sent:tatoeba-150577", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1165970", "ai_generated": false}, {"id": "pp:n5:59", "level": "n5", "stem": "彼は１９７０年６月５日の朝７時に生まれた。", "target": "５日", "correct": "六日の前の日", "distractors": ["六日の次の日", "四日の前の日", "三日の次の日"], "vocab_id": 59, "sentence": "sent:tatoeba-115273", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1268570", "ai_generated": false}, {"id": "pp:n5:61", "level": "n5", "stem": "りんごを五つ買った", "target": "五つ", "correct": "五個", "distractors": ["三個", "七個", "十個"], "vocab_id": 61, "sentence": "sent:gen-188b541dfd66", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1268070", "ai_generated": true}, {"id": "pp:n5:63", "level": "n5", "stem": "犬は病気みたい。", "target": "犬", "correct": "ワンちゃん", "distractors": ["ねこ", "とり", "うま"], "vocab_id": 63, "sentence": "sent:tatoeba-774692", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1258330", "ai_generated": false}, {"id": "pp:n5:64", "level": "n5", "stem": "今しかない。", "target": "今", "correct": "このとき", "distractors": ["明日", "来週", "昨日"], "vocab_id": 64, "sentence": "sent:tatoeba-172845", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1288850", "ai_generated": false}, {"id": "pp:n5:66", "level": "n5", "stem": "妹さんは元気？", "target": "妹", "correct": "年下の女のきょうだい", "distractors": ["弟さん", "お姉さん", "お兄さん"], "vocab_id": 66, "sentence": "sent:tatoeba-81415", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1524590", "ai_generated": false}, {"id": "pp:n5:67", "level": "n5", "stem": "彼はなんて嫌なやつだ。", "target": "嫌", "correct": "感じの悪い", "distractors": ["親切な", "元気な", "有名な"], "vocab_id": 67, "sentence": "sent:tatoeba-111396", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1587610", "ai_generated": false}, {"id": "pp:n5:72", "level": "n5", "stem": "色の上がりがよい。", "target": "色", "correct": "カラー", "distractors": ["音", "味", "形"], "vocab_id": 72, "sentence": "sent:tatoeba-145958", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1357600", "ai_generated": false}, {"id": "pp:n5:73", "level": "n5", "stem": "色々な人がこのブログを見ているようです", "target": "色々", "correct": "さまざま", "distractors": ["有名", "元気", "静か"], "vocab_id": 73, "sentence": "sent:jec-0466", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1587850", "ai_generated": false}, {"id": "pp:n5:74", "level": "n5", "stem": "上にあがるね。", "target": "上", "correct": "高いところ", "distractors": ["下", "外", "横"], "vocab_id": 74, "sentence": "sent:tatoeba-10628551", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1352130", "ai_generated": false}, {"id": "pp:n5:75", "level": "n5", "stem": "彼は後ろのドアを閉めた。", "target": "後ろ", "correct": "うら", "distractors": ["前", "横", "上"], "vocab_id": 75, "sentence": "sent:tatoeba-107479", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1269410", "ai_generated": false}, {"id": "pp:n5:77", "level": "n5", "stem": "歌が聞こえる？", "target": "歌", "correct": "音楽", "distractors": ["ピアノ", "ニュース", "電話"], "vocab_id": 77, "sentence": "sent:tatoeba-10194962", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1193180", "ai_generated": false}, {"id": "pp:n5:79", "level": "n5", "stem": "工場内での火事のニュースは世間を騒がせた。", "target": "内", "correct": "の中", "distractors": ["の外", "の前", "の横"], "vocab_id": 79, "sentence": "sent:tatoeba-1249725", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1457730", "ai_generated": false}, {"id": "pp:n5:85", "level": "n5", "stem": "私はあなたに絵を見せましょう。", "target": "絵", "correct": "イラスト", "distractors": ["写真", "地図", "手紙"], "vocab_id": 85, "sentence": "sent:tatoeba-161753", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1202270", "ai_generated": false}, {"id": "pp:n5:87", "level": "n5", "stem": "映画館にいたんだ。", "target": "映画館", "correct": "映画を見るところ", "distractors": ["本を読むところ", "ごはんを食べるところ", "およぐところ"], "vocab_id": 87, "sentence": "sent:tatoeba-189288", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1173750", "ai_generated": false}, {"id": "pp:n5:88", "level": "n5", "stem": "英語は学びやすい。", "target": "英語", "correct": "イギリスやアメリカのことば", "distractors": ["日本のことば", "中国のことば", "フ