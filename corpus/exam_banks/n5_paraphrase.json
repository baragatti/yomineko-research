ab": "vocab:1486650", "ai_generated": true}, {"id": "pp:n5:96", "level": "n5", "stem": "厳しい意見が多い", "target": "多い", "correct": "たくさんある", "distractors": ["少しある", "ぜんぜんない", "一つだけある"], "vocab_id": 96, "sentence": "sent:jec-0517", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1407460", "ai_generated": false}, {"id": "pp:n5:97", "level": "n5", "stem": "大きいね。", "target": "大きい", "correct": "でかい", "distractors": ["小さい", "みじかい", "まるい"], "vocab_id": 97, "sentence": "sent:tatoeba-13063899", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1588880", "ai_generated": false}, {"id": "pp:n5:98", "level": "n5", "stem": "大きな音をたてた。", "target": "大きな", "correct": "うるさい", "distractors": ["小さな", "きれいな", "しずかな"], "vocab_id": 98, "sentence": "sent:tatoeba-137741", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1412890", "ai_generated": false}, {"id": "pp:n5:99", "level": "n5", "stem": "人が大勢死にました。", "target": "大勢", "correct": "たくさん", "distractors": ["少し", "一人", "半分"], "vocab_id": 99, "sentence": "sent:tatoeba-10899815", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1414220", "ai_generated": false}, {"id": "pp:n5:100", "level": "n5", "stem": "お母さんは目を大きく開いた。", "target": "お母さん", "correct": "母", "distractors": ["父", "姉", "おばあさん"], "vocab_id": 100, "sentence": "sent:tatoeba-226598", "layer": "C", "needs_review": true, "source": "authored+verified", "vocab": "vocab:1002650", "ai_generated": false}]