[{"id": "pp:n3:1365", "level": "n3", "stem": "こう書いたほうがはっきりと相手に伝わります", "target": "相手", "correct": "読む人", "distractors": ["自分", "仲間", "店員"], "vocab_id": 1365, "sentence": "sent:jec-2783", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1369", "level": "n3", "stem": "明かりをつけていただけません？", "target": "明かり", "correct": "電気", "distractors": ["テレビ", "エアコン", "ストーブ"], "vocab_id": 1369, "sentence": "sent:tatoeba-80735", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1371", "level": "n3", "stem": "彼女が病気だということは明らかだ。", "target": "明らか", "correct": "確か", "distractors": ["残念", "不思議", "意外"], "vocab_id": 1371, "sentence": "sent:tatoeba-95234", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1388", "level": "n3", "stem": "雪が青いというのは誤りだ。", "target": "誤り", "correct": "間違い", "distractors": ["じょうだん", "ひみつ", "うわさ"], "vocab_id": 1388, "sentence": "sent:tatoeba-142020", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1390", "level": "n3", "stem": "嵐になるだろう。", "target": "嵐", "correct": "強い風と雨", "distractors": ["大雪", "地震", "晴れ"], "vocab_id": 1390, "sentence": "sent:tatoeba-78454", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1391", "level": "n3", "stem": "新たに始める。", "target": "新た", "correct": "新しく", "distractors": ["急に", "静かに", "久しぶりに"], "vocab_id": 1391, "sentence": "sent:tatoeba-945909", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1408", "level": "n3", "stem": "それは私にとって意外な話だった。", "target": "意外", "correct": "思いがけない", "distractors": ["複雑な", "退屈な", "大切な"], "vocab_id": 1408, "sentence": "sent:tatoeba-205147", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1422", "level": "n3", "stem": "彼は以前ほど太ってない。", "target": "以前", "correct": "昔", "distractors": ["今", "兄", "写真"], "vocab_id": 1422, "sentence": "sent:tatoeba-110162", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1440", "level": "n3", "stem": "あの子は一体どうなってしまうのかしら。", "target": "一体", "correct": "はたして", "distractors": ["将来", "今夜", "たぶん"], "vocab_id": 1440, "sentence": "sent:tatoeba-230963", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1457", "level": "n3", "stem": "以来ずっと友人です。", "target": "以来", "correct": "その時から", "distractors": ["最近", "時々", "将来"], "vocab_id": 1457, "sentence": "sent:tatoeba-191155", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1512", "level": "n3", "stem": "御家族はお元気ですか", "target": "御", "correct": "あなたの", "distractors": ["私の", "近所の", "昔の"], "vocab_id": 1512, "sentence": "sent:gen-cb73e9a42699", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1542", "level": "n3", "stem": "オフィスに時間ぴったりについた。", "target": "オフィス", "correct": "事務所", "distractors": ["工場", "教室", "空港"], "vocab_id": 1542, "sentence": "sent:tatoeba-227555", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1544", "level": "n3", "stem": "お前ら、わがままだな。", "target": "お前", "correct": "君", "distractors": ["私", "あの人", "彼女"], "vocab_id": 1544, "sentence": "sent:tatoeba-12976232", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1546", "level": "n3", "stem": "昔の思い出が急に心に浮かんだ。", "target": "思い出", "correct": "記憶", "distractors": ["夢", "予定", "悩み"], "vocab_id": 1546, "sentence": "sent:tatoeba-142423", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1553", "level": "n3", "stem": "風の音がする。", "target": "音", "correct": "物音", "distractors": ["におい", "味", "感じ"], "vocab_id": 1553, "sentence": "sent:tatoeba-11483540", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1560", "level": "n3", "stem": "あなたの引いたカードは赤のマークですね。", "target": "カード", "correct": "札", "distractors": ["切符", "はがき", "写真"], "vocab_id": 1560, "sentence": "sent:tatoeba-74696", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1562", "level": "n3", "stem": "クラブの会員は会議室に集まった。", "target": "会員", "correct": "メンバー", "distractors": ["店員", "選手", "客"], "vocab_id": 1562, "sentence": "sent:tatoeba-225547", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1565", "level": "n3", "stem": "会計はお帰りのレジでおねがいします。", "target": "会計", "correct": "支払い", "distractors": ["注文", "予約", "相談"], "vocab_id": 1565, "sentence": "sent:tatoeba-185332", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1566", "level": "n3", "stem": "間に人を入れずに解決しよう。", "target": "解決", "correct": "処理", "distractors": ["けんか", "練習", "計算"], "vocab_id": 1566, "sentence": "sent:tatoeba-183775", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1571", "level": "n3", "stem": "母は外出しています。", "target": "外出", "correct": "出かけて", "distractors": ["寝て", "帰って", "働いて"], "vocab_id": 1571, "sentence": "sent:tatoeba-83013", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1587", "level": "n3", "stem": "学がないように見えるね。", "target": "学", "correct": "教養", "distractors": ["金", "力", "人気"], "vocab_id": 1587, "sentence": "sent:tatoeba-12653680", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1591", "level": "n3", "stem": "彼は決して学者ではない。", "target": "学者", "correct": "研究者", "distractors": ["医者", "役者", "記者"], "vocab_id": 1591, "sentence": "sent:tatoeba-107882", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1594", "level": "n3", "stem": "拡大コピーを撮ってくるよ。", "target": "拡大", "correct": "大きくした", "distractors": ["小さくした", "折りたたんだ", "やり直した"], "vocab_id": 1594, "sentence": "sent:tatoeba-184608", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1596", "level": "n3", "stem": "どんなに年を取っても学問ができないことはない。", "target": "学問", "correct": "勉強", "distractors": ["運動", "料理", "仕事"], "vocab_id": 1596, "sentence": "sent:tatoeba-199499", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1602", "level": "n3", "stem": "人口は過去五年で二倍になった。", "target": "過去", "correct": "ここ", "distractors": ["今後", "あと", "最初の"], "vocab_id": 1602, "sentence": "sent:tatoeba-144217", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1607", "level": "n3", "stem": "店でお菓子を買った", "target": "菓子", "correct": "おやつ", "distractors": ["おかず", "お弁当", "飲み物"], "vocab_id": 1607, "sentence": "sent:gen-dfaf46b9220b", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1610", "level": "n3", "stem": "彼女は歌手として有名だ。", "target": "歌手", "correct": "シンガー", "distractors": ["ダンサー", "モデル", "デザイナー"], "vocab_id": 1610, "sentence": "sent:tatoeba-90817", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1614", "level": "n3", "stem": "カップケーキ型に、ペーパーカップを並べます。", "target": "型", "correct": "用の容器", "distractors": ["店", "教室", "売り場"], "vocab_id": 1614, "sentence": "sent:tatoeba-74614", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1619", "level": "n3", "stem": "人生楽しんだもん勝ちよ。", "target": "勝ち", "correct": "得", "distractors": ["損", "負け", "無駄"], "vocab_id": 1619, "sentence": "sent:tatoeba-10459619", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1621", "level": "n3", "stem": "それはがっかりだよ。", "target": "がっかり", "correct": "残念", "distractors": ["安心", "楽しみ", "びっくり"], "vocab_id": 1621, "sentence": "sent:tatoeba-12698514", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1624", "level": "n3", "stem": "自由にリアルタイムに活動が出来ます", "target": "活動", "correct": "行動", "distractors": ["休憩", "移動", "発表"], "vocab_id": 1624, "sentence": "sent:jec-0611", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1629", "level": "n3", "stem": "彼は金を貸してくれと頼んだ。", "target": "金", "correct": "金銭", "distractors": ["知恵", "車", "傘"], "vocab_id": 1629, "sentence": "sent:tatoeba-2233241", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1633", "level": "n3", "stem": "この山は神様の場所とされている", "target": "神", "correct": "人間をこえた存在", "distractors": ["王様", "動物", "旅人"], "vocab_id": 1633, "sentence": "sent:gen-161559bb6565", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1636", "level": "n3", "stem": "数学は私の苦手な科目の一つだ", "target": "科目", "correct": "教科", "distractors": ["先生", "宿題", "教室"], "vocab_id": 1636, "sentence": "sent:gen-5f5d86caed9b", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1655", "level": "n3", "stem": "なかなかいい感じで話が進む", "target": "感じ", "correct": "調子", "distractors": ["声", "場所", "席"], "vocab_id": 1655, "sentence": "sent:jec-2246", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1661", "level": "n3", "stem": "彼女の日本語と英語力にはいつも感心させられるよ。", "target": "感心", "correct": "感動", "distractors": ["安心", "心配", "緊張"], "vocab_id": 1661, "sentence": "sent:tatoeba-10064776", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1662", "level": "n3", "stem": "もっと社会全体の問題に関心を持つべきだ", "target": "関心", "correct": "興味", "distractors": ["感心", "自信", "疑問"], "vocab_id": 1662, "sentence": "sent:jec-0530", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1673", "level": "n3", "stem": "今日は気温が低い", "target": "気温", "correct": "温度", "distractors": ["湿度", "気圧", "水温"], "vocab_id": 1673, "sentence": "sent:gen-66bf90ac383b", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1686", "level": "n3", "stem": "大臣が記者に接見しました", "target": "記者", "correct": "ジャーナリスト", "distractors": ["医者", "弁護士", "俳優"], "vocab_id": 1686, "sentence": "sent:gen-64268ad6f237", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1689", "level": "n3", "stem": "帰宅後すぐに歯医者に行きました", "target": "帰宅", "correct": "家に帰った", "distractors": ["起きた", "食事した", "出かけた"], "vocab_id": 1689, "sentence": "sent:jec-1398", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1693", "level": "n3", "stem": "そうなるとかなりきつい仕事ということになる。", "target": "きつい", "correct": "大変な", "distractors": ["楽な", "危険な", "新しい"], "vocab_id": 1693, "sentence": "sent:tatoeba-213824", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1708", "level": "n3", "stem": "あまりに空いてると逆に入りづらい。", "target": "逆", "correct": "かえって", "distractors": ["やっと", "すぐに", "たまに"], "vocab_id": 1708, "sentence": "sent:tatoeba-11056577", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1714", "level": "n3", "stem": "休暇はどこに行くの？", "target": "休暇", "correct": "休み", "distractors": ["出張", "仕事", "遠足"], "vocab_id": 1714, "sentence": "sent:tatoeba-182675", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1715", "level": "n3", "stem": "景色のいいところで車をとめて、休憩しよう。", "target": "休憩", "correct": "一休み", "distractors": ["食事", "買い物", "運転"], "vocab_id": 1715, "sentence": "sent:tatoeba-176510", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1721", "level": "n3", "stem": "１日にお給料が入る", "target": "給料", "correct": "働いて受け取るお金", "distractors": ["家賃", "税金", "おつり"], "vocab_id": 1721, "sentence": "sent:gen-3d755419af95", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1723", "level": "n3", "stem": "各学生に教科書を配った", "target": "教科書", "correct": "テキスト", "distractors": ["ノート", "辞書", "雑誌"], "vocab_id": 1723, "sentence": "sent:gen-d19ff46d4144", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1727", "level": "n3", "stem": "彼は学者というよりは教師だ。", "target": "教師", "correct": "先生", "distractors": ["医者", "学生", "記者"], "vocab_id": 1727, "sentence": "sent:tatoeba-108845", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1744", "level": "n3", "stem": "金は少ししかない。", "target": "金", "correct": "黄金", "distractors": ["銀", "鉄", "銅"], "vocab_id": 1744, "sentence": "sent:tatoeba-179727", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1746", "level": "n3", "stem": "医者なら誰でも君に禁煙するように言うだろう。", "target": "禁煙", "correct": "たばこをやめる", "distractors": ["お酒をやめる", "運動を始める", "早く寝る"], "vocab_id": 1746, "sentence": "sent:tatoeba-190909", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1763", "level": "n3", "stem": "いったん悪い癖がつくと、なおすのは難しい。", "target": "癖", "correct": "習慣", "distractors": ["趣味", "性格", "態度"], "vocab_id": 1763, "sentence": "sent:tatoeba-228883", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1768", "level": "n3", "stem": "赤ちゃんは母親の腕の中でぐっすり眠っていた。", "target": "ぐっすり", "correct": "深く", "distractors": ["やっと", "少し", "たまに"], "vocab_id": 1768, "sentence": "sent:tatoeba-142234", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1769", "level": "n3", "stem": "アヒルとガチョウの区別が付きますか。", "target": "区別", "correct": "見分け", "distractors": ["関係", "比較", "世話"], "vocab_id": 1769, "sentence": "sent:tatoeba-230400", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1781", "level": "n3", "stem": "クリスマスに木を飾りましょう", "target": "クリスマス", "correct": "12月25日", "distractors": ["お正月", "誕生日", "夏休み"], "vocab_id": 1781, "sentence": "sent:gen-dfc148c10027", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1809", "level": "n3", "stem": "父はそのゲームに夢中でした。", "target": "ゲーム", "correct": "遊び", "distractors": ["仕事", "勉強", "料理"], "vocab_id": 1809, "sentence": "sent:tatoeba-84720", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1813", "level": "n3", "stem": "その結果はどうなのか。", "target": "結果", "correct": "結末", "distractors": ["原因", "理由", "予定"], "vocab_id": 1813, "sentence": "sent:tatoeba-211124", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1820", "level": "n3", "stem": "日曜の次に月曜が来る。", "target": "月曜", "correct": "週の初め", "distractors": ["火曜", "週末", "祝日"], "vocab_id": 1820, "sentence": "sent:tatoeba-122183", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1824", "level": "n3", "stem": "県下で一番大きい町です", "target": "県", "correct": "県内", "distractors": ["市内", "町内", "国内"], "vocab_id": 1824, "sentence": "sent:gen-56f4ffb33c84", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1827", "level": "n3", "stem": "物には限界というものがある。", "target": "限界", "correct": "限度", "distractors": ["目標", "価値", "意味"], "vocab_id": 1827, "sentence": "sent:tatoeba-83833", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1828", "level": "n3", "stem": "現金又はカードで払えます", "target": "現金", "correct": "キャッシュ", "distractors": ["商品券", "切手", "ポイント"], "vocab_id": 1828, "sentence": "sent:gen-e83363c7c6f1", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1829", "level": "n3", "stem": "言語は人間と同じように変化する。", "target": "言語", "correct": "言葉", "distractors": ["文字", "声", "音"], "vocab_id": 1829, "sentence": "sent:tatoeba-174733", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1833", "level": "n3", "stem": "現実へようこそ！", "target": "現実", "correct": "本当の世界", "distractors": ["夢の世界", "理想の世界", "未来の世界"], "vocab_id": 1833, "sentence": "sent:tatoeba-10721698", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1845", "level": "n3", "stem": "恋の味は苦い。", "target": "恋", "correct": "愛", "distractors": ["夢", "薬", "涙"], "vocab_id": 1845, "sentence": "sent:tatoeba-77447", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1846", "level": "n3", "stem": "彼女は濃い青のスカーフをしていた。", "target": "濃い", "correct": "深い", "distractors": ["薄い", "明るい", "細い"], "vocab_id": 1846, "sentence": "sent:tatoeba-87574", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1854", "level": "n3", "stem": "試験に合格するといいですね", "target": "合格", "correct": "受かる", "distractors": ["落ちる", "遅れる", "出る"], "vocab_id": 1854, "sentence": "sent:gen-1d5a2872c1a1", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1866", "level": "n3", "stem": "今こそ行動する時だ。", "target": "行動", "correct": "動く", "distractors": ["休む", "考える", "待つ"], "vocab_id": 1866, "sentence": "sent:tatoeba-172857", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1868", "level": "n3", "stem": "幸福というのは何ですか。", "target": "幸福", "correct": "幸せ", "distractors": ["成功", "健康", "自由"], "vocab_id": 1868, "sentence": "sent:tatoeba-423387", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1875", "level": "n3", "stem": "氷みたいな冷たい手", "target": "氷", "correct": "凍った水", "distractors": ["石", "火", "ガラス"], "vocab_id": 1875, "sentence": "sent:gen-23bdff9ed0ca", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1884", "level": "n3", "stem": "黒板の字をノートに写す", "target": "黒板", "correct": "ボード", "distractors": ["教科書", "ポスター", "カレンダー"], "vocab_id": 1884, "sentence": "sent:gen-2f6b42865629", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1888", "level": "n3", "stem": "しばらくこの町に腰を落ちつけようと思うんだ。", "target": "腰", "correct": "住もう", "distractors": ["通おう", "泊まろう", "帰ろう"], "vocab_id": 1888, "sentence": "sent:tatoeba-216127", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1900", "level": "n3", "stem": "私の好みはどちらかというと牛肉ですね。", "target": "好み", "correct": "好きなもの", "distractors": ["嫌いなもの", "珍しいもの", "必要なもの"], "vocab_id": 1900, "sentence": "sent:tatoeba-163655", "layer": "C", "needs_review": 1, "source": "authored+verified"}, {"id": "pp:n3:1908", "level": "n3", "stem": "今後、あなたの仕事を手伝うようにしましょう。", "target": "今後", "correct": "これから", "distractors": ["これまで", "以前", "時々"], "vocab_id": 1908, "sentence": "sent:tatoeba-172440", "layer": "C", "needs_review": 1, "source": "authored+verified"}]