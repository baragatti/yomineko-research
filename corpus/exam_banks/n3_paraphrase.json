[{"id": "pp:n3:1369", "level": "n3", "stem": "明かりをつけていただけません？", "target": "明かり", "correct": "電気", "distractors": ["テレビ", "エアコン", "ストーブ"], "vocab": "vocab:1586210", "vocab_id": 1369, "sentence": "sent:tatoeba-80735", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1371", "level": "n3", "stem": "彼女が病気だということは明らかだ。", "target": "明らか", "correct": "確か", "distractors": ["残念", "不思議", "意外"], "vocab": "vocab:1532310", "vocab_id": 1371, "sentence": "sent:tatoeba-95234", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1388", "level": "n3", "stem": "雪が青いというのは誤りだ。", "target": "誤り", "correct": "間違い", "distractors": ["じょうだん", "ひみつ", "うわさ"], "vocab": "vocab:1271290", "vocab_id": 1388, "sentence": "sent:tatoeba-142020", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1422", "level": "n3", "stem": "彼は以前ほど太ってない。", "target": "以前", "correct": "昔", "distractors": ["今", "兄", "写真"], "vocab": "vocab:1155150", "vocab_id": 1422, "sentence": "sent:tatoeba-110162", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1512", "level": "n3", "stem": "御家族はお元気ですか", "target": "御", "correct": "あなたの", "distractors": ["私の", "近所の", "昔の"], "vocab": "vocab:2826528", "vocab_id": 1512, "sentence": "sent:gen-cb73e9a42699", "layer": "C", "needs_review": true, "ai_generated": true, "source": "authored+verified"}, {"id": "pp:n3:1542", "level": "n3", "stem": "オフィスに時間ぴったりについた。", "target": "オフィス", "correct": "事務所", "distractors": ["工場", "教室", "空港"], "vocab": "vocab:1034660", "vocab_id": 1542, "sentence": "sent:tatoeba-227555", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1544", "level": "n3", "stem": "お前ら、わがままだな。", "target": "お前", "correct": "君", "distractors": ["私", "あの人", "彼女"], "vocab": "vocab:1002290", "vocab_id": 1544, "sentence": "sent:tatoeba-12976232", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1553", "level": "n3", "stem": "風の音がする。", "target": "音", "correct": "物音", "distractors": ["におい", "味", "感じ"], "vocab": "vocab:2859161", "vocab_id": 1553, "sentence": "sent:tatoeba-11483540", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1562", "level": "n3", "stem": "クラブの会員は会議室に集まった。", "target": "会員", "correct": "メンバー", "distractors": ["店員", "選手", "客"], "vocab": "vocab:1198230", "vocab_id": 1562, "sentence": "sent:tatoeba-225547", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1565", "level": "n3", "stem": "会計はお帰りのレジでおねがいします。", "target": "会計", "correct": "支払い", "distractors": ["注文", "予約", "相談"], "vocab": "vocab:1198430", "vocab_id": 1565, "sentence": "sent:tatoeba-185332", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1571", "level": "n3", "stem": "母は外出しています。", "target": "外出", "correct": "出かけて", "distractors": ["寝て", "帰って", "働いて"], "vocab": "vocab:1203800", "vocab_id": 1571, "sentence": "sent:tatoeba-83013", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1591", "level": "n3", "stem": "彼は決して学者ではない。", "target": "学者", "correct": "研究者", "distractors": ["医者", "役者", "記者"], "vocab": "vocab:1206800", "vocab_id": 1591, "sentence": "sent:tatoeba-107882", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1596", "level": "n3", "stem": "どんなに年を取っても学問ができないことはない。", "target": "学問", "correct": "勉強", "distractors": ["運動", "料理", "仕事"], "vocab": "vocab:1207130", "vocab_id": 1596, "sentence": "sent:tatoeba-199499", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1610", "level": "n3", "stem": "彼女は歌手として有名だ。", "target": "歌手", "correct": "シンガー", "distractors": ["ダンサー", "モデル", "デザイナー"], "vocab": "vocab:1193290", "vocab_id": 1610, "sentence": "sent:tatoeba-90817", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1621", "level": "n3", "stem": "それはがっかりだよ。", "target": "がっかり", "correct": "残念", "distractors": ["安心", "楽しみ", "びっくり"], "vocab": "vocab:1003170", "vocab_id": 1621, "sentence": "sent:tatoeba-12698514", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1633", "level": "n3", "stem": "この山は神様の場所とされている", "target": "神", "correct": "人間をこえた存在", "distractors": ["王様", "動物", "旅人"], "vocab": "vocab:1364440", "vocab_id": 1633, "sentence": "sent:gen-161559bb6565", "layer": "C", "needs_review": true, "ai_generated": true, "source": "authored+verified"}, {"id": "pp:n3:1636", "level": "n3", "stem": "数学は私の苦手な科目の一つだ", "target": "科目", "correct": "教科", "distractors": ["先生", "宿題", "教室"], "vocab": "vocab:1590600", "vocab_id": 1636, "sentence": "sent:gen-5f5d86caed9b", "layer": "C", "needs_review": true, "ai_generated": true, "source": "authored+verified"}, {"id": "pp:n3:1655", "level": "n3", "stem": "なかなかいい感じで話が進む", "target": "感じ", "correct": "調子", "distractors": ["声", "場所", "席"], "vocab": "vocab:1212250", "vocab_id": 1655, "sentence": "sent:jec-2246", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1689", "level": "n3", "stem": "帰宅後すぐに歯医者に行きました", "target": "帰宅", "correct": "家に帰った", "distractors": ["起きた", "食事した", "出かけた"], "vocab": "vocab:1221430", "vocab_id": 1689, "sentence": "sent:jec-1398", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1693", "level": "n3", "stem": "そうなるとかなりきつい仕事ということになる。", "target": "きつい", "correct": "大変な", "distractors": ["楽な", "危険な", "新しい"], "vocab": "vocab:1003450", "vocab_id": 1693, "sentence": "sent:tatoeba-213824", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1727", "level": "n3", "stem": "彼は学者というよりは教師だ。", "target": "教師", "correct": "先生", "distractors": ["医者", "学生", "記者"], "vocab": "vocab:1237130", "vocab_id": 1727, "sentence": "sent:tatoeba-108845", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1809", "level": "n3", "stem": "父はそのゲームに夢中でした。", "target": "ゲーム", "correct": "遊び", "distractors": ["仕事", "勉強", "料理"], "vocab": "vocab:1048400", "vocab_id": 1809, "sentence": "sent:tatoeba-84720", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1824", "level": "n3", "stem": "県下で一番大きい町です", "target": "県", "correct": "県内", "distractors": ["市内", "町内", "国内"], "vocab": "vocab:1258810", "vocab_id": 1824, "sentence": "sent:gen-56f4ffb33c84", "layer": "C", "needs_review": true, "ai_generated": true, "source": "authored+verified"}, {"id": "pp:n3:1829", "level": "n3", "stem": "言語は人間と同じように変化する。", "target": "言語", "correct": "言葉", "distractors": ["文字", "声", "音"], "vocab": "vocab:1264420", "vocab_id": 1829, "sentence": "sent:tatoeba-174733", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1833", "level": "n3", "stem": "現実へようこそ！", "target": "現実", "correct": "本当の世界", "distractors": ["夢の世界", "理想の世界", "未来の世界"], "vocab": "vocab:1263710", "vocab_id": 1833, "sentence": "sent:tatoeba-10721698", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1854", "level": "n3", "stem": "試験に合格するといいですね", "target": "合格", "correct": "受かる", "distractors": ["落ちる", "遅れる", "出る"], "vocab": "vocab:1284600", "vocab_id": 1854, "sentence": "sent:gen-1d5a2872c1a1", "layer": "C", "needs_review": true, "ai_generated": true, "source": "authored+verified"}, {"id": "pp:n3:1866", "level": "n3", "stem": "今こそ行動する時だ。", "target": "行動", "correct": "動く", "distractors": ["休む", "考える", "待つ"], "vocab": "vocab:1282100", "vocab_id": 1866, "sentence": "sent:tatoeba-172857", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}, {"id": "pp:n3:1908", "level": "n3", "stem": "今後、あなたの仕事を手伝うようにしましょう。", "target": "今後", "correct": "これから", "distractors": ["これまで", "以前", "時々"], "vocab": "vocab:1289140", "vocab_id": 1908, "sentence": "sent:tatoeba-172440", "layer": "C", "needs_review": true, "ai_generated": false, "source": "authored+verified"}]