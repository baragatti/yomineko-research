[{"id": "tg:n4:n4-aspecto-01-01", "level": "n4", "stem": "人は生まれるとすぐ死に始める。私はすぐに帰っ（　）。問題はいつ始めるかだ。何時に帰ってくるの。", "correct": "てくる", "distractors": ["それで", "やっと", "の次に"], "reading": "read:n4-aspecto-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-aspecto-02-01", "level": "n4", "stem": "外は（　）明るくなっていく。カメラは持っていくのですか。町を通っていく。試していく。", "correct": "だんだん", "distractors": ["ぜんぜん", "てあげる", "そうです"], "reading": "read:n4-aspecto-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-aspecto-03-01", "level": "n4", "stem": "ペンキがすぐはげ（　）。あっ、バスが行ってしまう。学校は三時半に終わる。学校は何時に終わるの？", "correct": "てしまう", "distractors": ["聞こえる", "のように", "だんだん"], "reading": "read:n4-aspecto-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-aspecto-04-01", "level": "n4", "stem": "やっ（　）つもりだ。もう一度やってみる。トライしてみる。やってみる。", "correct": "てみる", "distractors": ["てくる", "られる", "らしい"], "reading": "read:n4-aspecto-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-aspecto-05-01", "level": "n4", "stem": "上着を今着ているところだ。ちょうど出かけるところだ。今ここに来（　）だ。今始めたところです。", "correct": "たところ", "distractors": ["のような", "たばかり", "全然ない"], "reading": "read:n4-aspecto-05-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-aspecto-06-01", "level": "n4", "stem": "父は帰国し（　）だ。私は今着いたばかりだ。仕上がったばかり。やっと着いた。", "correct": "たばかり", "distractors": ["と聞いた", "って感じ", "みたいに"], "reading": "read:n4-aspecto-06-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-aspecto-07-01", "level": "n4", "stem": "それは答え（　）質問ね。この本は読みやすい。英語は学びやすい。分かりやすいね。", "correct": "づらい", "distractors": ["ばかり", "かしら", "かかる"], "reading": "read:n4-aspecto-07-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-causativa-01-01", "level": "n4", "stem": "それをさせるわけには（　）ない。父は私を医者にしたがっている。バスルームは今ふさがっている。英語のほかに、ドイツ語を話す。", "correct": "いか", "distractors": ["より", "がり", "ぜひ"], "reading": "read:n4-causativa-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-causativa-02-01", "level": "n4", "stem": "考えさせてください。明日は来なければいけませんよ。電車は３０分ごとに走っている。今日は夕立がある（　）。", "correct": "かもしれない", "distractors": ["てもらえない", "いらっしゃる", "なかなかない"], "reading": "read:n4-causativa-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-causativa-03-01", "level": "n4", "stem": "夕方から雨だっていっ（　）よ。電話を貸していただけませんか。医者に見てもらうべきだと思う。買い物に行っているところです。", "correct": "ていた", "distractors": ["という", "かしら", "が必要"], "reading": "read:n4-causativa-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-condicionais-01-01", "level": "n4", "stem": "本を読むのはとてもおもしろい。どちらがあなたのギターですか。長く（　）つもりですか。来るなといったのにやってきた。", "correct": "いらっしゃる", "distractors": ["ことができる", "ているところ", "てもらえない"], "reading": "read:n4-condicionais-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-condicionais-02-01", "level": "n4", "stem": "たばこをやめ（　）どうなの？言ってみたらどうだ。あなたはもう行ったほうがいい。あなたに会ってほしいのですが。", "correct": "たら", "distractors": ["しし", "出す", "とと"], "reading": "read:n4-condicionais-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-condicionais-03-01", "level": "n4", "stem": "お母さんは目を大きく開いた。りっぱな大人になりたいです。自分の力だけでそれをできる。しかし、人間はち（　）。", "correct": "がっている", "distractors": ["ずっと ①", "ことにする", "じゃないか"], "reading": "read:n4-condicionais-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-condicionais-04-01", "level": "n4", "stem": "きのう来ればよかったのに。電話すればよかったのに。もしわからなかっ（　）聞いてねもしあした雨なら行きません", "correct": "たら", "distractors": ["かい", "まま", "急に"], "reading": "read:n4-condicionais-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-condicionais-05-01", "level": "n4", "stem": "お会いできる（　）ね。また会えるといいですね。明日雨ならば行きません。明日ならどうですか。", "correct": "といいです", "distractors": ["だけでなく", "ようになる", "じゃないか"], "reading": "read:n4-condicionais-05-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-condicionais-06-01", "level": "n4", "stem": "名前を書くだけでいいですこれは（　）にヤバすぎる。言っちゃいけないんだけど。自分でもわかってるくせに。", "correct": "さすが", "distractors": ["が必要", "ごとに", "かかる"], "reading": "read:n4-condicionais-06-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-condicionais-07-01", "level": "n4", "stem": "あまり出かけたくなかった。どれくら（　）かるのかしら。南ターミナルはどこですか。行かなければなりませんか。", "correct": "いか", "distractors": ["など", "ぜひ", "くは"], "reading": "read:n4-condicionais-07-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-condicionais-08-01", "level": "n4", "stem": "どうやって作るか聞いてみたなんにん来るか分かりませんどんなにがんばってみ（　）。これはあれよりも小さい。", "correct": "ても", "distractors": ["いか", "がる", "また"], "reading": "read:n4-condicionais-08-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-conectores-01-01", "level": "n4", "stem": "そうとはまず思えない。（　）十分だよ。まずは食べよう。それでいいよ。", "correct": "それで", "distractors": ["てやる", "ほかに", "さっき"], "reading": "read:n4-conectores-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-conectores-02-01", "level": "n4", "stem": "また始まった。この店は安いです （　）料理もおいしいですこのカフェはまた来たいまた明日会いましょう", "correct": "それに", "distractors": ["やっと", "という", "自動詞"], "reading": "read:n4-conectores-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-conectores-03-01", "level": "n4", "stem": "一日または二日ください。お茶など（　）がでしょう。むずかしいことばがあります たとえばこの漢字スポーツをします たとえばサッカーやテニス", "correct": "いか", "distractors": ["ても", "なら", "よう"], "reading": "read:n4-conectores-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-conectores-04-01", "level": "n4", "stem": "秋はいつしか冬となった。あの先生はやさしいしお（　）ろいこの店は安いしおいしいあの店は安いしおいしい", "correct": "もし", "distractors": ["まず", "ても", "せる"], "reading": "read:n4-conectores-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-conectores-05-01", "level": "n4", "stem": "私は（　）もかまいませんよ。それでも、おまえは人間だ。それでも、リスクはある。車を借りたいのですが。", "correct": "それで", "distractors": ["さっき", "かしら", "やすい"], "reading": "read:n4-conectores-05-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-conectores-06-01", "level": "n4", "stem": "天気はずっと悪いままだった。ひとつ質問し（　）いいですか。旅行をつづけてもいいですか。食べながら話しちゃダメだよ。", "correct": "ても", "distractors": ["急に", "ごろ", "間に"], "reading": "read:n4-conectores-06-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-conectores-07-01", "level": "n4", "stem": "今日の仕事は終わったと言ってもいいもう春だと言ってもいいそして、男の子はそうしました。そこには前に行った（　）がある。", "correct": "こと", "distractors": ["急に", "出す", "なら"], "reading": "read:n4-conectores-07-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-dar-receber-01-01", "level": "n4", "stem": "さんざん小言をいってやる。こらしめてやる。見せ（　）。どちらがほしいのか言いなさい。", "correct": "てあげる", "distractors": ["たとえば", "んだけど", "と聞いた"], "reading": "read:n4-dar-receber-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-dar-receber-02-01", "level": "n4", "stem": "これは父に気に入ってもらう。テレビをつけ（　）？私に教えてくれる？教えてくれるか？", "correct": "てくれる", "distractors": ["たとえば", "どちらが", "のような"], "reading": "read:n4-dar-receber-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-dar-receber-03-01", "level": "n4", "stem": "この動画を見てほしいんだ。会ってほしい人がいるんだ。友だちに来てほしい私の言いたい（　）はこのことだ。", "correct": "こと", "distractors": ["がり", "たら", "れば"], "reading": "read:n4-dar-receber-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-dar-receber-04-01", "level": "n4", "stem": "分けて出し（　）らえますか。教えてくれてありがとう。聞いてくれてありがとう。聞いてくれてありがとう！", "correct": "ても", "distractors": ["間に", "出す", "れる"], "reading": "read:n4-dar-receber-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-experiencia-01-01", "level": "n4", "stem": "そのタオルはきれいなはずです。木からはいろんな物が作られる。明かりをつけ（　）だけません？電気をつけていただけませんか。", "correct": "ていた", "distractors": ["ほかは", "あんな", "または"], "reading": "read:n4-experiencia-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-experiencia-02-01", "level": "n4", "stem": "それは（　）大きくなった。先生はどんどん話しつづけた。だんだん思い出してきたぞ。だんだん地金が出てきた。", "correct": "だんだん", "distractors": ["たらどう", "とみえる", "おになる"], "reading": "read:n4-experiencia-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-experiencia-03-01", "level": "n4", "stem": "ここで会え（　）。生まれてきてよかった。気がついてよかった。生きててよかった！", "correct": "てよかった", "distractors": ["からできる", "るところだ", "ということ"], "reading": "read:n4-experiencia-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-experiencia-04-01", "level": "n4", "stem": "そのおもちゃはプラスチックでできているワインはぶどうから作りますこのいすは木でできているワインはぶどう（　）", "correct": "からできる", "distractors": ["がみられる", "るところだ", "いたします"], "reading": "read:n4-experiencia-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-experiencia-05-01", "level": "n4", "stem": "この時計は１５分ごとになる。バスは１５分ごとにでます。２０分ごとにバスがある。バスでは時間が（　）ぞ。", "correct": "かかる", "distractors": ["だけで", "ばかり", "が必要"], "reading": "read:n4-experiencia-05-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-experiencia-06-01", "level": "n4", "stem": "あいつは、（　）切れた。今日はずっと気分がよい。金は水よりずっと重い。以来ずっと友人です。", "correct": "とうとう", "distractors": ["おになる", "とみえる", "ほとんど"], "reading": "read:n4-experiencia-06-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-forma-simples-01-01", "level": "n4", "stem": "見たいのかしら？車があればどんなによいだろう。二、三デメリットがありますね。バスでどのくら（　）かりますか。", "correct": "いか", "distractors": ["こと", "がり", "もし"], "reading": "read:n4-forma-simples-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-forma-simples-02-01", "level": "n4", "stem": "車で来るんじゃな（　）な。もう時間がないじゃないか時間があるかどうか分からない。男の子ですか？それとも女の子？", "correct": "いか", "distractors": ["また", "急に", "だが"], "reading": "read:n4-forma-simples-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-forma-simples-03-01", "level": "n4", "stem": "一人で行くし（　）い。2時間しかないんだ。あと1日しかない。やるしかない。", "correct": "かな", "distractors": ["いか", "がり", "など"], "reading": "read:n4-forma-simples-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-forma-simples-04-01", "level": "n4", "stem": "十時（　）ですか。何時ごろ来たの？ちくしょう！わるくないなあ！とにかく行きたくなかったの。", "correct": "ごろ", "distractors": ["せる", "がる", "なら"], "reading": "read:n4-forma-simples-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-forma-simples-05-01", "level": "n4", "stem": "先生といっ（　）いろいろある。７月にしては今日はすずしい。あの男ももう上がったりだ。さっさと行ったほうがいい。", "correct": "ても", "distractors": ["いか", "のに", "もし"], "reading": "read:n4-forma-simples-05-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-forma-simples-06-01", "level": "n4", "stem": "どうやって時間をつぶそう？木の下にベンチがあります。ちょっと話がある（　）。来る日も来る日も雨だった。", "correct": "んだけど", "distractors": ["ぜんぜん", "だんだん", "てくれる"], "reading": "read:n4-forma-simples-06-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-forma-simples-07-01", "level": "n4", "stem": "（　）だな！さすが！時間があるか分かりません。父はついさきほど出かけた。", "correct": "さすが", "distractors": ["ばかり", "させる", "ていく"], "reading": "read:n4-forma-simples-07-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-keigo-01-01", "level": "n4", "stem": "特別料理が（　）が。おめでとうございます！ありがとうございます。おはようございます。", "correct": "ございます", "distractors": ["させられる", "ことになる", "おください"], "reading": "read:n4-keigo-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-keigo-02-01", "level": "n4", "stem": "切らずにそのままお待ち下さい。下着は着けたままでいいですよ。お茶を飲み（　）話しませんか。お茶を飲みながら話しましょう。", "correct": "ながら", "distractors": ["みたい", "それで", "ほかに"], "reading": "read:n4-keigo-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-keigo-03-01", "level": "n4", "stem": "お子さんは（　）の？もし来られたら来なさい。本はそのままにしておきなさい。この本はあの本ほど大きくない。", "correct": "いらっしゃる", "distractors": ["なかなかない", "てすみません", "まいのように"], "reading": "read:n4-keigo-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-keigo-05-01", "level": "n4", "stem": "朝食は何時に（　）か。事前にお知らせいたします。後でお電話いたします。お知らせいたします。", "correct": "いたします", "distractors": ["ことにする", "ございます", "ばよかった"], "reading": "read:n4-keigo-05-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-keigo-06-01", "level": "n4", "stem": "少し待っていただけませんか。車を貸していただけませんか。電話を切らずにおいてください。時間があっ（　）来てください。", "correct": "たら", "distractors": ["急に", "かな", "ても"], "reading": "read:n4-keigo-06-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-obrigacao-01-01", "level": "n4", "stem": "質問は書い（　）だけませんか。目が口よりものを言う時がある。今日売らなくちゃいけないんだ。父さんはどこへ行ったんだろう。", "correct": "ていた", "distractors": ["きっと", "てすみ", "なさる"], "reading": "read:n4-obrigacao-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-obrigacao-02-01", "level": "n4", "stem": "父はまもなく元気になるだろう。私が話しているときは私を見て！父はと（　）元気でやっています。まだ持ってるか分からないなあ。", "correct": "ても", "distractors": ["より", "出す", "れる"], "reading": "read:n4-obrigacao-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-obrigacao-03-01", "level": "n4", "stem": "私は食べなければいけない。待たなければいけない。母は病気（　）、いつも明るい。ミスタイプです。すみません。", "correct": "だが", "distractors": ["しし", "ても", "いか"], "reading": "read:n4-obrigacao-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-obrigacao-04-01", "level": "n4", "stem": "あした早く起きないとおれの言うとおりではな（　）。水をいっぱいほしいんだけど。７時までに着きたいんだけど。", "correct": "いか", "distractors": ["だが", "れば", "よう"], "reading": "read:n4-obrigacao-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-obrigacao-05-01", "level": "n4", "stem": "その男はとうとう立ち去った。もっと早く始めるべきだった。今日はここまでにしておこう。ここには今着い（　）なの？", "correct": "たばかり", "distractors": ["そんなに", "だいたい", "ほとんど"], "reading": "read:n4-obrigacao-05-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-oracoes-relativas-01-01", "level": "n4", "stem": "もっと休みをとったほうがいい。先月インフルエンザにかかった。今からドライブに行き（　）か。大雨で外出できなかったんです。", "correct": "ません", "distractors": ["そうに", "てみる", "さっき"], "reading": "read:n4-oracoes-relativas-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-oracoes-relativas-02-01", "level": "n4", "stem": "１３って言った？それとも３０？どうもごりっぱな言いわけだよ。それをすぐにし（　）いいですか。行きたくないのなら、行くな。", "correct": "ても", "distractors": ["また", "ごろ", "かい"], "reading": "read:n4-oracoes-relativas-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-oracoes-relativas-03-01", "level": "n4", "stem": "自分でもそれをやってみます。やがて雨になる（　）。今それをやっているところだ。日本語のガイドがありますか。", "correct": "かもしれない", "distractors": ["なかなかない", "ようにいのる", "まいのように"], "reading": "read:n4-oracoes-relativas-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-oracoes-relativas-04-01", "level": "n4", "stem": "後で話そうね。後でやって。（　）後で。あなたはどこにいたのですか。", "correct": "また", "distractors": ["なら", "出す", "かい"], "reading": "read:n4-oracoes-relativas-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-oracoes-relativas-05-01", "level": "n4", "stem": "人生とは（　）ものさ。ひょっとしたら明日は雨かも。あなたは行ったほうがいい。どんなワインがありますか。", "correct": "そんな", "distractors": ["ません", "のはだ", "ながら"], "reading": "read:n4-oracoes-relativas-05-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-oracoes-relativas-06-01", "level": "n4", "stem": "OK（　）聞いてみた。今日はそれをやりたくない。しゃべるべきじゃなかった。今日は休みじゃなかったの？", "correct": "かどうか", "distractors": ["みたいに", "そんなに", "てあげる"], "reading": "read:n4-oracoes-relativas-06-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-oracoes-relativas-07-01", "level": "n4", "stem": "人をからかってはいけない。明日行くからそのつもりで。なれすぎはあなどりを生む。2月は28日までし（　）い。", "correct": "かな", "distractors": ["まず", "より", "かい"], "reading": "read:n4-oracoes-relativas-07-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-passiva-01-01", "level": "n4", "stem": "手に入れ（　）と思いますよ。花は切られるとすぐにしぼむ。水道の水が止められた。この本は多くの人に読まれている", "correct": "られる", "distractors": ["させる", "が必要", "いがい"], "reading": "read:n4-passiva-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-passiva-02-01", "level": "n4", "stem": "私にはどれも同じに見えるけど。電話を発明したのはだれですか。母が帰って来たらしかられるよ。私はたった今帰っ（　）です。", "correct": "たばかり", "distractors": ["って感じ", "たとえば", "全然ない"], "reading": "read:n4-passiva-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-passiva-03-01", "level": "n4", "stem": "今日は風が（　）。今日はこのくらいにしておこう。今すぐそれをしたほうがいいよ。あなたがたにお話をしてあげる。", "correct": "あまりない", "distractors": ["させられる", "ばよかった", "じゃないか"], "reading": "read:n4-passiva-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-potencial-01-01", "level": "n4", "stem": "ミルクからチーズが作られる。今日はいそがしくて来られ（　）この本は子どもでも読めますこの車はもうすぐスクラップだ。", "correct": "ません", "distractors": ["やすい", "がする", "のはだ"], "reading": "read:n4-potencial-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-potencial-02-01", "level": "n4", "stem": "食べながら読んではいけません。新しいクラスは（　）がですか。人をあざわらうのはよくない。明日よりも今日行きたいんだ。", "correct": "いか", "distractors": ["また", "れる", "おう"], "reading": "read:n4-potencial-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-potencial-03-01", "level": "n4", "stem": "モロに聞こえる。もうこれよりほかに手はない。ほかにご用はございませんか。明日は雨になる（　）。", "correct": "かもしれない", "distractors": ["すくなくない", "てすみません", "ようにいのる"], "reading": "read:n4-potencial-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-potencial-04-01", "level": "n4", "stem": "車でどれくら（　）かりますか。明日天気はどうなるだろうか。父はお金にきちょうめんです。本は友人みたいなものである。", "correct": "いか", "distractors": ["また", "ても", "間に"], "reading": "read:n4-potencial-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-revisao-01-01", "level": "n4", "stem": "母に言うべき（　）なのだろうか？魚だけでなく、肉も食べなさい。ご飯とパンどちらがいいですか。明日ゴルフをしたらどうですか。", "correct": "こと", "distractors": ["のに", "くは", "がり"], "reading": "read:n4-revisao-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-revisao-02-01", "level": "n4", "stem": "来てくださればとてもうれしい。そんな（　）は起きないでしょう。今度は、いつ会うことができる？そうなさるのもごもっともです。", "correct": "こと", "distractors": ["れる", "だが", "出す"], "reading": "read:n4-revisao-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-revisao-03-01", "level": "n4", "stem": "学校まで１０分で歩いて行ける。夕食までどれくらいありますか。毎日、６時までには帰りますよ。テレビをつけっぱなし（　）な！", "correct": "にする", "distractors": ["ていた", "ですが", "続ける"], "reading": "read:n4-revisao-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-suposicao-01-01", "level": "n4", "stem": "あの店のラーメンはおいしいと聞いた先生は来週休むと聞いた試験などなければいいのになあ。買い物に行（　）ければならない。", "correct": "かな", "distractors": ["出す", "よう", "せる"], "reading": "read:n4-suposicao-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-suposicao-02-01", "level": "n4", "stem": "世界はいつ終わる（　）。夜は雨になるらしい。雨になるらしいよ。雨らしい。", "correct": "のだろうか", "distractors": ["ことがある", "ようになる", "ずっと ①"], "reading": "read:n4-suposicao-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-suposicao-03-01", "level": "n4", "stem": "お前みたいになりたいよ。バカみたい。あの店は今日休みみたいだ私は早く起きる（　）にしている。", "correct": "こと", "distractors": ["たら", "しし", "間に"], "reading": "read:n4-suposicao-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-suposicao-04-01", "level": "n4", "stem": "私は今夜話すことになっている。今日はむしろ外出したくない。お安くしてもらえな（　）しら？親切にしてやればつけあがる。", "correct": "いか", "distractors": ["ぜひ", "もし", "間に"], "reading": "read:n4-suposicao-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-suposicao-05-01", "level": "n4", "stem": "この近くに映画館はありますか。リムジンを使うといいですよ。二人の間がしっくり行（　）い。出来れば明日までに帰ります。", "correct": "かな", "distractors": ["がる", "ごろ", "せる"], "reading": "read:n4-suposicao-05-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-suposicao-06-01", "level": "n4", "stem": "このレストランはイタリア風の料理を出す山の上から海が見られる帰りに買い物してきてくれる？手紙を書い（　）です。", "correct": "ているところ", "distractors": ["すくなくない", "かもしれない", "いらっしゃる"], "reading": "read:n4-suposicao-06-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-suposicao-07-01", "level": "n4", "stem": "歩き方がとてもゆっくりだね。１３人？たったそんだけかよ。来て下さるだけでいいのです。どうしてい（　）わからないよ。", "correct": "いか", "distractors": ["まま", "など", "せる"], "reading": "read:n4-suposicao-07-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-suposicao-08-01", "level": "n4", "stem": "私は明日死ぬ（　）。バスはすぐ来るはずです。雨になるかもしれないな。これで十分なはずです。", "correct": "かもしれない", "distractors": ["てすみません", "でございます", "ているところ"], "reading": "read:n4-suposicao-08-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-transitividade-02-01", "level": "n4", "stem": "その先生は大学を出（　）だ。火にあたりながらすわっていた。私にとってのるかそるかだった。私が持ち上げるには重すぎるよ。", "correct": "たばかり", "distractors": ["たとえば", "でできる", "から作る"], "reading": "read:n4-transitividade-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-transitividade-03-01", "level": "n4", "stem": "私は（　）タバコをやめた。なるべく安いほうがいいです。物事をありのままに見なさい。ロッジはひぎめでかりられる。", "correct": "とうとう", "distractors": ["だんだん", "とみえる", "ほとんど"], "reading": "read:n4-transitividade-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-transitividade-04-01", "level": "n4", "stem": "明日の朝に電話を（　）。たった今気づいたところです。５０００円ばかりもっている。明日雨かどうか分かりますか。", "correct": "いたします", "distractors": ["おください", "でも でも", "るところだ"], "reading": "read:n4-transitividade-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-transitividade-05-01", "level": "n4", "stem": "気にかけ（　）だいてどうも。ごめんなさい。私のせいです。海まではわずか半マイルだ。ポーチにスカンクがいます。", "correct": "ていた", "distractors": ["または", "ほかは", "が必要"], "reading": "read:n4-transitividade-05-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-volitivo-01-01", "level": "n4", "stem": "ここにいようと思う。また会おう！今日はこれでおしまいにしよう。時間はどのくら（　）かりますか。", "correct": "いか", "distractors": ["れば", "とと", "がる"], "reading": "read:n4-volitivo-01-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-volitivo-02-01", "level": "n4", "stem": "ないと思うけど。バスはもうやっ（　）時間だ。正月はすぐそこまで来ている。エスカレーターはどこですか？", "correct": "てくる", "distractors": ["らしい", "ですが", "命令形"], "reading": "read:n4-volitivo-02-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-volitivo-03-01", "level": "n4", "stem": "名前を教え（　）だけますか。別のを見せてもらえませんか。このあたりはよく知りません。この本はあの本よりも小さい。", "correct": "ていた", "distractors": ["場合は", "の次に", "意向形"], "reading": "read:n4-volitivo-03-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-volitivo-04-01", "level": "n4", "stem": "それとこれとは話が別でしょ。それとこれとは別だ（　）よ。あなたのせいではありません。レモンはすっぱいくだものだ。", "correct": "と思う", "distractors": ["おきに", "そうに", "ごとに"], "reading": "read:n4-volitivo-04-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-volitivo-05-01", "level": "n4", "stem": "ちょっと見ているだけです。ちょっと気になるんだけど。いつも言ってるじゃな（　）。さすがにそれはやりすぎだ。", "correct": "いか", "distractors": ["まず", "たら", "後で"], "reading": "read:n4-volitivo-05-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-volitivo-06-01", "level": "n4", "stem": "目を開けなさい。目を開きなさい。立ちなさい。どうやっ（　）のか教えて。", "correct": "てやる", "distractors": ["なくて", "と思う", "おきに"], "reading": "read:n4-volitivo-06-01", "source": "reading+grammar"}, {"id": "tg:n4:n4-volitivo-07-01", "level": "n4", "stem": "この道はもう通るまいと思ったなるべく日本語で話したい気に入ってくれるといいな。もう行（　）くてはならない。", "correct": "かな", "distractors": ["間に", "いか", "とと"], "reading": "read:n4-volitivo-07-01", "source": "reading+grammar"}]