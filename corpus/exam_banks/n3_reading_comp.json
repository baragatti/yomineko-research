[{"id": "rc:n3:n3-causa-01-01", "level": "n3", "reading": "read:n3-causa-01-01", "question": "どうして雨にぬれなかったのか。", "correct": "木があったから", "distractors": ["かさをさしたから", "家の中にいたから", "雨が降らなかったから"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-causa-02-01", "level": "n3", "reading": "read:n3-causa-02-01", "question": "この文章の内容と合っているものはどれか。", "correct": "フランス語は多くの人が話している", "distractors": ["フランス語を話す人はとても少ない", "ドアを開けるのはジムではない", "引力があっても物体は重くならない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-causa-03-01", "level": "n3", "reading": "read:n3-causa-03-01", "question": "朝の5時の外の様子について、正しいものはどれか。", "correct": "外はもう明るい", "distractors": ["外はまだ暗い", "雨が降っている", "星が見える"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-causa-04-01", "level": "n3", "reading": "read:n3-causa-04-01", "question": "「あなた」のフランス語の発音について、どう言っているか。", "correct": "とても悪い", "distractors": ["とても上手だ", "少しだけおかしい", "前より良くなった"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-causa-05-01", "level": "n3", "reading": "read:n3-causa-05-01", "question": "「ぼく」はこの仕事をいつまでに終わらせたいと思っているか。", "correct": "一週間のうちに", "distractors": ["今日のうちに", "一か月のうちに", "半年のうちに"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-causa-05-02", "level": "n3", "reading": "read:n3-causa-05-02", "question": "何が問題だと言っているか。", "correct": "お金が足りないこと", "distractors": ["時間が足りないこと", "人が足りないこと", "駅が遠いこと"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-causa-06-01", "level": "n3", "reading": "read:n3-causa-06-01", "question": "「受注生産」とはどんなものか。", "correct": "注文のあとで作ること", "distractors": ["作ったあとで注文を受けること", "注文なしで作っておくこと", "客が自分で作ること"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-causa-06-02", "level": "n3", "reading": "read:n3-causa-06-02", "question": "道について、正しいものはどれか。", "correct": "二つに分かれていた", "distractors": ["三つに分かれていた", "通れなくなっていた", "ずっとまっすぐだった"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-causa-07-01", "level": "n3", "reading": "read:n3-causa-07-01", "question": "火事の場合は、何番に電話すればいいか。", "correct": "１１９番", "distractors": ["１１０番", "１１７番", "１０４番"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-causa-07-02", "level": "n3", "reading": "read:n3-causa-07-02", "question": "二つの本について、正しいものはどれか。", "correct": "あの本のほうがおもしろい", "distractors": ["この本のほうがおもしろい", "二つとも同じくらいおもしろい", "二つともつまらない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-causa-08-01", "level": "n3", "reading": "read:n3-causa-08-01", "question": "立っていた人たちについて、正しいものはどれか。", "correct": "全員男の人だった", "distractors": ["全員女の人だった", "男の人も女の人もいた", "子どもだけだった"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-causa-08-02", "level": "n3", "reading": "read:n3-causa-08-02", "question": "お金の使い方について、何と言っているか。", "correct": "むだに使わないほうがいい", "distractors": ["どんどん使ったほうがいい", "全部ためたほうがいい", "人に貸したほうがいい"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-concessao-01-01", "level": "n3", "reading": "read:n3-concessao-01-01", "question": "値段について、正しいものはどれか。", "correct": "少なくとも３万円は必要だ", "distractors": ["高くても３万円で済む", "３万円より安くなることもある", "３千円あれば十分だ"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-concessao-02-01", "level": "n3", "reading": "read:n3-concessao-02-01", "question": "この人はどうして今日休みを取ったのか。", "correct": "日曜日に仕事をしたから", "distractors": ["病気になったから", "旅行に行きたいから", "日曜日にも休んだから"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-concessao-03-01", "level": "n3", "reading": "read:n3-concessao-03-01", "question": "今度来た先生は、どんな人だと言っているか。", "correct": "友達のような人", "distractors": ["とてもきびしい人", "先生らしい人", "年をとった人"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-concessao-04-01", "level": "n3", "reading": "read:n3-concessao-04-01", "question": "「彼」の仕事について、正しいものはどれか。", "correct": "若いのに、いい仕事をした", "distractors": ["若いので、仕事に失敗した", "年を取ってから働き始めた", "仕事はあまりよくなかった"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-concessao-05-01", "level": "n3", "reading": "read:n3-concessao-05-01", "question": "両親は昨晩、何をしていたか。", "correct": "小さな声で話していた", "distractors": ["大きな声でけんかしていた", "テレビを見ていた", "早く寝ていた"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-concessao-05-02", "level": "n3", "reading": "read:n3-concessao-05-02", "question": "赤ちゃんはどこで生まれたか。", "correct": "病院へ行く途中で", "distractors": ["病院の中で", "家の中で", "店の前で"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-concessao-06-01", "level": "n3", "reading": "read:n3-concessao-06-01", "question": "ストーブが消えたとき、この人はどうしたか。", "correct": "すぐにまたつけた", "distractors": ["そのままにしておいた", "新しいものを買った", "部屋を出た"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-concessao-06-02", "level": "n3", "reading": "read:n3-concessao-06-02", "question": "この国のラクダについて、正しいものはどれか。", "correct": "とても大切なものだ", "distractors": ["もういらないものだ", "めずらしいものだ", "外国にしかいないものだ"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-concessao-07-01", "level": "n3", "reading": "read:n3-concessao-07-01", "question": "世界の言葉の数について、正しいものはどれか。", "correct": "少なくとも４０００はある", "distractors": ["４０００より少ない", "１０００ぐらいだ", "だれにも分からない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-concessao-07-02", "level": "n3", "reading": "read:n3-concessao-07-02", "question": "ドアを開けたいときは、どうすればいいか。", "correct": "ボタンを押す", "distractors": ["ドアを強く引く", "かぎを開ける", "レジでお金を払う"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-01-01", "level": "n3", "reading": "read:n3-conectores-01-01", "question": "この人が何度も聞いているのは、どんなことか。", "correct": "どうやって行くかということ", "distractors": ["どこへ行くかということ", "いつ出発するかということ", "だれと行くかということ"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-02-01", "level": "n3", "reading": "read:n3-conectores-02-01", "question": "この人は今日、何と言われたか。", "correct": "休むように言われた", "distractors": ["歌うように言われた", "元気を出すように言われた", "早く帰るように言われた"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-03-01", "level": "n3", "reading": "read:n3-conectores-03-01", "question": "どうしてこの道を通ってはいけないのか。", "correct": "工事をしているから", "distractors": ["事故があったから", "車が多すぎるから", "道がこわれたから"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-04-01", "level": "n3", "reading": "read:n3-conectores-04-01", "question": "この人の姉は今、何をしていますか。", "correct": "スーパーで働いている", "distractors": ["家を建てている", "ケーキ屋で働いている", "学校で先生をしている"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-05-01", "level": "n3", "reading": "read:n3-conectores-05-01", "question": "学校では勉強のほかに何を学ぶことができると言っていますか。", "correct": "マナーや規則", "distractors": ["山の登り方", "車の運転", "外国の文化"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-05-02", "level": "n3", "reading": "read:n3-conectores-05-02", "question": "父はいつアメリカへ出発しますか。", "correct": "次の木曜日", "distractors": ["明日の朝", "今日の午後", "来週の月曜日"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-06-01", "level": "n3", "reading": "read:n3-conectores-06-01", "question": "この人は相手に何をお願いしていますか。", "correct": "地図をファックスで送ること", "distractors": ["書類を手紙で送ること", "写真をメールで送ること", "社長に電話をかけること"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-06-02", "level": "n3", "reading": "read:n3-conectores-06-02", "question": "この人に運転の仕方を教えたのはだれですか。", "correct": "両親", "distractors": ["学校の先生", "店の人", "友だち"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-07-01", "level": "n3", "reading": "read:n3-conectores-07-01", "question": "ゲームはどうだったと言っていますか。", "correct": "全部つまらなかった", "distractors": ["全部おもしろかった", "一つだけおもしろかった", "高くて買えなかった"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-07-02", "level": "n3", "reading": "read:n3-conectores-07-02", "question": "この人は何が上手になったと言っていますか。", "correct": "日本語を書くこと", "distractors": ["フランス語を話すこと", "料理を作ること", "日本語を読むこと"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-08-01", "level": "n3", "reading": "read:n3-conectores-08-01", "question": "この人は天気がどうなると思っていますか。", "correct": "雨になりそうだ", "distractors": ["晴れになりそうだ", "雪になりそうだ", "台風が来そうだ"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conectores-08-02", "level": "n3", "reading": "read:n3-conectores-08-02", "question": "マイクについて、正しいものはどれですか。", "correct": "上手に日本語が話せる", "distractors": ["日本語が全然話せない", "日本語を教えている", "日本に住んだことがない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conjectura-01-01", "level": "n3", "reading": "read:n3-conjectura-01-01", "question": "この人の今の気持ちと合っているものはどれですか。", "correct": "早く週末になってほしい", "distractors": ["週末が来るのがいやだ", "トムには来てほしくない", "天気は絶対に大丈夫だと思っている"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conjectura-02-01", "level": "n3", "reading": "read:n3-conjectura-02-01", "question": "事件について、正しいものはどれですか。", "correct": "まだ終わっていない", "distractors": ["もう終わった", "昨日始まった", "だれも知らない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conjectura-03-01", "level": "n3", "reading": "read:n3-conjectura-03-01", "question": "外の様子について、何と言っていますか。", "correct": "まるで夏のようだ", "distractors": ["秋らしくて涼しい", "冬のように寒い", "雨が降りそうだ"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conjectura-04-01", "level": "n3", "reading": "read:n3-conjectura-04-01", "question": "考えるふりをしている人は、本当はどうですか。", "correct": "何も思いつかない", "distractors": ["いい考えがたくさんある", "何でもよく知っている", "本気で考えている"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conjectura-05-01", "level": "n3", "reading": "read:n3-conjectura-05-01", "question": "絵を書くことについて、この人はどう思っていますか。", "correct": "楽しくてリラックスできる", "distractors": ["つまらなくて疲れる", "難しくて時間がかかる", "危なくてやりたくない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conjectura-05-02", "level": "n3", "reading": "read:n3-conjectura-05-02", "question": "どうしてコートのボタンをかけるように言いましたか。", "correct": "今日は寒いから", "distractors": ["雨が降っているから", "風邪をひいたから", "海へ行くから"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conjectura-06-01", "level": "n3", "reading": "read:n3-conjectura-06-01", "question": "会議に出席するのは何人ですか。", "correct": "３６人", "distractors": ["１８人", "１９人", "６３人"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conjectura-06-02", "level": "n3", "reading": "read:n3-conjectura-06-02", "question": "この人は医者に何と言われましたか。", "correct": "食べすぎないように", "distractors": ["もっと食べるように", "早く寝るように", "薬を飲むように"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conjectura-07-01", "level": "n3", "reading": "read:n3-conjectura-07-01", "question": "この人は何を取りに戻りますか。", "correct": "かばん", "distractors": ["薬", "ラジオ", "スキーの道具"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-conjectura-07-02", "level": "n3", "reading": "read:n3-conjectura-07-02", "question": "ガソリンの値段はどうなっていると言っていますか。", "correct": "だんだん高くなっている", "distractors": ["だんだん安くなっている", "全然変わらない", "急に下がった"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-desejos-01-01", "level": "n3", "reading": "read:n3-desejos-01-01", "question": "この人が父にしてほしいことは何ですか。", "correct": "映画を見てくれること", "distractors": ["早く元気になること", "いっしょに旅行に行くこと", "本を読むこと"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-desejos-02-01", "level": "n3", "reading": "read:n3-desejos-02-01", "question": "この人は生まれ変わったら何になりたいと言っていますか。", "correct": "鳥になりたい", "distractors": ["先生になりたい", "魚になりたい", "花になりたい"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-desejos-03-01", "level": "n3", "reading": "read:n3-desejos-03-01", "question": "「行かない」と言った人は、どうして行かないのですか。", "correct": "行く気がないから", "distractors": ["試験に落ちたから", "電話が来なかったから", "時間がないから"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-desejos-04-01", "level": "n3", "reading": "read:n3-desejos-04-01", "question": "この人が「続ければよかった」と思っているものは何ですか。", "correct": "バレエ", "distractors": ["ピアノ", "水泳", "テニス"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-desejos-05-01", "level": "n3", "reading": "read:n3-desejos-05-01", "question": "サービスの利用について、正しいものはどれですか。", "correct": "全部ただで使える", "distractors": ["半分だけ無料だ", "お金を払わなければならない", "特別な人しか使えない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-desejos-05-02", "level": "n3", "reading": "read:n3-desejos-05-02", "question": "レポートについて、正しいものはどれですか。", "correct": "間違いはあるが良いレポートだ", "distractors": ["間違いが一つもない", "間違いが多くてだめだ", "長すぎて良くない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-desejos-06-01", "level": "n3", "reading": "read:n3-desejos-06-01", "question": "「私」はテニスの試合についてどう思っているか。", "correct": "きっと勝てると思っている", "distractors": ["負けるかもしれないと思っている", "試合に出たくないと思っている", "試合はもう終わったと思っている"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-desejos-06-02", "level": "n3", "reading": "read:n3-desejos-06-02", "question": "お金についてどうするように言っているか。", "correct": "安全な所に入れておく", "distractors": ["すぐに全部使う", "近所の人に預ける", "机の上に出しておく"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-desejos-07-01", "level": "n3", "reading": "read:n3-desejos-07-01", "question": "このお金は何のために使うつもりか。", "correct": "夏の旅行のため", "distractors": ["病院に行くため", "今夜の食事のため", "新しい服を買うため"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-desejos-07-02", "level": "n3", "reading": "read:n3-desejos-07-02", "question": "新しい自転車はいくらだったか。", "correct": "五万円", "distractors": ["五千円", "五百円", "五十万円"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-deveres-01-01", "level": "n3", "reading": "read:n3-deveres-01-01", "question": "この人は何語で言ってみると言っているか。", "correct": "英語", "distractors": ["日本語", "フランス語", "中国語"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-deveres-02-01", "level": "n3", "reading": "read:n3-deveres-02-01", "question": "「私」は昨夜、どうするべきだったと思っているか。", "correct": "もっと早く寝ること", "distractors": ["遅くまで起きていること", "友達の家に行くこと", "テレビを見ること"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-deveres-03-01", "level": "n3", "reading": "read:n3-deveres-03-01", "question": "学ぶことについて、この文章の考えと合うものはどれか。", "correct": "年を取っても学べる", "distractors": ["年を取ると学べなくなる", "若い人しか学べない", "年を取ったら学ぶ必要はない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-deveres-04-01", "level": "n3", "reading": "read:n3-deveres-04-01", "question": "運転手はいつここに着いたか。", "correct": "昨日", "distractors": ["今朝", "先週", "まだ着いていない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-deveres-05-01", "level": "n3", "reading": "read:n3-deveres-05-01", "question": "母は何に反対しているか。", "correct": "「私」がアルバイトで働くこと", "distractors": ["「私」が大学をやめること", "「私」がパブへ行くこと", "「私」が買い物をすること"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-deveres-05-02", "level": "n3", "reading": "read:n3-deveres-05-02", "question": "この人は先週、何曜日に行ったか。", "correct": "日曜日", "distractors": ["土曜日", "月曜日", "金曜日"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-deveres-06-01", "level": "n3", "reading": "read:n3-deveres-06-01", "question": "正月について、何と言っているか。", "correct": "家族といる時間が長い", "distractors": ["一人で過ごす時間が長い", "仕事の時間が長い", "買い物の時間が長い"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-deveres-06-02", "level": "n3", "reading": "read:n3-deveres-06-02", "question": "あのスーパーは今月、いつ休みか。", "correct": "水曜日", "distractors": ["月曜日", "土曜日", "日曜日"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-enfase-01-01", "level": "n3", "reading": "read:n3-enfase-01-01", "question": "サポートセンターに電話する前に、何をしたらいいか。", "correct": "先にＦＡＱを読む", "distractors": ["メールを送る", "番組を見る", "店へ行く"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-enfase-02-01", "level": "n3", "reading": "read:n3-enfase-02-01", "question": "彼が話す言葉について、正しいものはどれか。", "correct": "英語もドイツ語も話す", "distractors": ["英語しか話せない", "ドイツ語だけ話す", "どちらも話せない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-enfase-03-01", "level": "n3", "reading": "read:n3-enfase-03-01", "question": "値段について、何と言っているか。", "correct": "少しも高くない", "distractors": ["とても高い", "少しだけ高い", "高すぎて買えない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-enfase-04-01", "level": "n3", "reading": "read:n3-enfase-04-01", "question": "ビルについて、正しいものはどれか。", "correct": "時間どおりに来ることは少ない", "distractors": ["いつも時間どおりに来る", "一度も遅れたことがない", "毎朝だれより早く来る"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-enfase-05-01", "level": "n3", "reading": "read:n3-enfase-05-01", "question": "彼女は何のためにアメリカへ行ったか。", "correct": "医学の勉強のため", "distractors": ["乗馬をするため", "仕事を探すため", "家族に会うため"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-enfase-05-02", "level": "n3", "reading": "read:n3-enfase-05-02", "question": "どうして時間がわからなくなったか。", "correct": "時計が止まったから", "distractors": ["時計をなくしたから", "時計を人にあげたから", "部屋が暗かったから"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-enfase-06-01", "level": "n3", "reading": "read:n3-enfase-06-01", "question": "かわいいカップはだれにもらったか。", "correct": "友達", "distractors": ["近所の人", "姉", "店の人"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-enfase-06-02", "level": "n3", "reading": "read:n3-enfase-06-02", "question": "「私」はだれを知っているか。", "correct": "父とむすこの両方", "distractors": ["父だけ", "むすこだけ", "父の友達だけ"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-enfase-07-01", "level": "n3", "reading": "read:n3-enfase-07-01", "question": "大雨はいつ降り出したか。", "correct": "家を出てすぐ", "distractors": ["家に帰ったとき", "買い物の後", "朝起きる前"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-enfase-07-02", "level": "n3", "reading": "read:n3-enfase-07-02", "question": "ビルはだれを動物園へ連れていったか。", "correct": "弟", "distractors": ["妹", "祖父", "友達"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-estado-01-01", "level": "n3", "reading": "read:n3-estado-01-01", "question": "この人はお昼ご飯をどのぐらい作っているか。", "correct": "毎日作っている", "distractors": ["週末だけ作っている", "時々作っている", "全然作っていない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-estado-02-01", "level": "n3", "reading": "read:n3-estado-02-01", "question": "それはいつまでに仕上げる必要があるか。", "correct": "日曜日まで", "distractors": ["明日まで", "金曜日まで", "来月まで"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-estado-03-01", "level": "n3", "reading": "read:n3-estado-03-01", "question": "外出したとき、ヒーターはどうなっていたか。", "correct": "ついたままだった", "distractors": ["消えていた", "こわれていた", "まだ家になかった"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-estado-04-01", "level": "n3", "reading": "read:n3-estado-04-01", "question": "「私」はどうしていたと言っているか。", "correct": "ずっと立っていた", "distractors": ["ずっと座っていた", "ドアを開けたままにしてい