eeds_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-relato-03-01", "level": "n3", "reading": "read:n3-relato-03-01", "question": "「あなた」が出発するのはいつか。", "correct": "明日", "distractors": ["今日", "あさって", "来週"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-relato-04-01", "level": "n3", "reading": "read:n3-relato-04-01", "question": "彼について、正しいものはどれか。", "correct": "有名だが、いい医者ではない", "distractors": ["有名で、いい医者だ", "あまり知られていない医者だ", "歌手として有名だ"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-relato-04-02", "level": "n3", "reading": "read:n3-relato-04-02", "question": "祖父が亡くなったのはいつか。", "correct": "「私」が生まれてすぐ後", "distractors": ["「私」が生まれる前", "「私」が大人になってから", "「私」が学校に入った時"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-relato-05-01", "level": "n3", "reading": "read:n3-relato-05-01", "question": "この人はどうして苦い薬を飲んだのか。", "correct": "せきがひどかったから", "distractors": ["熱が高かったから", "頭が痛かったから", "けがをしたから"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-relato-05-02", "level": "n3", "reading": "read:n3-relato-05-02", "question": "「私達」に途中で何が起こったか。", "correct": "ガソリンがなくなった", "distractors": ["道をまちがえた", "タイヤがこわれた", "雨が降ってきた"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-relato-06-01", "level": "n3", "reading": "read:n3-relato-06-01", "question": "きのう、デパートで何を買ったか。", "correct": "白い靴", "distractors": ["黒い靴", "白いセーター", "カメラのフィルム"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-relato-06-02", "level": "n3", "reading": "read:n3-relato-06-02", "question": "熱はどのぐらいまで出たか。", "correct": "ほぼ４０度", "distractors": ["３０度ぐらい", "３５度より下", "４５度以上"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-relato-07-01", "level": "n3", "reading": "read:n3-relato-07-01", "question": "父は「私」に何をするように言ったか。", "correct": "車を洗うこと", "distractors": ["ボールを投げること", "タバコをやめること", "お礼を言うこと"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-relato-07-02", "level": "n3", "reading": "read:n3-relato-07-02", "question": "彼女は何をしたか。", "correct": "鳥に食べ物をあげた", "distractors": ["歯医者で歯を見てもらった", "新しいアパートに引っ越した", "火事から逃げた"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-revisao-01-01", "level": "n3", "reading": "read:n3-revisao-01-01", "question": "父が「私」によく言うことは何か。", "correct": "物をかたづけておくこと", "distractors": ["早く寝ること", "もっと勉強すること", "時間をむだにしないこと"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-01-01", "level": "n3", "reading": "read:n3-tempo-01-01", "question": "夜まで何を見ようと言っているか。", "correct": "花火", "distractors": ["月", "映画", "星"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-02-01", "level": "n3", "reading": "read:n3-tempo-02-01", "question": "少女は何と言ったか。", "correct": "そんな人は聞いたことがない", "distractors": ["その人にきのう会った", "その人をよく知っている", "早く手紙を出してほしい"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-03-01", "level": "n3", "reading": "read:n3-tempo-03-01", "question": "バスについて、正しいものはどれか。", "correct": "出発したばかりだ", "distractors": ["まだ出発していない", "もうすぐ出発する", "明日出発する"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-04-01", "level": "n3", "reading": "read:n3-tempo-04-01", "question": "この人は１日にどのぐらい水を飲むか。", "correct": "３リットル以上", "distractors": ["３リットルより少ない", "ちょうど２リットル", "ほとんど飲まない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-04-02", "level": "n3", "reading": "read:n3-tempo-04-02", "question": "その本の地図について、正しいものはどれか。", "correct": "２ページに１回のっている", "distractors": ["全部のページにのっている", "最初のページだけにのっている", "地図はのっていない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-05-01", "level": "n3", "reading": "read:n3-tempo-05-01", "question": "パーティーについて、正しいものはどれか。", "correct": "もうすぐ始まる", "distractors": ["もう終わった", "だいぶ前に始まった", "中止になった"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-05-02", "level": "n3", "reading": "read:n3-tempo-05-02", "question": "「私」は何時に電話をかけなおすつもりか。", "correct": "４時", "distractors": ["２時", "５時", "７時"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-06-01", "level": "n3", "reading": "read:n3-tempo-06-01", "question": "この文章で、してはいけないと言っていることは何か。", "correct": "動物にえさをやること", "distractors": ["図書館で話をすること", "ノートを買うこと", "夜おそくまで話すこと"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-06-02", "level": "n3", "reading": "read:n3-tempo-06-02", "question": "仕事の計画はいつ立てるように言っているか。", "correct": "仕事を始める前", "distractors": ["仕事を始めた後", "仕事が終わってから", "休みの日に"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-07-01", "level": "n3", "reading": "read:n3-tempo-07-01", "question": "父について、正しいものはどれか。", "correct": "家に帰ってきたばかりだ", "distractors": ["家を出たばかりだ", "まだ帰っていない", "朝ごはんを作っている"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-07-02", "level": "n3", "reading": "read:n3-tempo-07-02", "question": "この本とあの本と、どちらがやさしいか。", "correct": "あの本のほうがやさしい", "distractors": ["この本のほうがやさしい", "二つとも同じぐらいだ", "どちらもやさしくない"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-08-01", "level": "n3", "reading": "read:n3-tempo-08-01", "question": "母について、正しいものはどれか。", "correct": "少し前まで病院にいた", "distractors": ["今も入院している", "広いアパートを借りた", "映画を見に行った"], "layer": "C", "needs_review": true, "source": "authored+verified"}, {"id": "rc:n3:n3-tempo-08-02", "level": "n3", "reading": "read:n3-tempo-08-02", "question": "夏休みまで、あとどのくらいあるか。", "correct": "一週間ぐらい", "distractors": ["一か月ぐらい", "二、三日ぐらい", "半年ぐらい"], "layer": "C", "needs_review": true, "source": "authored+verified"}]