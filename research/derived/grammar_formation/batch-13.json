      "slug": "gram:gp-127",
      "variants": [
        {
          "base": "verb",
          "steps": [
            { "base": "verb", "op": "to-dictionary" },
            { "op": "append", "token": "な" }
          ],
          "example": "行くな"
        }
      ],
      "steps_unavailable": "The single variant encodes ONLY the negative imperative (dictionary form + な, 行くな), which is class-independent. The AFFIRMATIVE 命令形 cannot be encoded: the op enum has no to-imperative, and base verb cannot distinguish godan (final -u kana swapped for its -e kana, 行く gives 行け) from ichidan (drop る, add ろ or よ, 食べる gives 食べろ). Any single sequence misfires on the other class, since drop-final-ru + ろ turns the godan 帰る into the ungrammatical 帰ろ instead of 帰れ, and する gives しろ / せよ and 来る gives 来い suppletively.",
      "nuance_tags": ["prohibition"],
      "usage_contexts": ["spoken", "casual-friends", "announcement", "literary"]
    }
