{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://yomineko.dev/design/token_roles.json",
 "title": "token_roles",
 "description": "Closed, versioned enums for the word-by-word explanation items: the CHUNK ROLE (what a chunk does in its clause, assigned by the particle usage that closes it or by position), the TOKEN FUNCTION (what a token does inside its chunk, derived from pos / lemma), the auxiliary sub-functions, and the templates that render the role text. Inflection is NOT redefined here: tokens keep `inflection` (UniDic 活用形, neutral) and predicates reuse the conjugation_form enum of design/unlock_enums.json. Schema + data in one self-validating file; docs in design/token_roles.md.",
 "x-yomineko": {
  "status": "proposal",
  "schema_version": "1.0",
  "date": "2026-09-27",
  "doc": "design/token_roles.md",
  "companion": "design/particle_functions.json",
  "reuses": [
   "design/unlock_enums.json#conjugation_form"
  ]
 },
 "type": "object",
 "required": [
  "schema_version",
  "chunk_roles",
  "token_functions",
  "aux_functions",
  "templates",
  "legacy_pattern_role"
 ],
 "properties": {
  "schema_version": {
   "const": "1.0"
  },
  "chunk_roles": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/chunk_role_record"
   }
  },
  "token_functions": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/token_function_record"
   }
  },
  "aux_functions": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/aux_function_record"
   }
  },
  "templates": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/template_record"
   }
  },
  "legacy_pattern_role": {
   "type": "object",
   "additionalProperties": {
    "anyOf": [
     {
      "$ref": "#/$defs/chunk_role"
     },
     {
      "type": "null"
     }
    ]
   },
   "description": "Today's pattern[].role values -> chunk_role; null = non-committal, resolved by the particle usage."
  }
 },
 "$defs": {
  "locale_text": {
   "type": "object",
   "required": [
    "pt-BR",
    "en"
   ],
   "properties": {
    "pt-BR": {
     "type": "string"
    },
    "en": {
     "type": "string"
    }
   },
   "additionalProperties": {
    "type": "string"
   },
   "description": "Locale-object (design/i18n.md): pt-BR is the learner locale, en the source locale; more locales add keys."
  },
  "level": {
   "type": "string",
   "pattern": "^n[1-9]$",
   "description": "JLPT-style level as DATA (N5..N1 today, open-ended)."
  },
  "chunk_role": {
   "enum": [
    "topic",
    "subject",
    "stative-object",
    "object",
    "recipient",
    "source",
    "goal",
    "path",
    "location",
    "location-action",
    "time",
    "end-point",
    "purpose",
    "result",
    "agent",
    "causee",
    "comitative",
    "means",
    "material",
    "cause",
    "scope",
    "manner",
    "quantity",
    "standard",
    "target",
    "quote",
    "focus",
    "parallel-item",
    "modifier",
    "nominalized-clause",
    "adverbial",
    "predicate",
    "clause-link",
    "connective",
    "interjection",
    "sentence-final",
    "none"
   ]
  },
  "token_function": {
   "enum": [
    "head",
    "noun-modifier",
    "determiner",
    "adnominal-predicate",
    "adverb",
    "predicate-head",
    "subsidiary-verb",
    "auxiliary",
    "particle",
    "prefix",
    "suffix",
    "numeral",
    "conjunction",
    "interjection",
    "punctuation"
   ]
  },
  "aux_function": {
   "enum": [
    "politeness",
    "copula",
    "copula-polite",
    "negation",
    "past",
    "desire",
    "passive-potential",
    "causative",
    "volitional",
    "evidential",
    "obligation",
    "negative-volitional",
    "perfective",
    "comparison"
   ]
  },
  "chunk_role_record": {
   "type": "object",
   "required": [
    "id",
    "ja_term",
    "label",
    "of"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/chunk_role"
    },
    "ja_term": {
     "type": "string"
    },
    "label": {
     "$ref": "#/$defs/locale_text"
    },
    "of": {
     "$ref": "#/$defs/locale_text",
     "description": "Genitive form the role template inserts ('do sujeito')."
    }
   },
   "additionalProperties": false
  },
  "token_function_record": {
   "type": "object",
   "required": [
    "id",
    "rule",
    "label",
    "template"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/token_function"
    },
    "rule": {
     "type": "string"
    },
    "label": {
     "$ref": "#/$defs/locale_text"
    },
    "template": {
     "enum": [
      "tpl.role.of",
      "tpl.role.self",
      "tpl.role.aux",
      "none",
      "particle"
     ]
    }
   },
   "additionalProperties": false
  },
  "aux_function_record": {
   "type": "object",
   "required": [
    "id",
    "lemmas",
    "label",
    "level"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/aux_function"
    },
    "lemmas": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "label": {
     "$ref": "#/$defs/locale_text"
    },
    "level": {
     "$ref": "#/$defs/level"
    }
   },
   "additionalProperties": false
  },
  "template_record": {
   "type": "object",
   "required": [
    "slots",
    "pt-BR",
    "en"
   ],
   "properties": {
    "slots": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "pt-BR": {
     "type": "string"
    },
    "en": {
     "type": "string"
    },
    "doc": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "token_item": {
   "description": "Target shape of the explanation fields of ONE C-mode token after migration. `role` text is RENDERED from function + chunk_role (+ aux_function); `gloss` stays Layer-B text (a meaning cannot be an enum); `note` is the only free prose.",
   "type": "object",
   "required": [
    "position",
    "function",
    "chunk"
   ],
   "properties": {
    "position": {
     "type": "integer",
     "minimum": 0
    },
    "function": {
     "$ref": "#/$defs/token_function"
    },
    "aux_function": {
     "$ref": "#/$defs/aux_function"
    },
    "chunk": {
     "type": "integer",
     "minimum": 0,
     "description": "Index into the sentence's pattern[] chunk list."
    },
    "chunk_role": {
     "$ref": "#/$defs/chunk_role"
    },
    "form": {
     "type": "string",
     "description": "conjugation_form id (design/unlock_enums.json) of the predicate run the token heads, when it heads one."
    },
    "role": {
     "$ref": "#/$defs/locale_text",
     "description": "Rendered, never authored."
    },
    "gloss": {
     "$ref": "#/$defs/locale_text"
    },
    "note": {
     "$ref": "#/$defs/locale_text"
    }
   },
   "additionalProperties": false
  }
 },
