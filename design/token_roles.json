 "token_functions": [
  {
   "id": "head",
   "rule": "last nominal token of a chunk, before the particle that closes it",
   "label": {
    "pt-BR": "núcleo",
    "en": "head"
   },
   "template": "tpl.role.of"
  },
  {
   "id": "noun-modifier",
   "rule": "nominal token before the head inside the same chunk (compound or の-less modifier)",
   "label": {
    "pt-BR": "modificador",
    "en": "modifier"
   },
   "template": "tpl.role.of"
  },
  {
   "id": "determiner",
   "rule": "pos = adnominal (連体詞: この, その, あの, 大きな)",
   "label": {
    "pt-BR": "determinante",
    "en": "determiner"
   },
   "template": "tpl.role.of"
  },
  {
   "id": "adnominal-predicate",
   "rule": "verb/adjective/auxiliary run directly before a nominal (高い山, 読んだ本)",
   "label": {
    "pt-BR": "predicado que modifica o substantivo",
    "en": "noun-modifying predicate"
   },
   "template": "tpl.role.of"
  },
  {
   "id": "adverb",
   "rule": "pos = adverb",
   "label": {
    "pt-BR": "advérbio",
    "en": "adverb"
   },
   "template": "tpl.role.self"
  },
  {
   "id": "predicate-head",
   "rule": "first verb/adjective/na-adjective/noun of the sentence-final predicate run",
   "label": {
    "pt-BR": "predicado principal",
    "en": "main predicate"
   },
   "template": "tpl.role.self"
  },
  {
   "id": "subsidiary-verb",
   "rule": "verb after the conjunctive て/で whose lemma is in lexicon SUBSID (〜ている, 〜てください)",
   "label": {
    "pt-BR": "verbo auxiliar (depois de 〜て)",
    "en": "subsidiary verb"
   },
   "template": "tpl.role.self"
  },
  {
   "id": "auxiliary",
   "rule": "pos = auxiliary; sub-function from AUX_FUNCTION by lemma",
   "label": {
    "pt-BR": "auxiliar",
    "en": "auxiliary"
   },
   "template": "tpl.role.aux"
  },
  {
   "id": "particle",
   "rule": "pos = particle; described by design/particle_functions.json, never by this file",
   "label": {
    "pt-BR": "partícula",
    "en": "particle"
   },
   "template": "particle"
  },
  {
   "id": "prefix",
   "rule": "pos = prefix (お, ご: politeness)",
   "label": {
    "pt-BR": "prefixo",
    "en": "prefix"
   },
   "template": "tpl.role.self"
  },
  {
   "id": "suffix",
   "rule": "pos = suffix (さん, たち, counters)",
   "label": {
    "pt-BR": "sufixo",
    "en": "suffix"
   },
   "template": "tpl.role.self"
  },
  {
   "id": "numeral",
   "rule": "pos_fine = 数詞",
   "label": {
    "pt-BR": "numeral",
    "en": "numeral"
   },
   "template": "tpl.role.of"
  },
  {
   "id": "conjunction",
   "rule": "pos = conjunction",
   "label": {
    "pt-BR": "conjunção",
    "en": "conjunction"
   },
   "template": "tpl.role.self"
  },
  {
   "id": "interjection",
   "rule": "pos = interjection",
   "label": {
    "pt-BR": "interjeição",
    "en": "interjection"
   },
   "template": "tpl.role.self"
  },
  {
   "id": "punctuation",
   "rule": "pos = punctuation / whitespace (never explained)",
   "label": {
    "pt-BR": "pontuação",
    "en": "punctuation"
   },
   "template": "none"
  }
 ],
 "aux_functions": [
  {
