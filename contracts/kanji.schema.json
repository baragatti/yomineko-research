{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yomineko.dev/contracts/kanji.schema.json",
  "title": "kanji",
  "description": "One kanji character: readings, meanings, radical decomposition and the level it is taught at. Layer A apart from the pt-BR meanings.",
  "x-yomineko": {
    "entity": "kanji",
    "records": 2131,
    "packing": "list",
    "glob": "corpus/kanji/*.json",
    "stable_id_field": "slug",
    "generated_by": "scripts/contracts/build_schemas.py from contracts/_shapes.json"
  },
  "type": "object",
  "properties": {
    "character": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "example_sentences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "example_words": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gloss": {
            "$ref": "common.schema.json#/$defs/LocaleTextList"
          },
          "headword": {
            "type": "string"
          },
          "kana": {
            "type": "string"
          },
          "slug": {
            "$ref": "common.schema.json#/$defs/StableId"
          },
          "vocab_id": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "freq_rank": {
      "type": [
        "integer",
        "null"
      ]
    },
    "grade": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6,
        8
      ]
    },
    "id": {
      "type": "integer"
    },
    "irregular_note": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/LocaleText"
        },
        {
          "type": "null"
        }
      ]
    },
    "kangxi_radical": {
      "type": "integer"
    },
    "kanjivg_ref": {
      "type": "string"
    },
    "level": {
      "$ref": "common.schema.json#/$defs/Level"
    },
    "level_agreement": {
      "$ref": "common.schema.json#/$defs/LevelTag/properties/level_agreement"
    },
    "level_confidence": {
      "$ref": "common.schema.json#/$defs/LevelTag/properties/level_confidence"
    },
    "level_sources": {
      "type": "object",
      "properties": {
        "anchor": {
          "type": "string",
          "enum": [
            "jlpt_anchor:n4",
            "jlpt_anchor:n5",
            "jlpt_anchor:not-in-n5n4"
          ]
        },
        "anchori": {
          "type": "string",
          "enum": [
            "n1",
            "n2",
            "n4",
            "n5"
          ]
        },
        "bluskyo": {
          "type": "string",
          "enum": [
            "n1",
            "n2",
            "n3",
            "n4",
            "n5"
          ]
        },
        "davidluzgouveia": {
          "type": "string",
          "enum": [
            "n1",
            "n2",
            "n3",
            "n4",
            "n5"
          ]
        },
        "kanjiapi": {
          "type": "string",
          "enum": [
            "n1",
            "n2",
            "n3",
            "n4",
            "n5"
          ]
        },
        "lists": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "author-added: usado por vocabulário N4; fora das listas de consenso"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "meanings": {
      "$ref": "common.schema.json#/$defs/LocaleTextList"
    },
    "notes": {
      "type": "null"
    },
    "radical_char": {
      "type": "string"
    },
    "readings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "common": {
            "type": "boolean"
          },
          "example_vocab_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer"
            }
          },
          "introduced_at_level": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "n4",
              "n5",
              null
            ]
          },
          "note": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/LocaleText"
              },
              {
                "type": "null"
              }
            ]
