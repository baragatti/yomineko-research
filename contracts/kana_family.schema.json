{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yomineko.dev/contracts/kana_family.schema.json",
  "title": "kana_family",
  "description": "The kana chart as ordered groups. Keyed by script, so unlike the capability map its keys are a fixed enum rather than stable IDs — which is why the two map-packed files cannot share one generated shape. The script is not just a label: every id under `hiragana` must be a hiragana id, and the per-script patternProperties below are what ties the two together, so a katakana glyph filed under the wrong script fails instead of validating.",
  "x-yomineko": {
    "entity": "kana_family",
    "packing": "map",
    "glob": "corpus/kana/families.json",
    "key_namespace": null,
    "stable_id_field": null,
    "declares": ["*[].id"],
    "note": "The GROUP ids (kana:hiragana-a) are declared here and nowhere else. The MEMBER ids are not: every one of them is a record in corpus/kana/, so members[].id is a reference the graph check resolves."
  },
  "type": "object",
  "propertyNames": { "enum": ["hiragana", "katakana"] },
  "required": ["hiragana", "katakana"],
  "patternProperties": {
    "^hiragana$": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/group" },
          {
            "properties": {
              "id": { "pattern": "^kana:hiragana-" },
              "members": { "items": { "properties": { "id": { "pattern": "^kana:hiragana-" } } } }
            }
          }
        ]
      }
    },
    "^katakana$": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/group" },
          {
            "properties": {
              "id": { "pattern": "^kana:katakana-" },
              "members": { "items": { "properties": { "id": { "pattern": "^kana:katakana-" } } } }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false,

  "$defs": {
    "group": {
      "type": "object",
      "description": "One row of the chart — か行, the dakuten row, the yoon set — in teaching order.",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/StableId", "pattern": "^kana:" },
        "label": { "$ref": "common.schema.json#/$defs/LocaleText" },
        "row": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["base", "dakuten", "handakuten", "long-vowel", "sokuon", "yoon"],
          "description": "How the group relates to the base chart. Neutral English per design/i18n.md — the pt-BR label lives in `label`."
        },
        "order": { "type": "integer", "minimum": 1, "description": "Teaching order within the script." },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/StableId", "pattern": "^kana:" },
              "char": { "type": "string", "minLength": 1 },
              "romaji": { "type": "string", "minLength": 1 }
            },
            "required": ["id", "char", "romaji"],
            "additionalProperties": false
          }
        }
      },
      "required": ["id", "label", "row", "type", "order", "members"],
      "additionalProperties": false
    }
  }
}
