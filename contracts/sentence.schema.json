{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yomineko.dev/contracts/sentence.schema.json",
  "title": "sentence",
  "description": "One fully dissected example sentence — the unit the whole corpus is built on. A sentence lives here ONCE and everything else references it by id.",
  "x-yomineko": {
    "entity": "sentence",
    "records": 5889,
    "packing": "list",
    "glob": "corpus/sentences/bank.json",
    "stable_id_field": "slug",
    "generated_by": "scripts/contracts/build_schemas.py from contracts/_shapes.json",
    "vocabulary_policy": "Types, nesting and `required` are measured from the data. Value sets are not: every `enum` here is either declared in a design document, parsed from the code that produces the value, or curated in build_schemas.py with its source named in x-vocabulary. See contracts/README.md."
  },
  "type": "object",
  "properties": {
    "clause_structure": {
      "anyOf": [
        {
          "type": "string",
          "description": "Coarse clause shape of the sentence. No declared taxonomy."
        },
        {
          "type": "null"
        }
      ]
    },
    "grammar": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "jp": {
      "type": "string"
    },
    "kana": {
      "type": "string"
    },
    "level": {
      "$ref": "common.schema.json#/$defs/Level"
    },
    "new_items": {
      "type": "array"
    },
    "particles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "explanation": {
            "$ref": "common.schema.json#/$defs/LocaleText"
          },
          "function": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/LocaleText"
              },
              {
                "type": "null"
              }
            ]
          },
          "function_type": {
            "type": "string",
            "enum": [
              "adverbial",
              "binding",
              "case",
              "conjunctive",
              "nominalizer",
              "parallel",
              "sentence-final"
            ],
            "description": "Standard joshi classification for this particle. Vocabulary owner: producer — scripts/ingest/dissect.py PARTICLE_FUNCTION_MAP (Sudachi 助詞 subtype). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
            "x-vocabulary": {
              "owner": "producer",
              "source": "scripts/ingest/dissect.py PARTICLE_FUNCTION_MAP (Sudachi 助詞 subtype)"
            }
          },
          "particle": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "pattern": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "chunk": {
            "type": "string"
          },
          "particle": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "Slot role inside the sentence pattern, as the pattern builder labelled it. No declared taxonomy; scripts/export/build_role_exercises.py consumes only the subset it can ask about."
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "ai_generated": {
          "$ref": "common.schema.json#/$defs/Provenance/properties/ai_generated"
        },
        "jp_source": {
          "type": "string"
        },
        "locale": {
          "$ref": "common.schema.json#/$defs/Locale"
        },
        "needs_review": {
          "$ref": "common.schema.json#/$defs/Provenance/properties/needs_review"
        },
        "pt_source": {
          "type": "string",
          "enum": [
            "ai",
            "human",
            "tatoeba"
          ],
          "description": "Where the pt-BR translation came from. Selection beats generation (spec §1.2). Vocabulary owner: design — design/schema_v2.md (the `sentence` table, pt_source). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
          "x-vocabulary": {
            "owner": "design",
            "source": "design/schema_v2.md (the `sentence` table, pt_source)"
          }
        },
        "pt_validated_against": {
          "type": "string",
          "enum": [
            "both",
            "dict",
            "en",
            "none"
          ],
          "description": "What the Layer-B translation was machine-checked against. Vocabulary owner: design — design/schema_v2.md (the `sentence` table, pt_validated_against). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
          "x-vocabulary": {
            "owner": "design",
            "source": "design/schema_v2.md (the `sentence` table, pt_validated_against)"
          }
        },
        "tier": {
          "type": "string",
          "description": "Dissection tier this sentence was processed at."
        },
        "translation_confidence": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "ai_generated",
        "jp_source",
        "locale",
        "needs_review",
        "pt_source",
        "pt_validated_against",
        "tier",
        "translation_confidence"
      ],
      "additionalProperties": false
    },
    "romaji": {
      "type": "string"
    },
    "slug": {
      "$ref": "common.schema.json#/$defs/StableId"
    },
    "structure_explanation": {
      "$ref": "common.schema.json#/$defs/LocaleText"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conjugation_note": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/LocaleText"
              },
              {
                "type": "null"
              }
            ]
          },
          "gloss": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/LocaleText"
              },
              {
                "type": "null"
              }
            ]
          },
          "inflection": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "attributive",
                  "conditional",
                  "continuative",
                  "imperative",
                  "irrealis",
                  "ku-form",
                  "stem",
                  "terminal",
                  "volitional"
                ],
                "description": "Inflected form of this token, Layer A. Vocabulary owner: producer — scripts/ingest/dissect.py INFLECTION_MAP (Sudachi 活用形). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
                "x-vocabulary": {
                  "owner": "producer",
                  "source": "scripts/ingest/dissect.py INFLECTION_MAP (Sudachi 活用形)"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "inflection_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "lemma": {
            "type": "string"
          },
          "pos": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "adnominal",
                  "adverb",
                  "auxiliary",
                  "conjunction",
                  "filler",
                  "i-adjective",
                  "interjection",
                  "na-adjective",
                  "noun",
                  "numeral",
                  "particle",
                  "prefix",
                  "pronoun",
                  "punctuation",
                  "suffix",
                  "symbol",
                  "verb",
                  "whitespace"
                ],
                "description": "Part of speech, Layer A, mechanical from the analyzer. Vocabulary owner: producer — scripts/ingest/dissect.py POS_MAP (Sudachi/UniDic 品詞 → neutral enum). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
                "x-vocabulary": {
                  "owner": "producer",
                  "source": "scripts/ingest/dissect.py POS_MAP (Sudachi/UniDic 品詞 → neutral enum)"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "pos_coarse": {
            "type": "string",
            "description": "Raw Sudachi/UniDic 品詞 大分類, kept verbatim for traceability. Third-party analyzer output: the project does not own this vocabulary and must not constrain it (design/schema_v2.md §B makes token analyzer output immutable)."
          },
          "pos_fine": {
            "type": "string",
            "description": "Raw Sudachi/UniDic 品詞 細分類, kept verbatim. Third-party analyzer output, see pos_coarse."
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "reading": {
            "type": "string"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/LocaleText"
              },
              {
                "type": "null"
              }
            ]
          },
          "romaji": {
            "type": [
              "string",
              "null"
            ]
          },
          "split_mode": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ],
            "description": "Which Sudachi split mode produced this token. Vocabulary owner: producer — SudachiPy split modes (A short / B middle / C long). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
            "x-vocabulary": {
              "owner": "producer",
              "source": "SudachiPy split modes (A short / B middle / C long)"
            }
          },
          "surface": {
            "type": "string"
          },
          "vocab": {
            "type": [
              "string",
              "null"
            ]
          },
          "vocab_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "translation": {
      "$ref": "common.schema.json#/$defs/LocaleText"
    },
    "translation_literal": {
      "$ref": "common.schema.json#/$defs/LocaleText"
    }
  },
  "additionalProperties": false,
  "required": [
    "clause_structure",
    "grammar",
    "jp",
    "kana",
    "level",
    "new_items",
    "particles",
    "pattern",
    "provenance",
    "romaji",
    "slug",
    "structure_explanation",
    "tags",
    "tokens",
    "translation",
    "translation_literal"
  ]
}
