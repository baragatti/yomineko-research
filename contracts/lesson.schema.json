{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yomineko.dev/contracts/lesson.schema.json",
  "title": "lesson",
  "description": "The leaf unit a learner sits down to. Holds objectives, explanation, exercises and the items it introduces — all corpus content by REFERENCE, never embedded.",
  "x-yomineko": {
    "entity": "lesson",
    "records": 322,
    "packing": "single",
    "glob": "course/*/topic-*/lesson-*.json",
    "stable_id_field": "id",
    "generated_by": "scripts/contracts/build_schemas.py from contracts/_shapes.json",
    "vocabulary_policy": "Types, nesting and `required` are measured from the data. Value sets are not: every `enum` here is either declared in a design document, parsed from the code that produces the value, or curated in build_schemas.py with its source named in x-vocabulary. See contracts/README.md."
  },
  "type": "object",
  "properties": {
    "body": {
      "type": "string"
    },
    "cumulative_known_set": {
      "type": "object",
      "properties": {
        "conjugation-form": {
          "type": "array"
        },
        "grammar": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kana-family": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kanji": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phrase": {
          "type": "array"
        },
        "vocab": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "conjugation-form",
        "grammar",
        "kana-family",
        "kanji",
        "phrase",
        "vocab"
      ],
      "additionalProperties": false
    },
    "description": {
      "$ref": "common.schema.json#/$defs/LocaleText"
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "object",
            "properties": {
              "accept": {
                "type": "array"
              },
              "choices": {
                "type": "array"
              },
              "correct": {
                "type": "string"
              },
              "full": {
                "type": "string"
              },
              "order": {
                "type": "array"
              },
              "pairs": {
                "type": "array"
              },
              "sentence_refs": {
                "type": "array"
              },
              "text": {
                "type": "string"
              }
            }
          },
          "explanation": {
            "$ref": "common.schema.json#/$defs/LocaleText"
          },
          "id": {
            "$ref": "common.schema.json#/$defs/StableId"
          },
          "prompt": {
            "$ref": "common.schema.json#/$defs/LocaleText"
          },
          "sentence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "cloze",
              "handwriting",
              "listening",
              "matching",
              "ordering",
              "particle_choice",
              "production",
              "reading",
              "recognition",
              "sentence_build"
            ],
            "description": "What kind of exercise this is. Vocabulary owner: design — design/lesson_schema.md ('Exercise records', the ten `type` values). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
            "x-vocabulary": {
              "owner": "design",
              "source": "design/lesson_schema.md ('Exercise records', the ten `type` values)"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "feature_unlocks": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "feat:conjugation-drill",
          "feat:find-correct-kanji",
          "feat:find-correct-particle",
          "feat:furigana-toggle",
          "feat:handwriting-input",
          "feat:jlpt-sim-n4",
          "feat:jlpt-sim-n5",
          "feat:kana-input",
          "feat:kanji-lookup",
          "feat:listening",
          "feat:particle-drill",
          "feat:phrase-builder",
          "feat:romaji-toggle",
          "feat:srs-reviews",
          "feat:visual-novel",
          "feat:voice-mode"
        ],
        "description": "An app feature this lesson turns on. Vocabulary owner: design — design/unlock_enums.json#feature. Widening it is an edit there, never a side effect of regenerating this schema from the data.",
        "x-vocabulary": {
          "owner": "design",
          "source": "design/unlock_enums.json#feature"
        }
      }
    },
    "id": {
      "$ref": "common.schema.json#/$defs/StableId"
    },
    "level": {
