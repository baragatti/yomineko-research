    },
    "needs": {
      "type": "array"
    },
    "needs_review": {
      "$ref": "common.schema.json#/$defs/Provenance/properties/needs_review"
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/LocaleText"
      }
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "review_status": {
      "type": "array",
      "description": "Human review verdicts that are still LIVE for this record: each one's content hash still matches the text it approved. Written by the exporter from research/derived/review_ledger.json, never by hand — an entry whose text was rewritten afterwards is stale and exports nothing, and a review_status the ledger does not justify is a hard failure (scripts/validate/validate_review_ledger.py). Absent on a record nobody has reviewed, which is why it is never required. See design/review_ledger.md.",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "description": "The reviewed field, or \"*\" for the whole record."
          },
          "locale": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/Locale"
              },
              {
                "type": "null"
              }
            ],
            "description": "The locale reviewed; null for a locale-agnostic verdict."
          },
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ],
            "description": "The verdict a named reviewer recorded. Vocabulary owner: design — design/review_ledger.md. Widening it is an edit there, never a side effect of regenerating this schema from the data.",
            "x-vocabulary": {
              "owner": "design",
              "source": "design/review_ledger.md"
            }
          },
          "reviewed_by": {
            "type": "string",
            "minLength": 1,
            "description": "Who reviewed it. An anonymous approval is not a review, and the correction-rate metric is per person."
          },
          "approved_at": {
            "type": "string",
            "minLength": 1,
            "description": "When. Provenance and ordering only — approvals do not expire (APP_PLAN D4): a rewrite invalidates them, the calendar does not."
          },
          "content_hash": {
            "type": "string",
            "pattern": "^(sha256:)?[0-9a-fA-F]{8,64}$",
            "description": "The sha256 of exactly what was reviewed, so a reader can tell WHICH text was approved without the ledger."
          }
        },
        "required": [
          "field",
          "status",
          "reviewed_by",
          "approved_at",
          "content_hash"
        ],
        "additionalProperties": false
      }
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "MAJOR.MINOR of the record format. A version field exists to be bumped; an enum over the current value means it never can be."
    },
    "sentence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "srs": {
      "type": "object",
      "properties": {
        "introduces_cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "card_types": {
                "type": "array"
              },
              "deck": {
                "type": "string",
                "enum": [
                  "deck:grammar-n3",
                  "deck:grammar-n4",
                  "deck:grammar-n5",
                  "deck:kana-hiragana",
                  "deck:kana-katakana",
                  "deck:kanji-n3",
                  "deck:kanji-n4",
                  "deck:kanji-n5",
                  "deck:phrases",
                  "deck:vocab-n3",
                  "deck:vocab-n4",
                  "deck:vocab-n5"
                ],
                "description": "The SRS deck these cards land in. Vocabulary owner: design — design/unlock_enums.json#deck. Widening it is an edit there, never a side effect of regenerating this schema from the data.",
                "x-vocabulary": {
                  "owner": "design",
                  "source": "design/unlock_enums.json#deck"
                }
              },
              "item": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "introduces_cards"
      ],
      "additionalProperties": false
    },
    "title": {
      "$ref": "common.schema.json#/$defs/LocaleText"
    },
    "topic": {
      "type": "string"
    },
    "unlocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "conjugation-form",
              "feature",
              "grammar",
              "kana-family",
              "kanji",
              "kanji-family",
              "phrase",
              "srs-deck",
              "vocab"
            ],
            "description": "What kind of item this lesson makes available. Vocabulary owner: design — design/unlock_enums.json#unlock_type. Widening it is an edit there, never a side effect of regenerating this schema from the data.",
            "x-vocabulary": {
              "owner": "design",
              "source": "design/unlock_enums.json#unlock_type"
            }
          }
