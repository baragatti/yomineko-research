{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yomineko.dev/contracts/vocab.schema.json",
  "title": "vocab",
  "description": "One dictionary word, keyed by its JMdict entry. Carries senses, pitch, inflection class and the consensus level.",
  "x-yomineko": {
    "entity": "vocab",
    "records": 7401,
    "packing": "list",
    "glob": "corpus/vocab/*.json",
    "stable_id_field": "slug",
    "generated_by": "scripts/contracts/build_schemas.py from contracts/_shapes.json",
    "vocabulary_policy": "Types, nesting and `required` are measured from the data. Value sets are not: every `enum` here is either declared in a design document, parsed from the code that produces the value, or curated in build_schemas.py with its source named in x-vocabulary. See contracts/README.md."
  },
  "type": "object",
  "properties": {
    "adj_class": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "i_adj",
            "na_adj"
          ],
          "description": "Adjective class, null for anything that is not an adjective. Vocabulary owner: design — design/schema_v2.md (the `vocab` table, adj_class). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
          "x-vocabulary": {
            "owner": "design",
            "source": "design/schema_v2.md (the `vocab` table, adj_class)"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "common": {
      "type": "boolean"
    },
    "families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "form": {
            "type": "string"
          },
          "is_common": {
            "type": "boolean"
          },
          "is_kana": {
            "type": "boolean"
          },
          "is_primary": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "headword": {
      "type": "string"
    },
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "jmdict_ref": {
      "type": "string"
    },
    "kana": {
      "type": "string"
    },
    "kanji": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "level": {
      "$ref": "common.schema.json#/$defs/Level"
    },
    "level_agreement": {
      "$ref": "common.schema.json#/$defs/LevelTag/properties/level_agreement"
    },
    "level_confidence": {
      "$ref": "common.schema.json#/$defs/LevelTag/properties/level_confidence"
    },
    "level_sources": {
      "$ref": "common.schema.json#/$defs/LevelTag/properties/level_sources"
    },
    "lexeme_type": {
      "type": "string",
      "enum": [
        "aux",
        "counter",
        "expression",
        "prefix",
        "suffix",
        "suru_verb",
        "word"
      ],
      "description": "What kind of lexical item this entry is. Vocabulary owner: design — design/schema_v2.md (the `vocab` table, lexeme_type). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
      "x-vocabulary": {
        "owner": "design",
        "source": "design/schema_v2.md (the `vocab` table, lexeme_type)"
      }
    },
    "notes": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/LocaleText"
        },
        {
          "type": "null"
        }
      ]
    },
    "pitch": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accent_positions": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "reading": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "register": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "enum": [
          "archaic",
          "colloquial",
          "familiar",
          "honorific",
          "humble",
          "polite",
          "slang",
          "vulgar"
        ],
        "description": "Register tags for this word or sense. Vocabulary owner: design — design/schema_v2.md ('Vocab': the neutral register enum from JMdict misc). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
        "x-vocabulary": {
          "owner": "design",
          "source": "design/schema_v2.md ('Vocab': the neutral register enum from JMdict misc)"
        }
      }
    },
    "romaji": {
      "type": "string"
    },
    "senses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "array"
          },
          "gloss": {
            "$ref": "common.schema.json#/$defs/LocaleTextList"
          },
          "misc": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "JMdict misc tags for this sense, verbatim (`uk`, `hum`, `col`, …). JMdict owns roughly eighty of them and adds more; this corpus carries whichever the entry had."
            }
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "register": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "enum": [
                "archaic",
                "colloquial",
                "familiar",
                "honorific",
                "humble",
                "polite",
                "slang",
                "vulgar"
              ],
              "description": "Register tags for this word or sense. Vocabulary owner: design — design/schema_v2.md ('Vocab': the neutral register enum from JMdict misc). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
              "x-vocabulary": {
                "owner": "design",
                "source": "design/schema_v2.md ('Vocab': the neutral register enum from JMdict misc)"
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "slug": {
      "$ref": "common.schema.json#/$defs/StableId"
    },
    "verb_class": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "godan",
            "ichidan",
            "kuru_irregular",
            "suru_irregular"
          ],
          "description": "Inflection class, null for anything that is not a verb. Vocabulary owner: design — design/schema_v2.md (the `vocab` table, verb_class). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
          "x-vocabulary": {
            "owner": "design",
            "source": "design/schema_v2.md (the `vocab` table, verb_class)"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "adj_class",
    "common",
    "families",
    "forms",
    "headword",
    "id",
    "jmdict_ref",
    "kana",
    "kanji",
    "level",
    "level_agreement",
    "level_confidence",
    "level_sources",
    "lexeme_type",
    "notes",
    "pitch",
    "register",
    "romaji",
    "senses",
    "slug",
    "verb_class"
  ]
}
