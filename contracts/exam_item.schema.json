{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yomineko.dev/contracts/exam_item.schema.json",
  "title": "exam_item",
  "description": "One JLPT-style practice question, drawn from the corpus so every item is also findable in a lesson.",
  "x-yomineko": {
    "entity": "exam_item",
    "records": 6166,
    "packing": "list",
    "glob": "corpus/exam_banks/*.json",
    "stable_id_field": "id",
    "generated_by": "scripts/contracts/build_schemas.py from contracts/_shapes.json"
  },
  "type": "object",
  "properties": {
    "ai_generated": {
      "$ref": "common.schema.json#/$defs/Provenance/properties/ai_generated"
    },
    "answer": {
      "type": "string"
    },
    "audio": {
      "type": "string",
      "enum": [
        "pending"
      ]
    },
    "correct": {
      "type": "string"
    },
    "distractors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grammar": {
      "type": "string"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/StableId"
    },
    "layer": {
      "$ref": "common.schema.json#/$defs/Layer"
    },
    "level": {
      "$ref": "common.schema.json#/$defs/Level"
    },
    "needs_review": {
      "$ref": "common.schema.json#/$defs/Provenance/properties/needs_review"
    },
    "pieces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "question": {
      "type": "string"
    },
    "reading": {
      "type": "string"
    },
    "script": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker": {
            "type": "string",
            "enum": [
              "F1",
              "F2",
              "M1",
              "M2",
              "N"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "sentence": {
      "type": "string"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/Provenance/properties/source"
    },
    "stem": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "vocab_id": {
      "type": "integer"
    },
    "wrong": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "level"
  ]
}
