{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yomineko.dev/contracts/topic.schema.json",
  "title": "topic",
  "description": "A block of lessons that closes one theme, and the items it unlocks.",
  "x-yomineko": {
    "entity": "topic",
    "records": 52,
    "packing": "single",
    "glob": "course/*/topic-*/topic.json",
    "stable_id_field": "id",
    "generated_by": "scripts/contracts/build_schemas.py from contracts/_shapes.json",
    "vocabulary_policy": "Types, nesting and `required` are measured from the data. Value sets are not: every `enum` here is either declared in a design document, parsed from the code that produces the value, or curated in build_schemas.py with its source named in x-vocabulary. See contracts/README.md."
  },
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/StableId"
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "$ref": "common.schema.json#/$defs/LocaleText"
          },
          "id": {
            "$ref": "common.schema.json#/$defs/StableId"
          },
          "needs": {
            "type": "array"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
            "description": "A repository-relative path to the referenced file."
          },
          "title": {
            "$ref": "common.schema.json#/$defs/LocaleText"
          },
          "unlocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "conjugation-form",
                    "feature",
                    "grammar",
                    "kana-family",
                    "kanji",
                    "kanji-family",
                    "phrase",
                    "srs-deck",
                    "vocab"
                  ],
                  "description": "What kind of item this lesson makes available. Vocabulary owner: design — design/unlock_enums.json#unlock_type. Widening it is an edit there, never a side effect of regenerating this schema from the data.",
                  "x-vocabulary": {
                    "owner": "design",
                    "source": "design/unlock_enums.json#unlock_type"
                  }
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "level": {
      "$ref": "common.schema.json#/$defs/Level"
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/LocaleText"
      }
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "theme": {
      "type": "string",
      "description": "Free thematic label for the topic. No declared taxonomy."
    },
    "title": {
      "$ref": "common.schema.json#/$defs/LocaleText"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "lessons",
    "level",
    "objectives",
    "order",
    "theme",
    "title"
  ]
}
