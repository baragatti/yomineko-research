{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yomineko.dev/contracts/speak_unit.schema.json",
  "title": "speak_unit",
  "description": "One unit of the speaking path: phrases, drills and a checkpoint for a single situation.",
  "x-yomineko": {
    "entity": "speak_unit",
    "records": 72,
    "packing": "single",
    "glob": "course/speak/*/unit-*.json",
    "stable_id_field": "id",
    "generated_by": "scripts/contracts/build_schemas.py from contracts/_shapes.json",
    "vocabulary_policy": "Types, nesting and `required` are measured from the data. Value sets are not: every `enum` here is either declared in a design document, parsed from the code that produces the value, or curated in build_schemas.py with its source named in x-vocabulary. See contracts/README.md."
  },
  "type": "object",
  "properties": {
    "audio": {
      "type": "string",
      "pattern": "^(pending|[A-Za-z0-9_./-]+\\.(mp3|m4a|ogg|wav|opus))$",
      "description": "The audio asset, or the literal `pending` while the TTS pipeline (design/listening.md) has not produced it yet. The first real filename must not fail the build."
    },
    "checkpoint": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "distractors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "id": {
            "$ref": "common.schema.json#/$defs/StableId"
          },
          "type": {
            "type": "string",
            "enum": [
              "context_fill",
              "grammar_form",
              "kanji_reading",
              "orthography",
              "paraphrase",
              "reading_comp",
              "sentence_order",
              "text_grammar",
              "usage"
            ],
            "description": "Which exam section this item is drawn from. Vocabulary owner: design — design/exam_simulator.md (the written-section table). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
            "x-vocabulary": {
              "owner": "design",
              "source": "design/exam_simulator.md (the written-section table)"
            }
          },
          "via": {
            "type": "string",
            "enum": [
              "new-word",
              "phrase",
              "review"
            ],
            "description": "Why this checkpoint item is in this unit. Vocabulary owner: producer — scripts/export/build_speaking_checkpoints.py (how the item was selected for this unit). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
            "x-vocabulary": {
              "owner": "producer",
              "source": "scripts/export/build_speaking_checkpoints.py (how the item was selected for this unit)"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "chunk_phrases": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/IdRef"
      }
    },
    "cumulative_known_vocab": {
      "type": "integer",
      "minimum": 0
    },
    "drills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pattern": {
            "type": "string"
          },
          "strand": {
            "type": "string",
            "enum": [
              "fluency",
              "language-focused",
              "meaning-input",
              "meaning-output"
            ],
            "description": "Which of the four strands this component trains. Vocabulary owner: design — design/learning_science.md R77 (Nation's four strands). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
            "x-vocabulary": {
              "owner": "design",
              "source": "design/learning_science.md R77 (Nation's four strands)"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "fluency": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "recap",
            "situation"
          ],
          "x-vocabulary": {
            "owner": "measured",
            "source": "contracts/_shapes.json — no design document or producer owns this field, and the observed set is small, closed and free of prose, ids and paths."
          }
        },
        "prompt_pt": {
          "type": "string"
        },
        "seconds_target": {
          "type": "integer",
          "minimum": 0
        },
        "strand": {
          "type": "string",
          "enum": [
            "fluency",
            "language-focused",
            "meaning-input",
            "meaning-output"
          ],
          "description": "Which of the four strands this component trains. Vocabulary owner: design — design/learning_science.md R77 (Nation's four strands). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
          "x-vocabulary": {
            "owner": "design",
            "source": "design/learning_science.md R77 (Nation's four strands)"
          }
        },
        "zero_new_tokens": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "id": {
      "$ref": "common.schema.json#/$defs/StableId"
    },
    "kanji_recognition": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layer": {
      "$ref": "common.schema.json#/$defs/Layer"
    },
    "needs_review": {
      "$ref": "common.schema.json#/$defs/Provenance/properties/needs_review"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "patterns_chunked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "production": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accepted_variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answer_key": {
            "type": "string"
          },
          "prompt_pt": {
            "type": "string"
          },
          "sentence": {
            "type": "string"
          },
          "strand": {
            "type": "string",
            "enum": [
              "fluency",
              "language-focused",
              "meaning-input",
              "meaning-output"
            ],
            "description": "Which of the four strands this component trains. Vocabulary owner: design — design/learning_science.md R77 (Nation's four strands). Widening it is an edit there, never a side effect of regenerating this schema from the data.",
            "x-vocabulary": {
              "owner": "design",
              "source": "design/learning_science.md R77 (Nation's four strands)"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "real_phrases": {
      "type": "integer",
      "minimum": 0
    },
    "say_now": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "MAJOR.MINOR of the record format. A version field exists to be bumped; an enum over the current value means it never can be."
    },
    "shadowing": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage": {
      "$ref": "common.schema.json#/$defs/IdRef"
    },
    "strand_counts": {
      "type": "object",
      "properties": {
        "fluency": {
          "type": "integer",
          "minimum": 0
        },
        "language-focused": {
          "type": "integer",
          "minimum": 0
        },
        "meaning-input": {
          "type": "integer",
          "minimum": 0
        },
        "meaning-output": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "fluency",
        "language-focused",
        "meaning-input",
        "meaning-output"
      ],
      "additionalProperties": false
    },
    "strands": {
      "type": "object",
      "properties": {
        "fluency": {
          "type": "integer",
          "minimum": 0
        },
        "language-focused": {
          "type": "integer",
          "minimum": 0
        },
        "meaning-input": {
          "type": "integer",
          "minimum": 0
        },
        "meaning-output": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "fluency",
        "language-focused",
        "meaning-input",
        "meaning-output"
      ],
      "additionalProperties": false
    },
    "title": {
      "$ref": "common.schema.json#/$defs/LocaleText"
    },
    "untranslated": {
      "type": "array"
    },
    "words": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "audio",
    "checkpoint",
    "chunk_phrases",
    "cumulative_known_vocab",
    "drills",
    "fluency",
    "id",
    "kanji_recognition",
    "layer",
    "needs_review",
    "order",
    "patterns",
    "patterns_chunked",
    "production",
    "real_phrases",
    "say_now",
    "schema_version",
    "shadowing",
    "stage",
    "strand_counts",
    "strands",
    "title",
    "untranslated",
    "words"
  ]
}
