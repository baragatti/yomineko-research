{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yomineko.dev/contracts/kana.schema.json",
  "title": "kana",
  "description": "One hiragana or katakana character and the family it belongs to.",
  "x-yomineko": {
    "entity": "kana",
    "records": 211,
    "packing": "list",
    "glob": "corpus/kana/[hk]*.json",
    "stable_id_field": "id",
    "generated_by": "scripts/contracts/build_schemas.py from contracts/_shapes.json"
  },
  "type": "object",
  "properties": {
    "char": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "family_label": {
      "$ref": "common.schema.json#/$defs/LocaleText"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/StableId"
    },
    "romaji": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "base",
        "dakuten",
        "handakuten",
        "long-vowel",
        "sokuon",
        "yoon"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "char",
    "family",
    "family_label",
    "id",
    "romaji",
    "type"
  ]
}
