{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yomineko.dev/contracts/speak_path.schema.json",
  "title": "speak_path",
  "description": "The root of the situation-ordered path (Fala Primeiro): its stages and totals.",
  "x-yomineko": {
    "entity": "speak_path",
    "records": 1,
    "packing": "single",
    "glob": "course/speak/course.json",
    "stable_id_field": "id",
    "generated_by": "scripts/contracts/build_schemas.py from contracts/_shapes.json",
    "vocabulary_policy": "Types, nesting and `required` are measured from the data. Value sets are not: every `enum` here is either declared in a design document, parsed from the code that produces the value, or curated in build_schemas.py with its source named in x-vocabulary. See contracts/README.md."
  },
  "type": "object",
  "properties": {
    "description": {
      "$ref": "common.schema.json#/$defs/LocaleText"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/StableId"
    },
    "layer": {
      "$ref": "common.schema.json#/$defs/Layer"
    },
    "needs_review": {
      "$ref": "common.schema.json#/$defs/Provenance/properties/needs_review"
    },
    "ordering": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "MAJOR.MINOR of the record format. A version field exists to be bumped; an enum over the current value means it never can be."
    },
    "shortfall": {
      "type": "array"
    },
    "spec": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "approx_band": {
            "type": "string",
            "pattern": "^(pre-n5|n5|n4|n3|n2|n1)(/(pre-n5|n5|n4|n3|n2|n1))?$",
            "description": "Roughly where this stage sits against the JLPT ladder — one Level, or a pair when the stage straddles two. A pattern rather than an enum so the bands can be re-cut without a schema change (spec §1.6)."
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "slug": {
            "$ref": "common.schema.json#/$defs/StableId"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/LocaleText"
          },
          "unit_count": {
            "type": "integer",
            "minimum": 0
          },
          "unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "title": {
      "$ref": "common.schema.json#/$defs/LocaleText"
    },
    "totals": {
      "type": "object",
      "properties": {
        "checkpoint_items": {
          "type": "integer",
          "minimum": 0
        },
        "drills": {
          "type": "integer",
          "minimum": 0
        },
        "fluency": {
          "type": "integer",
          "minimum": 0
        },
        "patterns_chunked": {
          "type": "integer",
          "minimum": 0
        },
        "patterns_kept": {
          "type": "integer",
          "minimum": 0
        },
        "phrases": {
          "type": "integer",
          "minimum": 0
        },
        "production": {
          "type": "integer",
          "minimum": 0
        },
        "real_phrases": {
          "type": "integer",
          "minimum": 0
        },
        "stages": {
          "type": "integer",
          "minimum": 0
        },
        "units": {
          "type": "integer",
          "minimum": 0
        },
        "vocab_introduced": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "checkpoint_items",
        "drills",
        "fluency",
        "patterns_chunked",
        "patterns_kept",
        "phrases",
        "production",
        "real_phrases",
        "stages",
        "units",
        "vocab_introduced"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "description",
    "id",
    "layer",
    "needs_review",
    "ordering",
    "schema_version",
    "shortfall",
    "spec",
    "stages",
    "title",
    "totals"
  ]
}
